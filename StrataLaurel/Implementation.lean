/-! ## Strata Laurel API

Reading, translating, and analyzing Laurel programs.
-/

public section

namespace Strata

/-- Deserializer for the struct-format Ion encoding of `Laurel.LaurelProgram`,
generated by `getIonSerializer%`. -/
private partial def deserializeLaurelProgram : ByteArray → Except Std.Format Laurel.LaurelProgram :=
  getIonDeserializer% Laurel.LaurelProgram

/-! ### File I/O -/

/--
Read a Laurel source file in textual format and parse it into
a `Laurel.LaurelProgram`. Handles dialect loading, parsing, and
AST translation in one step.
-/
def parseLaurelText (path : System.FilePath) (content : String)
    : IO Laurel.LaurelProgram := do
  let input := StrataDDM.Parser.stringInputContext path content
  let dialects :=
    StrataDDM.Elab.LoadedDialects.ofDialects!
      #[StrataDDM.initDialect, Strata.Laurel.Laurel]
  let strataProgram ←
    StrataDDM.Elab.parseStrataProgramFromDialect
      dialects Strata.Laurel.Laurel.name input
  let uri := Strata.Uri.file path.toString
  match Strata.Laurel.TransM.run uri
      (Strata.Laurel.parseProgram strataProgram) with
  | .ok program => pure program
  | .error errors =>
    throw (IO.userError s!"Laurel translation errors: {errors}")

def readLaurelTextFile (path : System.FilePath)
    : IO Laurel.LaurelProgram := do
  let content ← IO.FS.readFile path
  parseLaurelText path content

/--
Deserialize Laurel Ion bytes into a `Laurel.LaurelProgram`.
Expects the struct-format encoding produced by `getIonSerializer%`.
-/
def readLaurelIonProgram (bytes : ByteArray)
    : IO Laurel.LaurelProgram := do
  match deserializeLaurelProgram bytes with
  | .ok program => return program
  | .error e => throw (IO.userError s!"Failed to deserialize Laurel program: {e}")

/-! ### Transformation between generic and dialect-specific representation -/

/--
Translate a program in the dialect-specific AST for Laurel into the generic Strata
AST. Usually useful as a step before serialization.
-/
def laurelToStrataProgram (p : Laurel.LaurelProgram) : StrataDDM.Program :=
  Laurel.programToStrata p

/--
Translate a program in the generic AST for Strata into the dialect-specific AST
for Laurel. This can fail with an error message if the input is not a
well-structured instance of the Laurel dialect.

`uri` names the file `p` was parsed from; it is recorded in the source location
of every translated AST node.
-/
def strataProgramToLaurel (uri : Uri) (p : StrataDDM.Program) : Except String Laurel.LaurelProgram :=
  Laurel.TransM.run uri (Laurel.parseProgram p)

/-! ### Transformation between dialects -/

/--
Translate a program represented in the dialect-specific AST for the Laurel
dialect into the dialect-specific AST for the Core dialect. This can fail with
an error message if the input program contains constructs that are not yet
supported.
-/
def laurelToCore (p : Laurel.LaurelProgram) : IO (Except String Core.Program) := do
  let (coreOpt, diags) ← Laurel.translate { } p
  match coreOpt with
  | some core => return .ok core
  | none => return .error s!"Laurel to Core translation failed: {diags.map (·.message)}"

/-! ### Analysis of Laurel programs -/

/--
Analyze a Laurel program by translating to Core and running
verification. Returns VC results (if translation succeeded)
and any translation diagnostics.
-/
def Laurel.verifyProgram
    (program : Laurel.LaurelProgram)
    (options : Core.VerifyOptions := .default)
    : IO (Option Core.VCResults × List Message) :=
  Strata.Laurel.verifyToVcResults program { verifyOptions := options }

/--
Analyze a Laurel program and return structured diagnostic models
(combining translation errors and verification results).
-/
def Laurel.analyzeToMessages
    (program : Laurel.LaurelProgram)
    (options : Core.VerifyOptions := .default)
    : IO (Array Message) :=
  Strata.Laurel.verifyToMessages program { verifyOptions := options }

/-! ### Concrete interpretation -/

/-- `program` with a new entry procedure that calls `name()`, replacing the producer's entries.
    The call skips the callee's `requires`, since an entry point's is assumed rather than checked.

    The callee cannot be the entry itself: unmarked, it takes the heap and the globals it uses as
    parameters, and marked, it would be subject to the entry rules, which reject its
    `requires`/`ensures` and break its callers. -/
def Laurel.withEntryHarness (program : Laurel.LaurelProgram) (name : String)
    : Except String Laurel.LaurelProgram := do
  let overloads := program.staticProcedures.filter (·.name.text == name)
  let some target := overloads.find? (·.inputs.isEmpty) <|> overloads.head?
    | throw s!"entry procedure '{name}' not found"
  if target.is_coroutine then
    throw s!"entry procedure '{name}' cannot be a coroutine: calling one only constructs it"
  unless target.inputs.isEmpty && target.typeArgs.isEmpty do
    throw s!"entry procedure '{name}' cannot take inputs or type parameters: \
             an entry point is invoked with no arguments"
  let src := target.name.source
  let taken : Std.HashSet String :=
    (Laurel.declaredNames program).foldl (fun s (_, text, _) => s.insert text) {}
  let fresh (base : String) : Laurel.Identifier :=
    { text := Strata.Name.findUnique base 1 taken, source := src }
  -- Lowering keeps a transparent procedure without an assert or assume of its own only as a
  -- function, which runs none of its callees' asserts. A no-op `assume` keeps the callee's
  -- procedure.
  let keepProcedure (p : Laurel.Procedure) : Laurel.Procedure := match p.body with
    | .Transparent b =>
      { p with body :=
          .Transparent ⟨.Block [⟨.Assume ⟨.LiteralBool true, src⟩, src⟩, b] none, src⟩ }
    | _ => p
  -- A copy, so that the target's other callers still check its `requires`.
  let copy? := if !target.preconditions.any (·.mode.doesAssert) then none else
    some (keepProcedure { target with name := fresh s!"{name}?entered", preconditions := [],
                                      isInterpretEntry := false })
  let entry : Laurel.Procedure :=
    { name := fresh s!"{name}?entry"
      inputs := [], outputs := [], preconditions := [], decreases := none
      isInterpretEntry := true
      body := .Opaque [] (some ⟨.StaticCall (copy?.getD target).name [] [], src⟩)
        (Laurel.ModifiesGroup.wildcard src) }
  let program := Laurel.mapLaurelProgramProcedures ({ · with isInterpretEntry := false }) program
  let procs := if copy?.isSome then program.staticProcedures else
    program.staticProcedures.map fun p =>
      if p.name.text == name && p.inputs.isEmpty then keepProcedure p else p
  return { program with staticProcedures := procs ++ copy?.toList ++ [entry] }

end Strata

