{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "_comment": "AUTO-GENERATED from the Core DDM grammar. Do not edit by hand; run: lake env lean --run editors/GenSyntax.lean vscode",
  "name": "Strata Core",
  "scopeName": "source.core-st",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#attribute" },
    { "include": "#label" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#operator" },
    { "include": "#function-call" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.core-st",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.core-st",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.core-st",
          "match": "\\\\."
        }
      ]
    },
    "attribute": {
      "name": "meta.attribute.core-st",
      "match": "@\\[[^\\]]*\\]",
      "captures": {
        "0": { "name": "entity.other.attribute-name.core-st" }
      }
    },
    "label": {
      "name": "meta.label.core-st",
      "match": "\\[([a-zA-Z_][a-zA-Z0-9_]*)\\]\\s*:",
      "captures": {
        "0": { "name": "entity.name.label.core-st" },
        "1": { "name": "entity.name.tag.core-st" }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.core-st",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keyword": {
      "name": "keyword.core-st",
      "match": "\\b(var|assume|assert|cover|if|else|havoc|invariant|decreases|while|out|inout|call|exit|free|ensures|requires|spec|procedure|type|inline|const|function|rec|axiom|distinct|datatype|goto|cfg|old|forall|exists|program)\\b"
    },
    "type": {
      "name": "support.type.core-st",
      "match": "\\b(bool|int|string|regex|real|bv|W1|W8|W16|W32|W64|W128|Map|Sequence)\\b"
    },
    "constant": {
      "name": "constant.language.core-st",
      "match": "\\b(true|false|null)\\b"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.core-st",
          "match": ":="
        },
        {
          "name": "keyword.operator.symbol.core-st",
          "match": "(as_bv128|as_bv32|as_bv16|as_bv64|as_bv1|as_bv8|<==>|==>|!=|\\|\\||&&|==|!)"
        }
      ]
    },
