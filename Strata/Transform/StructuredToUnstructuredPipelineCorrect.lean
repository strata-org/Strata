/-! # Structured-to-unstructured pipeline: soundness

Generic soundness of the three-pass structured-to-unstructured pipeline. The
Core-facing composition lives in `StructuredToUnstructuredPipelineCoreCorrect`,
and the pipeline definitions themselves live in
`StructuredToUnstructuredPipeline`.

Key results:
  * The per-pass `Trace.WithWF (EventArg.ExtendsEnv _)` relations compose by
    `Trace.WithWF.trans` followed by `Trace.WithWF.mono`.
  * Name separation — `nondetElim_generated_not_s2uGenerated`: guard names
    generated by `nondetElim` never collide with structured-lowering names.
  * `StructuredToUnstructuredPipeline.overapproximatesTraces` composes the three event-trace
    simulations into one source-block-to-CFG refinement under `Trace.WithWF` matching.
  * `PipelinePre` is the syntactic source precondition of the generic
    pipeline theorem. `pipeline_source_noEscapeE` states the accompanying
    source no-escape guarantee: `EventLang.cfgE` maps exiting outcomes to
    `.terminal`, and a `PipelinePre` source never reaches `.exiting`.
    `pipelinePre_nil` shows that the precondition is inhabited. -/

public section

namespace Imperative.StructuredToUnstructuredPipeline

open StructuredToUnstructured

variable {P : PureExpr}
variable {fac : P.Factory}

/-! ## End-to-end pipeline event relation -/

/-- Nondeterminism-elimination names are distinct from names generated under
structured-lowering prefixes. -/
private theorem ndelim_name_not_s2uGenerated (state : StringGenState) :
    ¬ StructuredToUnstructured.isGeneratedName
        (StringGenState.gen NondetElim.prefixIte state).1
  ∧ ¬ StructuredToUnstructured.isGeneratedName
        (StringGenState.gen NondetElim.prefixLoop state).1 := by
  constructor <;> intro hname
  all_goals
    rcases hname with ⟨pfx, hpfx, other, heq⟩ | ⟨label, other, heq⟩
    · simp only [StructuredToUnstructured.prefixesReserved, List.mem_cons,
        List.not_mem_nil, or_false] at hpfx
      rcases hpfx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
        rfl | rfl | rfl <;>
        rw [StringGenState.gen_eq, StringGenState.gen_eq] at heq <;>
        have hlist := congrArg String.toList heq <;>
        simp [NondetElim.prefixIte, NondetElim.prefixLoop, iteLabelPrefix,
          iteFlushPrefix, loopEntryPrefix, loopMeasurePrefix,
          measureDecreasePrefix, invariantPrefix, endPrefix, listTailPrefix,
          blockFlushPrefix, beforeLoopPrefix, String.toList_append] at hlist
    · rw [StringGenState.gen_eq, StringGenState.gen_eq] at heq
      have hlist := congrArg String.toList heq
      simp only [NondetElim.prefixIte, String.reduceAppend, Nat.toString_eq_repr,
        String.toList_append, String.reduceToList, Nat.toList_repr, List.cons_append,
        ↓Char.isValue, List.nil_append, blockExitPrefix, List.append_assoc,
        NondetElim.prefixLoop] at hlist
      simp only [String.toList,
        show (toString "block$") = "block$" from rfl] at hlist
      exact absurd (List.cons.inj hlist).1 (by decide)

/-- Names generated by `nondetElim` are not generated under a
structured-lowering prefix. -/
theorem nondetElim_generated_not_s2uGenerated {s : String}
    (h : NondetElim.isGeneratedName s) :
    ¬ StructuredToUnstructured.isGeneratedName s := by
  rw [NondetElim.isGeneratedName_iff] at h
  rcases h with ⟨sg, he⟩ | ⟨sg, he⟩
  · exact he ▸ (ndelim_name_not_s2uGenerated sg).1
  · exact he ▸ (ndelim_name_not_s2uGenerated sg).2

/-- Disjoint base prefixes make every intermediate structured-lowering
prefix disjoint from NondetElim-generated names. -/
theorem intermediateParams_prefixesDisjoint {P : PureExpr}
    (base : Logic.InitEnvWFParams P)
    (hbase : prefixesDisjoint base.prefixIdents NondetElim.isGeneratedName) :
    prefixesDisjoint (intermediateParams base).prefixIdents
      NondetElim.isGeneratedName := by
  intro p hp s hs
  simp only [intermediateParams, Logic.InitEnvWFParams.extend] at hp
  rcases List.mem_append.mp hp with hp | hp
  · simp only [StructuredToUnstructured.prefixesReserved,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rw [NondetElim.isGeneratedName_iff] at hs
    rcases hs with ⟨sg, rfl⟩ | ⟨sg, rfl⟩ <;>
      (rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
          rfl | rfl <;>
        · rw [StringGenState.gen_eq]
          intro hpre
          simp only [iteLabelPrefix, NondetElim.prefixIte, iteFlushPrefix,
            loopEntryPrefix, loopMeasurePrefix, measureDecreasePrefix,
            invariantPrefix, NondetElim.prefixLoop, endPrefix, listTailPrefix,
            blockFlushPrefix, beforeLoopPrefix, String.toList_append] at hpre
          rw [List.isPrefixOf_iff_prefix] at hpre
          obtain ⟨t, ht⟩ := hpre
          simp only [String.toList] at ht
          first
            | exact absurd (List.cons.inj ht).1 (by decide)
            | exact absurd
                (List.cons.inj (List.cons.inj (List.cons.inj
                  (List.cons.inj (List.cons.inj ht).2).2).2).2).1 (by decide))
  · exact hbase p hp s hs

/-! ## Generic pipeline precondition -/

/-- The purely syntactic precondition under which `s2uPipeline ss` refines `ss`:
source shape restrictions, exit-coverage, and generated-name disjointness. -/
structure PipelinePre {P : PureExpr} [HasFvar P] [HasFvars P] [HasBoolOps P]
    [HasIdent P] [HasInt P] [HasIntOps P] [HasSubstFvar P]
    [DecidableEq P.Ident]
    (ss : List (Stmt P (Cmd P))) : Prop where
  h_lhni : Block.loopHasNoInvariants ss = true
  h_nml : Block.noMeasureLoops ss = true
  h_unique : Block.uniqueInits ss
  h_userlabels : Block.userLabelsShapeNodup ss
  h_covered : Block.exitsCoveredByBlocks [] ss
  h_ndelim_writes : SrcNoGenWrites (P := P) NondetElim.isGeneratedName ss
  h_ndelim_reads : Block.exprsShapeFree (P := P) NondetElim.isGeneratedName ss
  h_disj_initVars : ∀ str : String, isGeneratedName str →
    HasIdent.ident (P := P) str ∉ Block.initVars ss

open Imperative.Specification
open Imperative.Specification.Transform
open Imperative.Logic

variable [HasFvar P] [HasFvars P] [HasBoolOps P]
  [HasIdent P] [HasInt P] [HasIntOps P] [DecidableEq P.Ident]
  [HasOps P] [LawfulHasFvar P] [LawfulHasFvars P] [LawfulHasIdent P]

/-- Under `PipelinePre`, `nondetElim` overapproximates the source
imperative-block event-trace language by itself up to
`Trace.WithWF (EventArg.ExtendsEnv NdExtra)` on traces and `EnvStoreAgree` on final environments. -/
private theorem nondetElim_overapproximates_upto [HasSubstFvar P]
    [LawfulHasVal P]
    (base : InitEnvWFParams P)
    (hprefixes : prefixesDisjoint (intermediateParams base).prefixIdents
      NondetElim.isGeneratedName) :
    Specification.Transform.OverapproximatesTracesUptoWhen
      (Trace.WithWF (P := P) (EventArg.ExtendsEnv NondetElimTrace.NdExtra))
      (· = ·)
      (EnvStoreAgree (P := P))
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (fun ss => some (Block.nondetElim ss))
      (fun ss => PipelinePre ss)
      (sourceParams base) (intermediateParams base) := by
  intro ss ss' ht hpre ρ₀ ρ₀' hEq hwf
  subst hEq
  simp only [Option.some.injEq] at ht
  subst ht
  change BlockInitEnvWF (sourceParams base) ss ρ₀ at hwf
  obtain ⟨h_prefix, h_term, h_exit, h_tgt_wf⟩ :=
    NondetElim.Internal.overapproximates_upto_base
      (P := P) (intermediateParams base) hprefixes
      ss (Block.nondetElim ss) rfl
      ⟨hpre.h_ndelim_writes, hpre.h_ndelim_reads⟩
      ρ₀ ρ₀ rfl hwf
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact h_prefix
  · intro ρ' trace hrun
    obtain ⟨ρ'', trace', hrun', hout, hrel⟩ := h_term ρ' trace hrun
    exact ⟨ρ'', trace', hrun', envStoreAgree_of_extendsWith hout, hrel⟩
  · intro lbl ρ' trace hrun
    obtain ⟨ρ'', trace', hrun', hout, hrel⟩ := h_exit lbl ρ' trace hrun
    exact ⟨ρ'', trace', hrun', envStoreAgree_of_extendsWith hout, hrel⟩
  · exact h_tgt_wf

/-! ## Cross-pass `pre`-implication lemmas (composition)

The two lemmas below discharge each next pass's `pre` on the previous pass's
output — the `hpre` bridges `comp_trans_eq` needs to chain the per-pass instances.
The facts are the structural-preservation properties of the `nondetElim`/`hoist`
outputs, derived from the statement-only `pre`s. -/

omit [HasOps P] [LawfulHasFvar P] [LawfulHasFvars P] in
/-- The `nondetElim` output satisfies the `hoist` pass's precondition whenever the
source satisfies `PipelinePre`. -/
private theorem nondetElim_establishes_hoistPre [HasSubstFvar P] :
    ∀ ss ss', (fun ss => some (Block.nondetElim ss)) ss = some ss' →
      (fun ss => PipelinePre ss) ss →
      (fun ss =>
        Block.containsNondetLoop ss = false
        ∧ Block.loopHasNoInvariants ss = true
        ∧ Block.noMeasureLoops ss = true
        ∧ Block.uniqueInits ss
        ∧ Block.exitsCoveredByBlocks [] ss
        ∧ Block.noNondetGuards ss = true
        ∧ Block.userLabelsShapeNodup ss
        ∧ (∀ s : String, StructuredToUnstructured.isGeneratedName s →
            HasIdent.ident (P := P) s ∉ Block.initVars ss)) ss' := by
  intro ss ss' ht hpre
  simp only [Option.some.injEq] at ht
  subst ht
  refine ⟨nondetElim_containsNondetLoop ss,
    nondetElim_loopHasNoInvariants ss hpre.h_lhni,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- `noMeasureLoops (nondetElim ss) = true`.
    exact nondetElim_noMeasureLoops ss hpre.h_nml
  · -- `uniqueInits (nondetElim ss)`.
    exact (Block.nondetElimM_initVars_nodup ss StringGenState.emp StringGenState.wf_emp
      hpre.h_unique (fun str hk => hpre.h_disj_initVars str (Or.inl hk))).2
  · -- exit coverage is preserved by `nondetElim`.
    exact Block.nondetElim_exitsCoveredByBlocks ss hpre.h_covered
  · -- `noNondetGuards (nondetElim ss) = true` (`nondetElim` removes every nondet guard).
    exact nondetElim_noNondetGuards ss
  · -- `userLabelsShapeNodup (nondetElim ss)`: `nondetElim` preserves `getBlockLabels`.
    unfold Block.userLabelsShapeNodup
    rw [Block.nondetElim_getBlockLabels]
    exact hpre.h_userlabels
  · -- `StructuredToUnstructured.isGeneratedName`-freedom of `initVars (nondetElim ss)`.
    intro str hk hmem
    rcases Block.nondetElimM_initVars_classified ss StringGenState.emp _ hmem with
      h_src | ⟨str', h_eq, h_nd⟩
    · exact hpre.h_disj_initVars str (Or.inr hk) h_src
    · exact nondetElim_generated_not_s2uGenerated h_nd (LawfulHasIdent.ident_inj h_eq ▸ hk)

omit [LawfulHasFvar P] [HasFvar P] [HasBoolOps P] in
omit [HasInt P] [HasIntOps P] [DecidableEq P.Ident] [LawfulHasIdent P]
  [HasOps P] in
/-- `pre_ndelim → pre_hoist ∘ hoistLoopPrefixInits`: the `stmtsToCFG` instance's
`pre` holds on the `hoist` output. -/
private theorem hoist_establishes_loweringPre :
    ∀ ss ss', (fun ss => some (Block.hoistLoopPrefixInits ss)) ss = some ss' →
      (fun ss =>
        Block.containsNondetLoop ss = false
        ∧ Block.loopHasNoInvariants ss = true
        ∧ Block.noMeasureLoops ss = true
        ∧ Block.uniqueInits ss
        ∧ Block.exitsCoveredByBlocks [] ss
        ∧ Block.noNondetGuards ss = true
        ∧ Block.userLabelsShapeNodup ss
        ∧ (∀ s : String, StructuredToUnstructured.isGeneratedName s →
            HasIdent.ident (P := P) s ∉ Block.initVars ss)) ss →
      (fun ss =>
        Block.noNondetGuards ss = true
        ∧ Block.uniqueInits ss
        ∧ Block.loopBodyNoInits ss = true
        ∧ Block.loopHasNoInvariants ss = true
        ∧ Block.noMeasureLoops ss = true
        ∧ Block.exitsCoveredByBlocks [] ss
        ∧ Block.userLabelsShapeNodup ss
        ∧ (∀ s : String, StructuredToUnstructured.isGeneratedName s →
            HasIdent.ident (P := P) s ∉ Block.initVars ss)) ss' := by
  intro ss ss' ht hpre
  simp only [Option.some.injEq] at ht
  subst ht
  obtain ⟨_, h_no_inv, h_no_measure, h_unique, h_covered,
    h_simple, h_userlabels, h_s2u_iv⟩ := hpre
  refine ⟨LoopInitHoistProducerProps.Block.hoistP_noNondetGuards ss h_simple,
    (LoopInitHoistProducerProps.Block.hoistP_initVars_perm ss).nodup_iff.mpr h_unique,
    LoopInitHoistProducerProps.Block.hoistP_loopBodyNoInits ss,
    LoopInitHoistProducerProps.Block.hoistP_loopHasNoInvariants ss h_no_inv, ?_, ?_, ?_, ?_⟩
  · -- `noMeasureLoops (hoist' ss) = true` from `noMeasureLoops ss`.
    exact LoopInitHoistProducerProps.Block.hoistP_noMeasureLoops ss h_no_measure
  · -- exit coverage is preserved by the same-name hoist.
    exact Block.hoistP_exitsCoveredByBlocks [] ss h_covered
  · -- `userLabelsShapeNodup (hoist' ss)`: same-name hoist preserves `getBlockLabels`.
    unfold Block.userLabelsShapeNodup
    rw [LoopInitHoistProducerProps.Block.hoistP_getBlockLabels]
    exact h_userlabels
  · -- Structured-lowering generated names remain absent from hoisted inits.
    intro s hk hx
    exact h_s2u_iv s hk
      (LoopInitHoistProducerProps.Block.hoistP_initVars_sub ss (HasIdent.ident (P := P) s) hx)

/-! ## Composition of the per-pass instances

All three passes emit no command events on the names they generate and replay
every source command exactly once. Each pass exposes a semantic event relation
(`Trace.WithWF (EventArg.ExtendsEnv _)` with NondetElim's guard registers or
with no restriction); these compose into a single end-to-end
`Trace.WithWF (EventArg.ExtendsEnv (fun _ => True))`. -/

omit [LawfulHasFvar P] [LawfulHasFvars P] in
/-- For blocks satisfying the pipeline's post-nondeterminism-elimination
structural conditions, loop-initializer hoisting overapproximates the source
imperative-block event language by itself up to `Trace.WithWF` matching and
final-store agreement. Both gates reserve structured-to-CFG generated labels. -/
private theorem hoist_overapproximates_upto_when [HasSubstFvar P]
    [LawfulHasVal P] (params : InitEnvWFParams P) :
    Specification.Transform.OverapproximatesTracesUptoWhen
      (Trace.WithWF (P := P) (EventArg.ExtendsEnv (fun _ => True)))
      (· = ·)
      (EnvStoreAgree (P := P))
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (fun s => some (Block.hoistLoopPrefixInits s))
      (fun ss =>
        Block.containsNondetLoop ss = false
        ∧ Block.loopHasNoInvariants ss = true
        ∧ Block.noMeasureLoops ss = true
        ∧ Block.uniqueInits ss
        ∧ Block.exitsCoveredByBlocks [] ss
        ∧ Block.noNondetGuards ss = true
        ∧ Block.userLabelsShapeNodup ss
        ∧ (∀ s : String, StructuredToUnstructured.isGeneratedName s →
            HasIdent.ident (P := P) s ∉ Block.initVars ss))
      params params := by
  intro ss ss' ht hpre ρ₀ ρ₀' hEq hwf
  obtain ⟨_, _, _, h_unique, _⟩ := hpre
  exact Imperative.LoopInitHoist.overapproximatesTraces params ss ss' ht
    h_unique ρ₀ ρ₀' hEq hwf

/-- The three per-pass trace overapproximations compose into one source
`imperativeBlockE` to `cfgE` overapproximation. Each pass replays source command
events exactly once with semantic event evidence, so the per-pass relations
compose into a single `Trace.WithWF` matching. -/
private theorem pipeline_overapproximates_upto_composed [HasSubstFvar P] [LawfulHasVal P]
    [LawfulHasBool P]
    (base : InitEnvWFParams P)
    (hbase : prefixesDisjoint base.prefixIdents NondetElim.isGeneratedName) :
    Specification.Transform.OverapproximatesTracesUptoWhen
      (Trace.WithWF (P := P) (EventArg.ExtendsEnv (fun _ => True)))
      (· = ·)
      (EnvStoreAgree (P := P))
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (EventLang.cfgE P (Cmd P) (EvalCmdE P)
        (InitEnvWFParams P) CFGInitEnvWF)
      (fun s => (fun s => (fun s => some (Block.nondetElim s)) s >>=
          (fun s => some (Block.hoistLoopPrefixInits s))) s >>=
        (fun s => some (stmtsToCFG s)))
      (fun ss => PipelinePre ss)
      (sourceParams base) base :=
  -- Stage 1: `nondetElim` then hoist, composed into one pipeline relation.
  have h_lockstep :=
    (Specification.Transform.OverapproximatesTracesUptoWhen.comp_trans_eq
      (Trace.WithWF (P := P) (EventArg.ExtendsEnv NondetElimTrace.NdExtra))
      (Trace.WithWF (P := P) (EventArg.ExtendsEnv (fun _ => True)))
      (EnvStoreAgree (P := P))
      (fun _ _ _ h₁ h₂ => EnvStoreAgree_trans h₁ h₂)
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (fun s => some (Block.nondetElim s)) (fun s => some (Block.hoistLoopPrefixInits s))
      (sourceParams base) (intermediateParams base) (intermediateParams base)
      nondetElim_establishes_hoistPre
      (nondetElim_overapproximates_upto base
        (intermediateParams_prefixesDisjoint base hbase))
      (hoist_overapproximates_upto_when (intermediateParams base))).mono_trace
        (fun _ _ h => h.elim (fun _ hmid =>
          (Trace.WithWF.trans hmid.1 hmid.2).mono (fun _ _ => trivial)))
  -- The combined stage-1 precondition bridge into `stmtsToCFG`'s precondition.
  have hpre_lockstep_cfg :
      ∀ st st',
        ((fun s => some (Block.nondetElim s)) st >>=
          (fun s => some (Block.hoistLoopPrefixInits s))) = some st' →
        PipelinePre st →
        (fun ss =>
          Block.noNondetGuards ss = true
          ∧ Block.uniqueInits ss
          ∧ Block.loopBodyNoInits ss = true
          ∧ Block.loopHasNoInvariants ss = true
          ∧ Block.noMeasureLoops ss = true
          ∧ Block.exitsCoveredByBlocks [] ss
          ∧ Block.userLabelsShapeNodup ss
          ∧ (∀ s : String, StructuredToUnstructured.isGeneratedName s →
              HasIdent.ident (P := P) s ∉ Block.initVars ss)) st' := by
    intro st st' ht hpre
    simp only [bind, Option.bind, Option.some.injEq] at ht
    subst ht
    exact hoist_establishes_loweringPre _ _ rfl (nondetElim_establishes_hoistPre _ _ rfl hpre)
  -- Stage 2: compose the structured prefix with `stmtsToCFG`, then collapse
  -- the resulting relational composition to `Trace.WithWF` matching.
  (Specification.Transform.OverapproximatesTracesUptoWhen.comp_trans_eq
    (Trace.WithWF (P := P) (EventArg.ExtendsEnv (fun _ => True)))
    (Trace.WithWF (P := P) (EventArg.ExtendsEnv (fun _ => True)))
    (EnvStoreAgree (P := P))
    (fun _ _ _ h₁ h₂ => EnvStoreAgree_trans h₁ h₂)
    (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
    (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
    (EventLang.cfgE P (Cmd P) (EvalCmdE P)
      (InitEnvWFParams P) CFGInitEnvWF)
    (fun s => (fun s => some (Block.nondetElim s)) s >>=
      (fun s => some (Block.hoistLoopPrefixInits s)))
    (fun s => some (stmtsToCFG s))
    (sourceParams base) (intermediateParams base) base
    hpre_lockstep_cfg
    h_lockstep
    (Imperative.StructuredToUnstructured.overapproximatesTraces base)).mono_trace
      (fun _ _ h => h.elim (fun _ hmid =>
        (Trace.WithWF.trans hmid.1 hmid.2).mono (fun _ _ => trivial)))

omit [HasOps P] [LawfulHasFvar P] [LawfulHasFvars P]
  [LawfulHasIdent P] [DecidableEq P.Ident] in
/-- The composed per-pass transform `(nondetElim >=> hoist) >=> stmtsToCFG`
collapses (each step is `some _`, so `Option.bind` reduces) to `some ∘ pipeline`,
since `pipeline = stmtsToCFG ∘ hoistLoopPrefixInits ∘ Block.nondetElim`. -/
private theorem pipeline_transform_eq (ss : List (Stmt P (Cmd P))) :
    ((fun s => (fun s => some (Block.nondetElim s)) s >>=
        (fun s => some (Block.hoistLoopPrefixInits s))) ss >>=
      (fun s => some (stmtsToCFG s))) = some (s2uPipeline ss) := by
  simp only [s2uPipeline, Function.comp_apply, bind, Option.bind]

/-- **Pipeline overapproximation, via per-pass composition.** The composed
pipeline overapproximates the source statement-list event language by the
unstructured CFG event language, up to `Trace.WithWF` matching on traces and
`EnvStoreAgree` on final environments. -/
theorem overapproximatesTraces [HasSubstFvar P] [LawfulHasVal P] [LawfulHasBool P]
    (base : InitEnvWFParams P)
    (hbase : prefixesDisjoint base.prefixIdents NondetElim.isGeneratedName) :
    Specification.Transform.OverapproximatesTracesUptoWhen
      (Trace.WithWF (P := P) (EventArg.ExtendsEnv (fun _ => True)))
      (· = ·)
      (EnvStoreAgree (P := P))
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (EventLang.cfgE P (Cmd P) (EvalCmdE P)
        (InitEnvWFParams P) CFGInitEnvWF)
      (fun ss => some (s2uPipeline ss))
      (fun ss => PipelinePre ss)
      (sourceParams base) base := by
  have h := pipeline_overapproximates_upto_composed (P := P) base hbase
  rwa [show (fun s => (fun s => (fun s => some (Block.nondetElim s)) s >>=
        (fun s => some (Block.hoistLoopPrefixInits s))) s >>=
        (fun s => some (stmtsToCFG s)))
      = (fun ss => some (s2uPipeline ss)) from funext pipeline_transform_eq] at h

omit [HasOps P] [LawfulHasFvar P] [LawfulHasFvars P] [LawfulHasIdent P] in
/-- **A `PipelinePre` source never escapes via a top-level exit.**

`EventLang.cfgE` maps the exiting outcome to `.terminal` because CFGs have no
escaping state, so `overapproximatesTraces` alone would let a source run that
escapes via `exit` be matched by a target run that just terminates.
`PipelinePre` requires every exit to be caught by an enclosing block, so no
source event run reaches `.exiting`, and that case cannot arise. -/
theorem pipeline_source_noEscapeE [HasSubstFvar P]
    (ss : List (Stmt P (Cmd P))) (hpre : PipelinePre ss)
    (ρ₀ : Env P) (label : String) (ρ' : Env P) {tr : List (Event P)} :
    ¬ StepStmtStarE P (EvalCmdE P) (.stmts ss ρ₀) tr (.exiting label ρ') :=
  stmts_exitsCoveredByBlocks_noEscapeE _ ss hpre.h_covered ρ₀ label ρ'

/-- **The syntactic precondition is inhabited.**  The empty program satisfies
`PipelinePre`, ruling out global vacuity of the `fun ss => PipelinePre ss`
precondition. -/
theorem pipelinePre_nil {P : PureExpr} [HasFvar P] [HasFvars P] [HasBoolOps P]
    [HasIdent P] [HasInt P] [HasIntOps P]
    [HasSubstFvar P] [DecidableEq P.Ident] :
    PipelinePre ([] : List (Stmt P (Cmd P))) where
  h_lhni := by simp [Block.loopHasNoInvariants]
  h_nml := by simp [Block.noMeasureLoops]
  h_unique := by simp [Block.uniqueInits, Block.initVars]
  h_userlabels := by simp [Block.userLabelsShapeNodup, Block.getBlockLabels]
  h_covered := by simp [Block.exitsCoveredByBlocks]
  h_ndelim_writes := by intro s _ hmem; exact absurd hmem (by simp)
  h_ndelim_reads := Block.exprsShapeFree_nil
  h_disj_initVars := by intro s _ hmem; exact absurd hmem (by simp [Block.initVars])

end Imperative.StructuredToUnstructuredPipeline

