public section

namespace Core

open Imperative

/-- Core-facing structured-to-CFG lowering: `none` on a call, otherwise project →
lower → embed. -/
def stmtsToCFG (ss : Statements) :
    Option (CFG String (DetBlock String Command Expression)) :=
  match projectStmts ss with
  | some bs => some (embedCFG (Imperative.stmtsToCFG bs))
  | none => none

namespace StructuredToUnstructured

/-- Executable check for `Imperative.Block.userLabelsShapeNodup`: the block
labels of `ss` are duplicate-free and none ends in `_<digits>`, the shape of a
generated label. -/
def userLabelsOk (ss : Statements) : Bool :=
  let ls := Imperative.Block.getBlockLabels ss
  ls.all (fun l => !String.endsWithUnderscoreDigits l) && decide ls.Nodup

/-- No variable initialized in `ss` has a name that starts with a prefix
reserved by structured lowering. A body failing this admits no entry
environment satisfying the lowering's source gate, and its initializations
could capture generated names. -/
def initsAvoidReservedPrefixes (ss : Statements) : Bool :=
  (Imperative.Block.initVars (C := Command) ss).all fun x =>
    !Imperative.StructuredToUnstructured.prefixesReserved.any fun pfx =>
      pfx.toList.isPrefixOf x.name.toList

/-- Rewrite one declaration by lowering a nonempty structured body to a CFG.
Non-procedure declarations and abstract procedures pass through unchanged. CFG
bodies, calls, and bodies that fail a shape condition of the lowering's
correctness theorem (an `exit` with no enclosing block of that label, duplicate
block labels or labels ending in `_<digits>`) or initialize a name under a
prefix reserved by the lowering are rejected. -/
def structuredToUnstructuredDecl
    (d : Decl) : Except Strata.Message (Decl × Bool) :=
  match d with
  | .proc proc md =>
    match proc.body with
    | .structured ss =>
      if ss.isEmpty then
        pure (d, false)
      else if !Imperative.Block.checkExitsCoveredByBlocks [] ss then
        throw (Strata.Message.fromString
          s!"structuredToUnstructured: procedure '{proc.header.name.1}' \
             contains an exit with no enclosing block of that label.")
      else if !userLabelsOk ss then
        throw (Strata.Message.fromString
          s!"structuredToUnstructured: procedure '{proc.header.name.1}' \
             has duplicate block labels or a block label ending in \
             '_<digits>'; structuredToUnstructured expects distinct labels \
             that cannot collide with generated ones.")
      else if !initsAvoidReservedPrefixes ss then
        throw (Strata.Message.fromString
          s!"structuredToUnstructured: procedure '{proc.header.name.1}' \
             initializes a variable whose name starts with \
             `{Imperative.StructuredToUnstructured.s2uPrefix}`, a prefix reserved \
             for names generated by structuredToUnstructured.")
      else
        match Core.stmtsToCFG ss with
        | some cfg =>
          pure (Decl.proc { proc with body := .cfg cfg } md, true)
        | none =>
          throw (Strata.Message.fromString
            s!"structuredToUnstructured: procedure '{proc.header.name.1}' \
               contains a call; structuredToUnstructured expects call-free \
               structured bodies.")
    | .cfg _ =>
      throw (Strata.Message.fromString
        s!"structuredToUnstructured: procedure '{proc.header.name.1}' already \
           has a CFG body; structuredToUnstructured expects structured bodies.")
  | _ => pure (d, false)

/-- Lower every nonempty structured Core procedure body to a CFG. The returned
flag is true exactly when at least one body changes. -/
def structuredToUnstructured
    (p : Program) : Transform.CoreTransformM (Bool × Program) := do
  let results ← liftExcept (p.decls.mapM structuredToUnstructuredDecl)
  return (results.any (·.2), { decls := results.map (·.1) })

/-- Structured-to-unstructured pipeline phase. Its `requires` facts cover the
fact-tracked source conditions of the lowering correctness theorem. The two
conditions no `ProgramFact` tracks (every `exit` is covered by an enclosing
block, and user labels are duplicate-free and not `_<digits>`-shaped) are
checked on each body by `structuredToUnstructuredDecl`, which rejects a body
that fails them. It also rejects a body initializing a name under a reserved
prefix, for which the theorem's source gate is unsatisfiable. -/
def structuredToUnstructuredPipelinePhase : PipelinePhase :=
  modelPreservingPipelinePhase
    "structuredToUnstructured" structuredToUnstructured
    (requires := factSet![.noCFGBodies, .noCalls, .noLoopInvariants,
      .noLoopMeasures, .uniqueInits, .loopBodyNoInits, .noNondetGuards])
    (establishes := factSet![])
    (preserves := factSet![.noCalls, .noBetaRedexes, .noPrecondsFromFuncs,
      .noProcedureContracts, .noPolymorphicProcedures,
      .noPolymorphicFunctions])

end StructuredToUnstructured

