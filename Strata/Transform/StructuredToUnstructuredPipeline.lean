module

public import Strata.Transform.NondetElimProps
public import Strata.Transform.LoopInitHoist
public import Strata.Transform.StructuredToUnstructured

import all Strata.Transform.NondetElim

/-! # Structured-to-unstructured pipeline: definitions

The composed transform `s2uPipeline = stmtsToCFG ∘ hoistLoopPrefixInits ∘ nondetElim`
(generic, total) and its Core counterpart `Core.StructuredToUnstructuredPipeline.s2uPipeline`
(partial, rejecting call-bearing blocks), and the combined generated-name
predicate `isGeneratedName`. The soundness proofs, including the generic
syntactic precondition `PipelinePre`, live in
`StructuredToUnstructuredPipelineCorrect` and
`StructuredToUnstructuredPipelineCoreCorrect`. -/

public section

namespace Imperative.StructuredToUnstructuredPipeline

/-- Parameters after consuming NondetElim reservations but before
structured lowering consumes its own reservations. -/
@[expose] def intermediateParams {P : PureExpr} (base : Logic.InitEnvWFParams P) :
    Logic.InitEnvWFParams P :=
  base.extend StructuredToUnstructured.prefixesReserved

/-- Source parameters for the composed pipeline. -/
@[expose] def sourceParams {P : PureExpr} (base : Logic.InitEnvWFParams P) : Logic.InitEnvWFParams P :=
  (intermediateParams base).extend NondetElim.prefixesReserved

/-- The composed structured-to-unstructured pipeline. -/
@[expose] def s2uPipeline {P : PureExpr} [HasIdent P] [HasFvar P] [HasFvars P] [HasBool P]
    [HasBoolOps P] [HasInt P] [HasIntOps P]
    (ss : List (Stmt P (Cmd P))) :
    CFG String (DetBlock String (Cmd P) P) :=
  (stmtsToCFG ∘ Block.hoistLoopPrefixInits ∘ Block.nondetElim) ss

/-- A name generated by either nondeterminism elimination or structured CFG
lowering. -/
@[expose] def isGeneratedName (name : String) : Prop :=
  NondetElim.isGeneratedName name ∨
    StructuredToUnstructured.isGeneratedName name

end Imperative.StructuredToUnstructuredPipeline

namespace Core.StructuredToUnstructuredPipeline

/-- The Core structured-to-unstructured pipeline: `nondetElim`, then
`Core.hoistLoopPrefixInits`, then `Core.stmtsToCFG`. It returns `none` when a
stage rejects the block (a call-bearing block). -/
@[expose] def s2uPipeline (ss : Statements) :
    Option (Imperative.CFG String (Imperative.DetBlock String Command Expression)) :=
  (some (Imperative.Block.nondetElim ss) >>= Core.hoistLoopPrefixInits) >>=
    Core.stmtsToCFG

end Core.StructuredToUnstructuredPipeline

end -- public section
