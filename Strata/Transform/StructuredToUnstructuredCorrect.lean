private structure TraceSim {P : PureExpr} [HasFvar P] [HasFvars P] [HasBoolOps P]
    (Rel : Env P → Env P → Prop)
    (terminalTarget : Env P → CFGConfig String (Cmd P) P)
    (exitingTarget : String → Env P → CFGConfig String (Cmd P) P)
    (source : Config P (Cmd P)) (target : CFGConfig String (Cmd P) P) : Prop where
  simulate : ∀ {sourceFinal sourceTrace},
    StepStmtStarE P (Imperative.EvalCmdE P) source sourceTrace sourceFinal →
    ∃ targetFinal targetTrace,
      StepCFGStarE P (Imperative.EvalCmdE P) target targetTrace targetFinal ∧
      TraceExtendsEnv (fun _ : P.Ident => True) sourceTrace targetTrace
  terminal : ∀ {sourceEnv sourceTrace},
    StepStmtStarE P (Imperative.EvalCmdE P) source sourceTrace (.terminal sourceEnv) →
    ∃ targetEnv targetTrace,
      StepCFGStarE P (Imperative.EvalCmdE P) target targetTrace (terminalTarget targetEnv) ∧
      Rel sourceEnv targetEnv ∧
      TraceExtendsEnv (fun _ : P.Ident => True) sourceTrace targetTrace
  exiting : ∀ {label sourceEnv sourceTrace},
    StepStmtStarE P (Imperative.EvalCmdE P) source sourceTrace (.exiting label sourceEnv) →
    ∃ targetEnv targetTrace,
      StepCFGStarE P (Imperative.EvalCmdE P) target targetTrace (exitingTarget label targetEnv) ∧
      Rel sourceEnv targetEnv ∧
      TraceExtendsEnv (fun _ : P.Ident => True) sourceTrace targetTrace

private theorem EvalCmdsE.toCFGPrefixStore {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {factory : P.Factory} {start final : SemanticStore P}
    {commands suffix : List (Cmd P)} {trace : Trace P}
    {cfg : CFG String (DetBlock String (Cmd P) P)} {label : String}
    {transfer : DetTransferCmd String P}
    (h : EvalCmdsE factory start commands final trace) :
    StepCFGStarE P (Imperative.EvalCmdE P)
      (.inBlock cfg label (commands ++ suffix) transfer
        { store := start, factory := factory })
      trace
      (.inBlock cfg label suffix transfer
        { store := final, factory := factory }) := by
  induction h with
  | nil => exact .refl _
  | cons hcommand _ ih => exact .step _ _ _ _ _ (.step_cmd hcommand) ih

private theorem EvalCmdsE.toCFGPrefix {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {initial : Env P} {final : SemanticStore P}
    {commands suffix : List (Cmd P)} {trace : Trace P}
    {cfg : CFG String (DetBlock String (Cmd P) P)} {label : String}
    {transfer : DetTransferCmd String P}
    (h : EvalCmdsE initial.factory initial.store commands final trace) :
    StepCFGStarE P (Imperative.EvalCmdE P)
      (.inBlock cfg label (commands ++ suffix) transfer initial)
      trace
      (.inBlock cfg label suffix transfer { initial with store := final }) := by
  cases initial with
  | mk store factory =>
      simpa using (EvalCmdsE.toCFGPrefixStore (cfg := cfg) (label := label)
        (transfer := transfer) (suffix := suffix) h)

private theorem CommandSourceInv.terminal {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {initial final : Env P} {commands : List (Cmd P)} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (commands.map (@Stmt.cmd P (Cmd P))) initial) trace (.terminal final)) :
    ∃ store,
      EvalCmdsE initial.factory initial.store commands store trace ∧
      final = { initial with store := store } := by
  obtain ⟨done, remaining, store, hcommands, heval, hshape⟩ :=
    CommandSourceInv.ofRun hrun
  rcases hshape with hshape | ⟨command, tail, _, hshape⟩ | hshape | ⟨hremaining, hshape⟩
  · simp at hshape
  · simp at hshape
  · simp at hshape
  · injection hshape with hfinal
    subst remaining
    have hdone : done = commands := by simpa using hcommands
    subst done
    exact ⟨store, heval, hfinal⟩

private theorem CommandSourceInv.notExiting {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {initial final : Env P} {commands : List (Cmd P)} {trace : Trace P} {label : String}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (commands.map (@Stmt.cmd P (Cmd P))) initial) trace (.exiting label final)) : False := by
  obtain ⟨_, _, _, _, _, hshape⟩ := CommandSourceInv.ofRun hrun
  rcases hshape with hshape | ⟨_, _, _, hshape⟩ | hshape | ⟨_, hshape⟩ <;> simp at hshape

private theorem commandBlockSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P]
    [DecidableEq P.Ident]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (label : String) (commands : List (Cmd P))
    (transfer : DetTransferCmd String P)
    (hlookup : cfg.blocks.lookup label = some { cmds := commands, transfer := transfer })
    (keep : List P.Ident)
    (source target : Env P)
    (hrel : EnvRel (Cmds.definedVars commands ++ keep) source target)
    (hnodup : (Cmds.definedVars commands ++ keep).Nodup)
    (hmono : WellFormedSemanticEvalMono source.factory)
    (exitTarget : String → Env P → CFGConfig String (Cmd P) P) :
    TraceSim (EnvRel keep)
      (fun env => .inBlock cfg label [] transfer env)
      exitTarget
      (.stmts (commands.map (@Stmt.cmd P (Cmd P))) source)
      (.atBlock cfg label target) := by
  have replayPrefix : ∀ {done remaining sourceFinal sourceTrace},
      done ++ remaining = commands →
      EvalCmdsE source.factory source.store done sourceFinal sourceTrace →
      ∃ targetFinal targetTrace,
        EvalCmdsE target.factory target.store done targetFinal targetTrace ∧
        StoreAgreement sourceFinal targetFinal ∧
        (∀ x ∈ keep, targetFinal x = none) ∧
        TraceExtendsEnv (fun _ : P.Ident => True) sourceTrace targetTrace := by
    intro done remaining sourceFinal sourceTrace hcommands heval
    have hsub : (Cmds.definedVars done ++ keep).Sublist
        (Cmds.definedVars commands ++ keep) := by
      rw [← hcommands, Cmds.definedVars_append, List.append_assoc]
      exact List.Sublist.append (List.Sublist.refl (Cmds.definedVars done))
        (List.sublist_append_right (Cmds.definedVars remaining) keep)
    obtain ⟨targetFinal, targetTrace, htarget, hagree, hfresh, htrace⟩ :=
      EvalCmdsE.replay heval hmono hrel.store
        (fun x hx => hrel.fresh x (hsub.mem hx))
        (hsub.nodup hnodup)
    have htarget' : EvalCmdsE target.factory target.store done targetFinal targetTrace := by
      simpa [hrel.factory] using htarget
    exact ⟨targetFinal, targetTrace, htarget', hagree, hfresh, htrace⟩
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    obtain ⟨done, remaining, sourceStore, hcommands, heval, _⟩ :=
      CommandSourceInv.ofRun hrun
    obtain ⟨targetStore, targetTrace, htarget, _, _, htrace⟩ :=
      replayPrefix hcommands heval
    have hfetch : StepCFGE P (Imperative.EvalCmdE P)
        (.atBlock cfg label target) []
        (.inBlock cfg label commands transfer target) := StepCFGE.fetch hlookup
    rw [← hcommands] at hfetch
    have hprefix := EvalCmdsE.toCFGPrefix (cfg := cfg) (label := label)
      (transfer := transfer) (suffix := remaining) htarget
    have hrunTarget : StepCFGStarE P (Imperative.EvalCmdE P)
        (.atBlock cfg label target) targetTrace
        (.inBlock cfg label remaining transfer { target with store := targetStore }) := by
      change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ targetTrace _
      simpa using ReflTransTrace.step _ _ _ _ _ hfetch hprefix
    exact ⟨_, targetTrace, hrunTarget, htrace⟩
  · intro sourceEnv sourceTrace hrun
    obtain ⟨sourceStore, heval, hsourceEnv⟩ := CommandSourceInv.terminal hrun
    obtain ⟨targetStore, targetTrace, htarget, hagree, hfresh, htrace⟩ :=
      replayPrefix (remaining := []) (by simp) heval
    have hfetch : StepCFGE P (Imperative.EvalCmdE P)
        (.atBlock cfg label target) []
        (.inBlock cfg label commands transfer target) := StepCFGE.fetch hlookup
    have hprefix := EvalCmdsE.toCFGPrefix (cfg := cfg) (label := label)
      (transfer := transfer) (suffix := []) htarget
    have hprefix' : StepCFGStarE P (Imperative.EvalCmdE P)
        (.inBlock cfg label commands transfer target) targetTrace
        (.inBlock cfg label [] transfer { target with store := targetStore }) := by
      simpa using hprefix
    have hrunTarget : StepCFGStarE P (Imperative.EvalCmdE P)
        (.atBlock cfg label target) targetTrace
        (.inBlock cfg label [] transfer { target with store := targetStore }) := by
      change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ targetTrace _
      simpa using ReflTransTrace.step _ _ _ _ _ hfetch hprefix'
    subst sourceEnv
    refine ⟨{ target with store := targetStore }, targetTrace, hrunTarget, ?_, htrace⟩
    exact ⟨hrel.factory, hagree, hfresh, hrel.mono, hrel.val⟩
  · intro label' sourceEnv sourceTrace hrun
    exact (CommandSourceInv.notExiting hrun).elim

end S2UTrace
