private theorem stmtsPrefixAppend {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (left right : List (Stmt P (Cmd P))) (initial : Env P)
    {final : Config P (Cmd P)} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts left initial) trace final) :
    ∃ target, StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (left ++ right) initial) trace target := by
  induction left generalizing initial trace final with
  | nil =>
      obtain ⟨htrace, _⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hrun
      subst trace
      exact ⟨_, .refl _⟩
  | cons statement rest ih =>
      rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with
        ⟨hfinal, htrace⟩ | hseq
      · subst final
        subst trace
        exact ⟨_, .refl _⟩
      · rcases seq_run_decomposeE (Imperative.EvalCmdE P) hseq with
          ⟨inner, hfinal, hhead⟩ |
          ⟨middle, headTrace, tailTrace, htrace, hhead, htail⟩ |
          ⟨label, exitEnv, hfinal, hhead⟩
        · subst final
          exact ⟨.seq inner (rest ++ right),
            .step _ [] _ trace _ .step_stmts_cons
              (seq_inner_starE (Imperative.EvalCmdE P) hhead)⟩
        · obtain ⟨target, htarget⟩ := ih middle htail
          subst trace
          exact ⟨target, ReflTransTrace.trans _
            (stmts_cons_stepE (Imperative.EvalCmdE P)
              statement (rest ++ right) initial middle hhead) htarget⟩
        · subst final
          have hfirst : StepStmtStarE P (Imperative.EvalCmdE P)
              (.stmts (statement :: (rest ++ right)) initial) trace
              (.seq (.exiting label exitEnv) (rest ++ right)) :=
            .step _ [] _ trace _ .step_stmts_cons
              (seq_inner_starE (Imperative.EvalCmdE P) hhead)
          exact ⟨.exiting label exitEnv, by
            simpa using ReflTransTrace.trans _ hfirst
              (.step _ [] _ [] _ .step_seq_exit (.refl _))⟩

private theorem stmtsPrefixTerminalAppend {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (left right : List (Stmt P (Cmd P))) (initial final : Env P)
    {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts left initial) trace (.terminal final)) :
    StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (left ++ right) initial) trace (.stmts right final) := by
  induction left generalizing initial trace with
  | nil =>
      obtain ⟨htrace, hfinal⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hrun
      subst trace
      rcases hfinal with hbad | hfinal
      · simp at hbad
      · injection hfinal with henv
        subst final
        exact .refl _
  | cons statement rest ih =>
      rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with hbad | hseq
      · simp at hbad
      · obtain ⟨middle, headTrace, tailTrace, htrace, hhead, htail⟩ :=
          seq_reaches_terminalE (Imperative.EvalCmdE P) hseq
        subst trace
        exact ReflTransTrace.trans _
          (stmts_cons_stepE (Imperative.EvalCmdE P)
            statement (rest ++ right) initial middle hhead)
          (ih middle htail)

private theorem typeDeclStmtRun {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (constructor : TypeConstructor) (metadata : MetaData P) (initial : Env P)
    {final : Config P (Cmd P)} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmt (.typeDecl constructor metadata) initial) trace final) :
    trace = [] ∧
      (final = .stmt (.typeDecl constructor metadata) initial ∨ final = .terminal initial) := by
  cases hrun with
  | refl => exact ⟨rfl, .inl rfl⟩
  | step _ _ _ restTrace _ hfirst hrest =>
      cases hfirst with
      | step_typeDecl =>
          obtain ⟨hfinal, htrace⟩ := stepStmtStarE_from_terminal hrest
          subst htrace
          exact ⟨by simp, .inr hfinal⟩

private theorem typeDeclLeadingPrefix {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (constructor : TypeConstructor) (metadata : MetaData P)
    (rest : List (Stmt P (Cmd P))) (initial : Env P)
    {final : Config P (Cmd P)} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (.typeDecl constructor metadata :: rest) initial) trace final) :
    ∃ target, StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts rest initial) trace target := by
  rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with
    ⟨hfinal, htrace⟩ | hseq
  · subst final
    subst trace
    exact ⟨_, .refl _⟩
  · rcases seq_run_decomposeE (Imperative.EvalCmdE P) hseq with
      ⟨inner, hfinal, hhead⟩ |
      ⟨middle, headTrace, tailTrace, htrace, hhead, htail⟩ |
      ⟨label, exitEnv, hfinal, hhead⟩
    · obtain ⟨htrace, _⟩ := typeDeclStmtRun constructor metadata initial hhead
      subst trace
      exact ⟨_, .refl _⟩
    · obtain ⟨hheadTrace, hshape⟩ := typeDeclStmtRun constructor metadata initial hhead
      rcases hshape with hbad | hmiddle
      · simp at hbad
      · injection hmiddle with henv
        subst middle
        subst headTrace
        simp only [List.nil_append] at htrace
        subst trace
        exact ⟨_, htail⟩
    · obtain ⟨_, hshape⟩ := typeDeclStmtRun constructor metadata initial hhead
      rcases hshape with hbad | hbad <;> simp at hbad

private theorem typeDeclLeadingTerminal {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (constructor : TypeConstructor) (metadata : MetaData P)
    (rest : List (Stmt P (Cmd P))) (initial final : Env P)
    {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (.typeDecl constructor metadata :: rest) initial)
      trace (.terminal final)) :
    StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts rest initial) trace (.terminal final) := by
  obtain ⟨middle, headTrace, tailTrace, htrace, hhead, htail⟩ :=
    stmtsAppendTerminalCases [.typeDecl constructor metadata] rest initial final
      (by simpa using hrun)
  obtain ⟨hheadTrace, hshape⟩ := typeDeclStmtRun constructor metadata initial
    (show StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmt (.typeDecl constructor metadata) initial) headTrace (.terminal middle) from by
        rcases stmts_cons_headE (Imperative.EvalCmdE P) hhead with hbad | hseq
        · simp at hbad
        · obtain ⟨middle', firstTrace, nilTrace, htr, hstmt, hnil⟩ :=
            seq_reaches_terminalE (Imperative.EvalCmdE P) hseq
          obtain ⟨hnilTrace, hnilShape⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hnil
          subst nilTrace
          rcases hnilShape with hbad | hfinal
          · simp at hbad
          · injection hfinal with henv
            subst middle'
            simpa [htr] using hstmt)
  rcases hshape with hbad | hmiddle
  · simp at hbad
  · injection hmiddle with henv
    subst middle
    subst headTrace
    simpa [htrace] using htail

private theorem typeDeclLeadingExiting {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (constructor : TypeConstructor) (metadata : MetaData P)
    (rest : List (Stmt P (Cmd P))) (initial final : Env P)
    (label : String) {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (.typeDecl constructor metadata :: rest) initial)
      trace (.exiting label final)) :
    StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts rest initial) trace (.exiting label final) := by
  rcases stmtsAppendExitingCases [.typeDecl constructor metadata] rest initial final label
      (by simpa using hrun) with hhead | htail
  · rcases stmts_cons_headE (Imperative.EvalCmdE P) hhead with hbad | hseq
    · simp at hbad
    · rcases seq_reaches_exitingE (Imperative.EvalCmdE P) hseq with hstmt | hbad
      · obtain ⟨_, hshape⟩ := typeDeclStmtRun constructor metadata initial hstmt
        rcases hshape with hbad | hbad <;> simp at hbad
      · obtain ⟨middle, headTrace, nilTrace, htr, hstmt, hnil⟩ := hbad
        obtain ⟨_, hnilShape⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hnil
        rcases hnilShape with hbad | hbad <;> simp at hbad
  · obtain ⟨middle, leftTrace, rightTrace, htrace, hleft, hright⟩ := htail
    have hempty : StepStmtStarE P (Imperative.EvalCmdE P)
        (.stmts [] initial) leftTrace (.terminal middle) :=
      typeDeclLeadingTerminal constructor metadata [] initial middle (by simpa using hleft)
    obtain ⟨hleftTrace, hshape⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hempty
    rcases hshape with hbad | hmiddle
    · simp at hbad
    · injection hmiddle with henv
      subst middle
      subst leftTrace
      simpa [htrace] using hright

private theorem TraceSim.eraseTypeDecl {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {Rel : Env P → Env P → Prop}
    {terminalTarget : Env P → CFGConfig String (Cmd P) P}
    {exitingTarget : String → Env P → CFGConfig String (Cmd P) P}
    (commands : List (Cmd P)) (constructor : TypeConstructor) (metadata : MetaData P)
    (rest : List (Stmt P (Cmd P))) (source : Env P)
    {target : CFGConfig String (Cmd P) P}
    (h : TraceSim Rel terminalTarget exitingTarget
      (.stmts (commands.map (@Stmt.cmd P (Cmd P)) ++ rest) source) target) :
    TraceSim Rel terminalTarget exitingTarget
      (.stmts (commands.map (@Stmt.cmd P (Cmd P)) ++
        (.typeDecl constructor metadata :: rest)) source) target := by
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    rcases stmtsAppendPrefixCases (commands.map (@Stmt.cmd P (Cmd P)))
        (.typeDecl constructor metadata :: rest) source hrun with
      ⟨commandFinal, hcommands⟩ |
      ⟨middle, commandTrace, tailTrace, htrace, hcommands, htail⟩
    · obtain ⟨targetFinal, htarget⟩ := stmtsPrefixAppend
        (commands.map (@Stmt.cmd P (Cmd P))) rest source hcommands
      exact h.simulate htarget
    · obtain ⟨tailFinal, htail'⟩ :=
        typeDeclLeadingPrefix constructor metadata rest middle htail
      have hboundary := stmtsPrefixTerminalAppend
        (commands.map (@Stmt.cmd P (Cmd P))) rest source middle hcommands
      subst sourceTrace
      exact h.simulate (ReflTransTrace.trans _ hboundary htail')
  · intro sourceEnv sourceTrace hrun
    obtain ⟨middle, commandTrace, tailTrace, htrace, hcommands, htail⟩ :=
      stmtsAppendTerminalCases (commands.map (@Stmt.cmd P (Cmd P)))
        (.typeDecl constructor metadata :: rest) source sourceEnv hrun
    have htail' := typeDeclLeadingTerminal constructor metadata rest middle sourceEnv htail
    have hboundary := stmtsPrefixTerminalAppend
      (commands.map (@Stmt.cmd P (Cmd P))) rest source middle hcommands
    subst sourceTrace
    exact h.terminal (ReflTransTrace.trans _ hboundary htail')
  · intro label sourceEnv sourceTrace hrun
    rcases stmtsAppendExitingCases (commands.map (@Stmt.cmd P (Cmd P)))
        (.typeDecl constructor metadata :: rest) source sourceEnv label hrun with
      hcommands |
      ⟨middle, commandTrace, tailTrace, htrace, hcommands, htail⟩
    · exact (CommandSourceInv.notExiting hcommands).elim
    · have htail' := typeDeclLeadingExiting constructor metadata rest middle sourceEnv
        label htail
      have hboundary := stmtsPrefixTerminalAppend
        (commands.map (@Stmt.cmd P (Cmd P))) rest source middle hcommands
      subst sourceTrace
      exact h.exiting (ReflTransTrace.trans _ hboundary htail')

end S2UTrace
end StructuredToUnstructuredCorrect

