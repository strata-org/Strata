private theorem EnvRel.projectLeft {P : PureExpr} [HasFvars P] [HasBool P]
    {keep : List P.Ident} {parent : SemanticStore P} {source target : Env P}
    (h : EnvRel keep source target) :
    EnvRel keep { source with store := projectStore parent source.store } target :=
  ⟨h.factory, StoreAgreement.trans (StoreAgreement.of_projectStore parent source.store) h.store,
    h.fresh, h.mono, h.val⟩

private theorem EnvRel.eval {P : PureExpr} [HasFvars P] [HasBool P]
    {keep : List P.Ident} {source target : Env P} (h : EnvRel keep source target)
    (hmono : WellFormedSemanticEvalMono source.factory)
    {expression : P.Expr} {value : P.Val}
    (heval : P.eval source.factory source.store expression = some value) :
    P.eval target.factory target.store expression = some value := by
  rw [h.factory]
  exact hmono expression value source.store target.store
    (storeAgreement_supplies_mono_premise _ _ h.store) heval

private theorem blockRunDecompose {P : PureExpr}
    [HasFvar P] [HasBoolOps P]
    {label : Option String} {parent : SemanticStore P}
    {inner final : Config P (Cmd P)} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.block label parent inner) trace final) :
    (∃ inner', final = .block label parent inner' ∧
      StepStmtStarE P (Imperative.EvalCmdE P) inner trace inner') ∨
    (∃ env, StepStmtStarE P (Imperative.EvalCmdE P) inner trace (.terminal env) ∧
      final = .terminal { env with store := projectStore parent env.store }) ∨
    (∃ exitLabel env, label = some exitLabel ∧
      StepStmtStarE P (Imperative.EvalCmdE P) inner trace (.exiting exitLabel env) ∧
      final = .terminal { env with store := projectStore parent env.store }) ∨
    (∃ exitLabel env, label ≠ some exitLabel ∧
      StepStmtStarE P (Imperative.EvalCmdE P) inner trace (.exiting exitLabel env) ∧
      final = .exiting exitLabel { env with store := projectStore parent env.store }) := by
  suffices hgeneral : ∀ source sourceTrace target,
      StepStmtStarE P (Imperative.EvalCmdE P) source sourceTrace target →
      ∀ inner, source = .block label parent inner →
      (∃ inner', target = .block label parent inner' ∧
        StepStmtStarE P (Imperative.EvalCmdE P) inner sourceTrace inner') ∨
      (∃ env, StepStmtStarE P (Imperative.EvalCmdE P) inner sourceTrace (.terminal env) ∧
        target = .terminal { env with store := projectStore parent env.store }) ∨
      (∃ exitLabel env, label = some exitLabel ∧
        StepStmtStarE P (Imperative.EvalCmdE P) inner sourceTrace (.exiting exitLabel env) ∧
        target = .terminal { env with store := projectStore parent env.store }) ∨
      (∃ exitLabel env, label ≠ some exitLabel ∧
        StepStmtStarE P (Imperative.EvalCmdE P) inner sourceTrace (.exiting exitLabel env) ∧
        target = .exiting exitLabel { env with store := projectStore parent env.store }) by
    exact hgeneral _ _ _ hrun _ rfl
  intro source sourceTrace target hrun'
  induction hrun' with
  | refl =>
      intro inner hsource
      subst hsource
      exact .inl ⟨_, rfl, .refl _⟩
  | step source emitted middle rest target hstep hrest ih =>
      intro inner hsource
      subst hsource
      rcases Imperative.StepStmtE.block_cases hstep with
        ⟨inner', hinner, rfl⟩ | ⟨env, rfl, rfl, rfl⟩ |
        ⟨exitLabel, env, rfl, rfl, heq, rfl⟩ |
        ⟨exitLabel, env, rfl, rfl, hne, rfl⟩
      · rcases ih _ rfl with
          ⟨inner'', hfinal, htail⟩ |
          ⟨env, htail, hfinal⟩ |
          ⟨exitLabel, env, heq, htail, hfinal⟩ |
          ⟨exitLabel, env, hne, htail, hfinal⟩
        · exact .inl ⟨inner'', hfinal, .step _ _ _ _ _ hinner htail⟩
        · exact .inr (.inl ⟨env, .step _ _ _ _ _ hinner htail, hfinal⟩)
        · exact .inr (.inr (.inl
            ⟨exitLabel, env, heq, .step _ _ _ _ _ hinner htail, hfinal⟩))
        · exact .inr (.inr (.inr
            ⟨exitLabel, env, hne, .step _ _ _ _ _ hinner htail, hfinal⟩))
      · obtain ⟨hfinal, htrace⟩ := stepStmtStarE_from_terminal hrest
        subst htrace
        exact .inr (.inl ⟨env, .refl _, hfinal⟩)
      · obtain ⟨hfinal, htrace⟩ := stepStmtStarE_from_terminal hrest
        subst htrace
        exact .inr (.inr (.inl ⟨exitLabel, env, heq, .refl _, hfinal⟩))
      · obtain ⟨hfinal, htrace⟩ := stepStmtStarE_from_exiting hrest
        subst htrace
        exact .inr (.inr (.inr ⟨exitLabel, env, hne, .refl _, hfinal⟩))

private theorem cfgCondStep {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (current thenLabel elseLabel : String) (condition : P.Expr)
    (source target : Env P) {keep : List P.Ident}
    (hrel : EnvRel keep source target)
    (hmono : WellFormedSemanticEvalMono source.factory)
    (branch : Bool)
    (heval : P.eval source.factory source.store condition =
      some (if branch then HasBool.ttVal source.factory else HasBool.ffVal source.factory)) :
    StepCFGStarE P (Imperative.EvalCmdE P)
      (.inBlock cfg current [] (.condGoto condition thenLabel elseLabel .empty) target) []
      (.atBlock cfg (if branch then thenLabel else elseLabel) target) := by
  have htarget := hrel.eval hmono heval
  rw [← hrel.factory] at htarget
  cases branch with
  | false => exact .step _ [] _ [] _ (StepCFGE.goto_false htarget) (.refl _)
  | true => exact .step _ [] _ [] _ (StepCFGE.goto_true htarget) (.refl _)

private theorem cfgLoopStep {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (entry body continuation : String) (condition : P.Expr)
    (hlookup : cfg.blocks.lookup entry = some
      ({ cmds := [], transfer := .condGoto condition body continuation .empty } :
        DetBlock String (Cmd P) P))
    (source target : Env P) {keep : List P.Ident}
    (hrel : EnvRel keep source target)
    (hmono : WellFormedSemanticEvalMono source.factory)
    (branch : Bool)
    (heval : P.eval source.factory source.store condition =
      some (if branch then HasBool.ttVal source.factory else HasBool.ffVal source.factory)) :
    StepCFGStarE P (Imperative.EvalCmdE P)
      (.atBlock cfg entry target) []
      (.atBlock cfg (if branch then body else continuation) target) := by
  have hfetch : StepCFGE P (Imperative.EvalCmdE P)
      (.atBlock cfg entry target) []
      (.inBlock cfg entry [] (.condGoto condition body continuation .empty) target) :=
    StepCFGE.fetch hlookup
  have hbranch := cfgCondStep cfg entry body continuation condition source target
    hrel hmono branch heval
  change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ [] _
  simpa using ReflTransTrace.trans _
    (.step _ [] _ [] _ hfetch (.refl _)) hbranch

end S2UTrace
end StructuredToUnstructuredCorrect

namespace StructuredToUnstructuredCorrect
open Imperative Specification
namespace S2UTrace

private def exitDest (fallback : String)
    (exitConts : List (Option String × String)) (label : String) : String :=
  match exitConts.lookup (some label) with
  | some destination => destination
  | none => fallback

private theorem exitDest_cons_same (fallback label destination : String)
    (exitConts : List (Option String × String)) :
    exitDest fallback ((some label, destination) :: exitConts) label = destination := by
  simp [exitDest, List.lookup]

private theorem exitDest_cons_other (fallback label other destination : String)
    (exitConts : List (Option String × String)) (hne : other ≠ label) :
    exitDest fallback ((some label, destination) :: exitConts) other =
      exitDest fallback exitConts other := by
  simp only [exitDest, List.lookup]
  have hbeq : ((some other : Option String) == some label) = false := by simp [hne]
  rw [hbeq]

private theorem exitStmtSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (destination label : String) (metadata : MetaData P)
    (keep : List P.Ident) (source target : Env P)
    (hrel : EnvRel keep source target)
    (terminalTarget : Env P → CFGConfig String (Cmd P) P) :
    TraceSim (EnvRel keep) terminalTarget
      (fun _ env => .atBlock cfg destination env)
      (.stmt (.exit label metadata) source) (.atBlock cfg destination target) := by
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    cases hrun with
    | refl => exact ⟨_, [], .refl _, .nil⟩
    | step _ _ _ restTrace _ hfirst hrest =>
        cases hfirst with
        | step_exit =>
            obtain ⟨_, htrace⟩ := stepStmtStarE_from_exiting hrest
            subst htrace
            exact ⟨_, [], .refl _, .nil⟩
  · intro sourceEnv sourceTrace hrun
    cases hrun with
    | step _ _ _ _ _ hfirst hrest =>
        cases hfirst with
        | step_exit =>
            obtain ⟨hfinal, _⟩ := stepStmtStarE_from_exiting hrest
            simp at hfinal
  · intro exitLabel sourceEnv sourceTrace hrun
    cases hrun with
    | step _ _ _ restTrace _ hfirst hrest =>
        cases hfirst with
        | step_exit =>
            obtain ⟨hfinal, htrace⟩ := stepStmtStarE_from_exiting hrest
            injection hfinal with hlabel henv
            subst hlabel
            subst henv
            subst htrace
            exact ⟨target, [], .refl _, hrel, .nil⟩

private theorem anonymousBlockSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {BodyRel OutRel : Env P → Env P → Prop}
    {terminalTarget : Env P → CFGConfig String (Cmd P) P}
    {exitingTarget : String → Env P → CFGConfig String (Cmd P) P}
    {body : List (Stmt P (Cmd P))} {source : Env P}
    {targetStart targetBody : CFGConfig String (Cmd P) P}
    (htargetPrefix : StepCFGStarE P (Imperative.EvalCmdE P) targetStart [] targetBody)
    (hbody : TraceSim BodyRel terminalTarget exitingTarget
      (.stmts body source) targetBody)
    (hproject : ∀ sourceInner targetInner,
      BodyRel sourceInner targetInner →
      OutRel { sourceInner with store := projectStore source.store sourceInner.store }
        targetInner) :
    TraceSim OutRel terminalTarget exitingTarget
      (.block none source.store (.stmts body source)) targetStart := by
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    rcases blockRunDecompose hrun with
      ⟨inner, hfinal, hinner⟩ |
      ⟨sourceInner, hinner, hfinal⟩ |
      ⟨label, sourceInner, hnone, hinner, hfinal⟩ |
      ⟨label, sourceInner, hne, hinner, hfinal⟩
    · obtain ⟨targetFinal, targetTrace, htarget, htrace⟩ := hbody.simulate hinner
      exact ⟨targetFinal, targetTrace, by
        change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ targetTrace _
        simpa using ReflTransTrace.trans _ htargetPrefix htarget, htrace⟩
    · obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ := hbody.terminal hinner
      exact ⟨terminalTarget targetInner, targetTrace, by
        change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ targetTrace _
        simpa using ReflTransTrace.trans _ htargetPrefix htarget, htrace⟩
    · simp at hnone
    · obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ := hbody.exiting hinner
      exact ⟨exitingTarget label targetInner, targetTrace, by
        change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ targetTrace _
        simpa using ReflTransTrace.trans _ htargetPrefix htarget, htrace⟩
  · intro sourceEnv sourceTrace hrun
    rcases blockRunDecompose hrun with
      ⟨inner, hfinal, hinner⟩ |
      ⟨sourceInner, hinner, hfinal⟩ |
      ⟨label, sourceInner, hnone, hinner, hfinal⟩ |
      ⟨label, sourceInner, hne, hinner, hfinal⟩
    · simp at hfinal
    · injection hfinal with henv
      subst sourceEnv
      obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ := hbody.terminal hinner
      exact ⟨targetInner, targetTrace, by
        change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ targetTrace _
        simpa using ReflTransTrace.trans _ htargetPrefix htarget,
        hproject sourceInner targetInner hrel, htrace⟩
    · simp at hnone
    · simp at hfinal
  · intro label sourceEnv sourceTrace hrun
    rcases blockRunDecompose hrun with
      ⟨inner, hfinal, hinner⟩ |
      ⟨sourceInner, hinner, hfinal⟩ |
      ⟨innerLabel, sourceInner, hnone, hinner, hfinal⟩ |
      ⟨innerLabel, sourceInner, hne, hinner, hfinal⟩
    · simp at hfinal
    · simp at hfinal
    · simp at hnone
    · injection hfinal with hlabel henv
      subst hlabel
      subst sourceEnv
      obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ := hbody.exiting hinner
      exact ⟨targetInner, targetTrace, by
        change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ targetTrace _
        simpa using ReflTransTrace.trans _ htargetPrefix htarget,
        hproject sourceInner targetInner hrel, htrace⟩

private theorem labeledBlockSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (fallback continuation blockLabel : String)
    (exitConts : List (Option String × String))
    (body : List (Stmt P (Cmd P))) (metadata : MetaData P)
    (keepBody keepOut : List P.Ident)
    (hsub : ∀ x ∈ keepOut, x ∈ keepBody)
    (source target : Env P)
    (bodyEntry : String)
    (hbody : TraceSim (EnvRel keepBody)
      (fun env => .atBlock cfg continuation env)
      (fun label env => .atBlock cfg
        (exitDest fallback ((some blockLabel, continuation) :: exitConts) label) env)
      (.stmts body source) (.atBlock cfg bodyEntry target)) :
    TraceSim (EnvRel keepOut)
      (fun env => .atBlock cfg continuation env)
      (fun label env => .atBlock cfg (exitDest fallback exitConts label) env)
      (.stmt (.block blockLabel body metadata) source)
      (.atBlock cfg bodyEntry target) := by
  have projectOut : ∀ sourceInner targetInner,
      EnvRel keepBody sourceInner targetInner →
      EnvRel keepOut { sourceInner with store := projectStore source.store sourceInner.store }
        targetInner := by
    intro sourceInner targetInner hrel
    exact (EnvRel.projectLeft hrel).weaken hsub
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    cases hrun with
    | refl => exact ⟨_, [], .refl _, .nil⟩
    | step _ _ _ restTrace _ hfirst hrest =>
        cases hfirst with
        | step_block =>
          rcases blockRunDecompose hrest with
            ⟨inner, hfinal, hinner⟩ |
            ⟨sourceInner, hinner, hfinal⟩ |
            ⟨label, sourceInner, hmatch, hinner, hfinal⟩ |
            ⟨label, sourceInner, hmismatch, hinner, hfinal⟩
          · exact hbody.simulate hinner
          · obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ :=
              hbody.terminal hinner
            exact ⟨_, targetTrace, htarget, htrace⟩
          · obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ :=
              hbody.exiting hinner
            have hlabel : label = blockLabel := by simpa using Option.some.inj hmatch.symm
            subst label
            exact ⟨_, targetTrace, htarget, htrace⟩
          · obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ :=
              hbody.exiting hinner
            have hlabel : label ≠ blockLabel := by
              intro heq
              subst label
              exact hmismatch rfl
            exact ⟨_, targetTrace, htarget, htrace⟩
  · intro sourceEnv sourceTrace hrun
    cases hrun with
    | step _ _ _ restTrace _ hfirst hrest =>
        cases hfirst with
        | step_block =>
          rcases blockRunDecompose hrest with
            ⟨inner, hfinal, hinner⟩ |
            ⟨sourceInner, hinner, hfinal⟩ |
            ⟨label, sourceInner, hmatch, hinner, hfinal⟩ |
            ⟨label, sourceInner, hmismatch, hinner, hfinal⟩
          · simp at hfinal
          · injection hfinal with henv
            subst sourceEnv
            obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ :=
              hbody.terminal hinner
            exact ⟨targetInner, targetTrace, htarget,
              projectOut sourceInner targetInner hrel, htrace⟩
          · injection hfinal with henv
            subst sourceEnv
            obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ :=
              hbody.exiting hinner
            have hlabel : label = blockLabel := by simpa using Option.some.inj hmatch.symm
            subst label
            rw [exitDest_cons_same] at htarget
            exact ⟨targetInner, targetTrace, htarget,
              projectOut sourceInner targetInner hrel, htrace⟩
          · simp at hfinal
  · intro label sourceEnv sourceTrace hrun
    cases hrun with
    | step _ _ _ restTrace _ hfirst hrest =>
        cases hfirst with
        | step_block =>
          rcases blockRunDecompose hrest with
            ⟨inner, hfinal, hinner⟩ |
            ⟨sourceInner, hinner, hfinal⟩ |
            ⟨innerLabel, sourceInner, hmatch, hinner, hfinal⟩ |
            ⟨innerLabel, sourceInner, hmismatch, hinner, hfinal⟩
          · simp at hfinal
          · simp at hfinal
          · simp at hfinal
          · have hne : innerLabel ≠ blockLabel := by
              intro heq
              subst innerLabel
              exact hmismatch rfl
            injection hfinal with hlabel henv
            subst hlabel
            subst sourceEnv
            obtain ⟨targetInner, targetTrace, htarget, hrel, htrace⟩ :=
              hbody.exiting hinner
            rw [exitDest_cons_other _ _ _ _ _ hne] at htarget
            exact ⟨targetInner, targetTrace, htarget,
              projectOut sourceInner targetInner hrel, htrace⟩

private theorem deterministicIteSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (current thenLabel elseLabel : String) (condition : P.Expr)
    (thenBranch elseBranch : List (Stmt P (Cmd P))) (metadata : MetaData P)
    (source target : Env P)
    (conditionRel : EnvRel [] source target)
    (hmono : WellFormedSemanticEvalMono source.factory)
    {OutRel ThenRel ElseRel : Env P → Env P → Prop}
    {terminalTarget : Env P → CFGConfig String (Cmd P) P}
    {exitingTarget : String → Env P → CFGConfig String (Cmd P) P}
    (thenSim : TraceSim ThenRel terminalTarget exitingTarget
      (.stmts thenBranch source) (.atBlock cfg thenLabel target))
    (elseSim : TraceSim ElseRel terminalTarget exitingTarget
      (.stmts elseBranch source) (.atBlock cfg elseLabel target))
    (thenProject : ∀ sourceInner targetInner, ThenRel sourceInner targetInner →
      OutRel { sourceInner with store := projectStore source.store sourceInner.store } targetInner)
    (elseProject : ∀ sourceInner targetInner, ElseRel sourceInner targetInner →
      OutRel { sourceInner with store := projectStore source.store sourceInner.store } targetInner) :
    TraceSim OutRel terminalTarget exitingTarget
      (.stmt (.ite (.det condition) thenBranch elseBranch metadata) source)
      (.inBlock cfg current [] (.condGoto condition thenLabel elseLabel .empty) target) := by
  have thenBlock (hguard : P.eval source.factory source.store condition = some
      (HasBool.ttVal source.factory)) :=
    anonymousBlockSim
      (cfgCondStep cfg current thenLabel elseLabel condition source target conditionRel
        hmono true (by simpa using hguard)) thenSim thenProject
  have elseBlock (hguard : P.eval source.factory source.store condition = some
      (HasBool.ffVal source.factory)) :=
    anonymousBlockSim
      (cfgCondStep cfg current thenLabel elseLabel condition source target conditionRel
        hmono false (by simpa using hguard)) elseSim elseProject
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    cases hrun with
    | refl => exact ⟨_, [], .refl _, .nil⟩
    | step _ _ _ restTrace _ hfirst hrest =>
        cases hfirst with
        | step_ite_true hguard => exact (thenBlock hguard).simulate hrest
        | step_ite_false hguard => exact (elseBlock hguard).simulate hrest
  · intro sourceEnv sourceTrace hrun
    cases hrun with
    | step _ _ _ restTrace _ hfirst hrest =>
        cases hfirst with
        | step_ite_true hguard => exact (thenBlock hguard).terminal hrest
        | step_ite_false hguard => exact (elseBlock hguard).terminal hrest
  · intro label sourceEnv sourceTrace hrun
    cases hrun with
    | step _ _ _ restTrace _ hfirst hrest =>
        cases hfirst with
        | step_ite_true hguard => exact (thenBlock hguard).exiting hrest
        | step_ite_false hguard => exact (elseBlock hguard).exiting hrest

end S2UTrace
