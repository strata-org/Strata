private theorem iteDecompose {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    (continuation : String) (gen gen' : StringGenState)
    (entry : String) (blocks : DetBlocks String (Cmd P) P)
    (accum : List (Cmd P)) (condition : P.Expr)
    (thenBranch elseBranch : List (Stmt P (Cmd P))) (metadata : MetaData P)
    (exitConts : List (Option String × String))
    (rest : List (Stmt P (Cmd P)))
    (hgen : stmtsToBlocks continuation
      (.ite (.det condition) thenBranch elseBranch metadata :: rest)
      exitConts accum gen = ((entry, blocks), gen')) :
    ∃ (next current thenEntry elseEntry : String)
      (restBlocks thenBlocks elseBlocks accumBlocks : DetBlocks String (Cmd P) P)
      (genRest genCurrent genThen genElse genFlush : StringGenState)
      (accumEntry : String),
      stmtsToBlocks continuation rest exitConts [] gen = ((next, restBlocks), genRest) ∧
      StringGenState.gen iteLabelPrefix genRest = (current, genCurrent) ∧
      stmtsToBlocks next thenBranch exitConts [] genCurrent =
        ((thenEntry, thenBlocks), genThen) ∧
      stmtsToBlocks next elseBranch exitConts [] genThen =
        ((elseEntry, elseBlocks), genElse) ∧
      flushCmds iteFlushPrefix accum
        (.some (.condGoto condition thenEntry elseEntry .empty)) current genElse =
        ((accumEntry, accumBlocks), genFlush) ∧
      genFlush = gen' ∧ accumEntry = entry ∧
      accumBlocks ++ thenBlocks ++ elseBlocks ++ restBlocks = blocks := by
  let restStep := stmtsToBlocks continuation rest exitConts [] gen
  let next := restStep.1.1
  let restBlocks := restStep.1.2
  let genRest := restStep.2
  let currentStep := StringGenState.gen iteLabelPrefix genRest
  let current := currentStep.1
  let genCurrent := currentStep.2
  let thenStep := stmtsToBlocks next thenBranch exitConts [] genCurrent
  let thenEntry := thenStep.1.1
  let thenBlocks := thenStep.1.2
  let genThen := thenStep.2
  let elseStep := stmtsToBlocks next elseBranch exitConts [] genThen
  let elseEntry := elseStep.1.1
  let elseBlocks := elseStep.1.2
  let genElse := elseStep.2
  let flushStep := @flushCmds P (Cmd P) _ iteFlushPrefix accum
    (.some (.condGoto condition thenEntry elseEntry .empty)) current genElse
  let accumEntry := flushStep.1.1
  let accumBlocks := flushStep.1.2
  let genFlush := flushStep.2
  have hrest : stmtsToBlocks continuation rest exitConts [] gen =
      ((next, restBlocks), genRest) := rfl
  have hcurrent : StringGenState.gen iteLabelPrefix genRest = (current, genCurrent) := rfl
  have hthen : stmtsToBlocks next thenBranch exitConts [] genCurrent =
      ((thenEntry, thenBlocks), genThen) := rfl
  have helse : stmtsToBlocks next elseBranch exitConts [] genThen =
      ((elseEntry, elseBlocks), genElse) := rfl
  have hflush : flushCmds iteFlushPrefix accum
      (.some (.condGoto condition thenEntry elseEntry .empty)) current genElse =
      ((accumEntry, accumBlocks), genFlush) := rfl
  have hred : stmtsToBlocks continuation
      (.ite (.det condition) thenBranch elseBranch metadata :: rest)
      exitConts accum gen =
      ((accumEntry, accumBlocks ++ thenBlocks ++ elseBlocks ++ restBlocks), genFlush) := by
    unfold stmtsToBlocks
    simp only [bind, StateT.bind, hrest, hcurrent, hthen, helse, hflush,
      pure, StateT.pure, List.append_nil]
  have hall := hred.symm.trans hgen
  exact ⟨next, current, thenEntry, elseEntry, restBlocks, thenBlocks, elseBlocks,
    accumBlocks, genRest, genCurrent, genThen, genElse, genFlush, accumEntry,
    hrest, hcurrent, hthen, helse, hflush, (Prod.mk.inj hall).2,
    (Prod.mk.inj (Prod.mk.inj hall).1).1,
    (Prod.mk.inj (Prod.mk.inj hall).1).2⟩

end S2UTrace
end StructuredToUnstructuredCorrect

