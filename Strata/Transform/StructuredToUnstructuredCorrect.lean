private theorem cfgTraceTrans {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {a b c : CFGConfig String (Cmd P) P} {first second : Trace P}
    (hfirst : StepCFGStarE P (Imperative.EvalCmdE P) a first b)
    (hsecond : StepCFGStarE P (Imperative.EvalCmdE P) b second c) :
    StepCFGStarE P (Imperative.EvalCmdE P) a (first ++ second) c := by
  change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) a (first ++ second) c
  exact ReflTransTrace.trans _ hfirst hsecond

private theorem loopTerminalFuel {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (entry bodyEntry continuation : String) (condition : P.Expr)
    (body : List (Stmt P (Cmd P))) (metadata : MetaData P)
    (keep : List P.Ident)
    (exitTarget : String → Env P → CFGConfig String (Cmd P) P)
    (hlookup : cfg.blocks.lookup entry = some
      ({ cmds := [], transfer := .condGoto condition bodyEntry continuation .empty } :
        DetBlock String (Cmd P) P))
    (bodySim : ∀ source target,
      EnvRel keep source target →
      TraceSim (EnvRel keep)
        (fun env => .atBlock cfg entry env) exitTarget
        (.stmts body source) (.atBlock cfg bodyEntry target)) :
    ∀ n source target final sourceTrace,
      EnvRel keep source target →
      WellFormedSemanticEvalMono source.factory →
      (hrun : ReflTransTraceT (StepStmtE P (Imperative.EvalCmdE P))
        (.stmt (.loop (.det condition) none [] body metadata) source)
        sourceTrace (.terminal final)) →
      hrun.len ≤ n →
      ∃ targetFinal targetTrace,
        StepCFGStarE P (Imperative.EvalCmdE P)
          (.atBlock cfg entry target) targetTrace (.atBlock cfg continuation targetFinal) ∧
        EnvRel keep final targetFinal ∧
        TraceExtendsEnv (fun _ : P.Ident => True) sourceTrace targetTrace := by
  intro n
  induction n with
  | zero =>
      intro source target final sourceTrace hrel hmono hrun hlen
      cases hrun with
      | step => simp [ReflTransTraceT.len] at hlen
  | succ n ih =>
      intro source target final sourceTrace hrel hmono hrun hlen
      match hrun with
      | .step _ _ _ restTrace _ (.step_loop_exit hfalse) hrest =>
          obtain ⟨hfinal, htrace⟩ := stepStmtStarE_from_terminal
            (reflTransTraceT_to_prop hrest)
          subst htrace
          injection hfinal with henv
          subst final
          exact ⟨target, [],
            cfgLoopStep cfg entry bodyEntry continuation condition hlookup source target
              hrel hmono false (by simpa using hfalse),
            hrel, .nil⟩
      | .step _ _ _ restTrace _ (.step_loop_enter htrue) hrest =>
          obtain ⟨projectedSource, bodyTrace, loopTrace, htrace, hblock, hloopList,
              hlenSeq⟩ := seqT_reaches_terminalE hrest
          rcases blockRunDecompose (reflTransTraceT_to_prop hblock) with
            ⟨inner, hbad, hsourceBody⟩ |
            ⟨sourceInner, hsourceBody, hprojected⟩ |
            ⟨label, sourceInner, hnone, hsourceBody, hprojected⟩ |
            ⟨label, sourceInner, hne, hsourceBody, hbad⟩
          · simp at hbad
          · injection hprojected with hprojectedEnv
            subst projectedSource
            obtain ⟨targetInner, targetBodyTrace, htargetBody, hrelInner, htraceBody⟩ :=
              (bodySim source target hrel).terminal hsourceBody
            let sourceNext : Env P :=
              { sourceInner with store := projectStore source.store sourceInner.store }
            have hrelNext : EnvRel keep sourceNext targetInner :=
              EnvRel.projectLeft hrelInner
            have hfacBody := starE_preserves_factory hsourceBody
            have hfacNext : sourceNext.factory = source.factory := by
              change sourceInner.factory = source.factory
              simpa [Config.getEnv] using hfacBody.symm
            have hmonoNext : WellFormedSemanticEvalMono sourceNext.factory := by
              rw [hfacNext]
              exact hmono
            obtain ⟨loopSourceEnv, sourceLoopTrace, sourceNilTrace, hloopTrace,
                hsourceLoop, hsourceNil, hlenList⟩ := stmtsT_cons_terminalE hloopList
            obtain ⟨hnilTrace, hnilCfg⟩ := stmts_nil_runE (Imperative.EvalCmdE P)
              (reflTransTraceT_to_prop hsourceNil)
            subst sourceNilTrace
            rcases hnilCfg with hbad | hfinal
            · simp at hbad
            · injection hfinal with hfinalEnv
              subst loopSourceEnv
              obtain ⟨targetFinal, targetLoopTrace, htargetLoop, hrelFinal,
                  htraceLoop⟩ :=
                ih sourceNext targetInner final sourceLoopTrace hrelNext hmonoNext
                  hsourceLoop (by simp only [ReflTransTraceT.len] at hlen; omega)
              have henter := cfgLoopStep cfg entry bodyEntry continuation condition hlookup
                source target hrel hmono true (by simpa using htrue)
              have hiteration : StepCFGStarE P (Imperative.EvalCmdE P)
                  (.atBlock cfg entry target) targetBodyTrace (.atBlock cfg entry targetInner) := by
                simpa using cfgTraceTrans henter htargetBody
              refine ⟨targetFinal, targetBodyTrace ++ targetLoopTrace,
                cfgTraceTrans hiteration htargetLoop, hrelFinal, ?_⟩
              simpa [htrace, hloopTrace] using TraceExtendsEnv.append htraceBody htraceLoop
          · simp at hnone
          · simp at hbad

private theorem loopTerminal {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (entry bodyEntry continuation : String) (condition : P.Expr)
    (body : List (Stmt P (Cmd P))) (metadata : MetaData P)
    (keep : List P.Ident)
    (exitTarget : String → Env P → CFGConfig String (Cmd P) P)
    (hlookup : cfg.blocks.lookup entry = some
      ({ cmds := [], transfer := .condGoto condition bodyEntry continuation .empty } :
        DetBlock String (Cmd P) P))
    (bodySim : ∀ source target,
      EnvRel keep source target →
      TraceSim (EnvRel keep)
        (fun env => .atBlock cfg entry env) exitTarget
        (.stmts body source) (.atBlock cfg bodyEntry target))
    {source target final : Env P} {sourceTrace : Trace P}
    (hrel : EnvRel keep source target)
    (hmono : WellFormedSemanticEvalMono source.factory)
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmt (.loop (.det condition) none [] body metadata) source)
      sourceTrace (.terminal final)) :
    ∃ targetFinal targetTrace,
      StepCFGStarE P (Imperative.EvalCmdE P)
        (.atBlock cfg entry target) targetTrace (.atBlock cfg continuation targetFinal) ∧
      EnvRel keep final targetFinal ∧
      TraceExtendsEnv (fun _ : P.Ident => True) sourceTrace targetTrace :=
  loopTerminalFuel cfg entry bodyEntry continuation condition body metadata keep exitTarget
    hlookup bodySim (reflTransTrace_to_T hrun).len source target final sourceTrace
    hrel hmono (reflTransTrace_to_T hrun) (Nat.le_refl _)

end S2UTrace
end StructuredToUnstructuredCorrect

