@[expose] def Stmt.cfgLive {P : PureExpr} {C : Type} : Stmt P C → Stmt P C
  | .cmd c => .cmd c
  | .block l body md => .block l (Block.cfgLive body) md
  | .ite g thenBranch elseBranch md =>
      .ite g (Block.cfgLive thenBranch) (Block.cfgLive elseBranch) md
  | .loop g measure invariants body md =>
      .loop g measure invariants (Block.cfgLive body) md
  | .exit l md => .exit l md
  | .typeDecl tc md => .typeDecl tc md

@[expose] def Block.cfgLive {P : PureExpr} {C : Type} : List (Stmt P C) → List (Stmt P C)
  | [] => []
  | (.exit l md) :: _ => [.exit l md]
  | s :: rest => Stmt.cfgLive s :: Block.cfgLive rest
end

theorem Block.cfgLive_defUseWellFormed {P : PureExpr} {C : Type}
    [HasFvars P] [HasVarsImp P C] [HasOps P] [HasOpsImp P C]
    [DecidableEq P.Ident]
    (defined declared : P.Ident → Bool) (ss : List (Stmt P C))
    (h : Block.defUseWellFormed defined declared ss = true) :
    Block.defUseWellFormed defined declared (Block.cfgLive ss) = true := by
  match ss with
  | [] => exact h
  | s :: rest =>
      match s with
      | .exit l md => simp [Block.cfgLive, Block.defUseWellFormed, Stmt.defUseWellFormed]
      | .cmd c =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.defUseWellFormed, Stmt.definedVars,
            Bool.and_eq_true] at h ⊢
          exact ⟨h.1, Block.cfgLive_defUseWellFormed
            (fun n => defined n || decide (n ∈ HasVarsImp.definedVars (P := P) c true))
            declared rest h.2⟩
      | .typeDecl tc md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.defUseWellFormed, Stmt.definedVars,
            Bool.and_eq_true] at h ⊢
          have hrest : Block.defUseWellFormed defined declared rest = true := by
            simpa using h.2
          exact ⟨h.1, (by simpa using Block.cfgLive_defUseWellFormed defined declared rest hrest)⟩
      | .block l body md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.defUseWellFormed, Stmt.definedVars,
            Stmt.defUseWellFormed, Bool.and_eq_true] at h ⊢
          have hrest : Block.defUseWellFormed defined declared rest = true := by
            simpa using h.2
          exact ⟨Block.cfgLive_defUseWellFormed defined declared body h.1,
            (by simpa using Block.cfgLive_defUseWellFormed defined declared rest hrest)⟩
      | .ite g thenBranch elseBranch md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.defUseWellFormed, Stmt.definedVars,
            Stmt.defUseWellFormed, Bool.and_eq_true] at h ⊢
          have hrest : Block.defUseWellFormed defined declared rest = true := by
            simpa using h.2
          exact ⟨⟨⟨h.1.1.1,
            Block.cfgLive_defUseWellFormed defined declared thenBranch h.1.1.2⟩,
            Block.cfgLive_defUseWellFormed defined declared elseBranch h.1.2⟩,
            (by simpa using Block.cfgLive_defUseWellFormed defined declared rest hrest)⟩
      | .loop g measure invariants body _ =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.defUseWellFormed, Stmt.definedVars,
            Stmt.defUseWellFormed, Bool.and_eq_true] at h ⊢
          have hrest : Block.defUseWellFormed defined declared rest = true := by
            simpa using h.2
          exact ⟨⟨h.1.1, Block.cfgLive_defUseWellFormed defined declared body h.1.2⟩,
            (by simpa using Block.cfgLive_defUseWellFormed defined declared rest hrest)⟩
  termination_by sizeOf ss
  decreasing_by all_goals (simp_wf; try omega)

theorem Block.mem_initVars_of_cfgLive {P : PureExpr} {C : Type} [HasVarsImp P C]
    (ss : List (Stmt P C)) (n : P.Ident)
    (h : n ∈ Block.initVars (Block.cfgLive ss)) : n ∈ Block.initVars ss := by
  match ss with
  | [] => simp [Block.cfgLive, Block.initVars] at h
  | s :: rest =>
      match s with
      | .exit l md => simp [Block.cfgLive, Block.initVars] at h
      | .cmd c =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initVars, Block.definedVars,
            Stmt.definedVars, List.mem_append] at h ⊢
          exact h.elim Or.inl (fun hr => Or.inr (Block.mem_initVars_of_cfgLive rest n hr))
      | .typeDecl tc md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initVars, Block.definedVars,
            Stmt.definedVars, List.mem_append, List.not_mem_nil, false_or] at h ⊢
          exact Block.mem_initVars_of_cfgLive rest n h
      | .block l body md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initVars, Block.definedVars,
            Stmt.definedVars, Bool.false_eq_true, ite_false, List.mem_append] at h ⊢
          exact h.elim
            (fun hb => Or.inl (Block.mem_initVars_of_cfgLive body n hb))
            (fun hr => Or.inr (Block.mem_initVars_of_cfgLive rest n hr))
      | .ite g thenBranch elseBranch md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initVars, Block.definedVars,
            Stmt.definedVars, Bool.false_eq_true, ite_false, List.mem_append] at h ⊢
          rcases h with (ht | he) | hr
          · exact Or.inl (Or.inl (Block.mem_initVars_of_cfgLive thenBranch n ht))
          · exact Or.inl (Or.inr (Block.mem_initVars_of_cfgLive elseBranch n he))
          · exact Or.inr (Block.mem_initVars_of_cfgLive rest n hr)
      | .loop g measure invariants body _ =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initVars, Block.definedVars,
            Stmt.definedVars, Bool.false_eq_true, ite_false, List.mem_append] at h ⊢
          exact h.elim
            (fun hb => Or.inl (Block.mem_initVars_of_cfgLive body n hb))
            (fun hr => Or.inr (Block.mem_initVars_of_cfgLive rest n hr))
  termination_by sizeOf ss
  decreasing_by all_goals (simp_wf; try omega)

theorem Block.mem_initTypes_of_cfgLive {P : PureExpr} {C : Type} [HasInitTypesImp P C]
    (ss : List (Stmt P C)) (ty : P.Ty)
    (h : ty ∈ Block.initTypes (Block.cfgLive ss)) : ty ∈ Block.initTypes ss := by
  match ss with
  | [] => simp [Block.cfgLive, Block.initTypes] at h
  | s :: rest =>
      match s with
      | .exit l md => simp [Block.cfgLive, Block.initTypes, Stmt.initTypes] at h
      | .cmd c =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initTypes, Stmt.initTypes,
            List.mem_append] at h ⊢
          exact h.elim Or.inl (fun hr => Or.inr (Block.mem_initTypes_of_cfgLive rest ty hr))
      | .typeDecl tc md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initTypes, Stmt.initTypes,
            List.mem_append, List.not_mem_nil, false_or] at h ⊢
          exact Block.mem_initTypes_of_cfgLive rest ty h
      | .block l body md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initTypes, Stmt.initTypes,
            List.mem_append] at h ⊢
          exact h.elim
            (fun hb => Or.inl (Block.mem_initTypes_of_cfgLive body ty hb))
            (fun hr => Or.inr (Block.mem_initTypes_of_cfgLive rest ty hr))
      | .ite g thenBranch elseBranch md =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initTypes, Stmt.initTypes,
            List.mem_append] at h ⊢
          rcases h with (ht | he) | hr
          · exact Or.inl (Or.inl (Block.mem_initTypes_of_cfgLive thenBranch ty ht))
          · exact Or.inl (Or.inr (Block.mem_initTypes_of_cfgLive elseBranch ty he))
          · exact Or.inr (Block.mem_initTypes_of_cfgLive rest ty hr)
      | .loop g measure invariants body _ =>
          simp only [Block.cfgLive, Stmt.cfgLive, Block.initTypes, Stmt.initTypes,
            List.mem_append] at h ⊢
          exact h.elim
            (fun hb => Or.inl (Block.mem_initTypes_of_cfgLive body ty hb))
            (fun hr => Or.inr (Block.mem_initTypes_of_cfgLive rest ty hr))
  termination_by sizeOf ss
  decreasing_by all_goals (simp_wf; try omega)
