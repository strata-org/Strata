private theorem traceIteBranchShape {P : PureExpr} [HasFvars P]
    {condition : P.Expr} {thenBranch elseBranch : List (Stmt P (Cmd P))}
    {metadata : MetaData P}
    (hsimple : Stmt.noNondetGuards
      (.ite (.det condition) thenBranch elseBranch metadata) = true)
    (hlbni : Stmt.loopBodyNoInits
      (.ite (.det condition) thenBranch elseBranch metadata) = true)
    (hlhni : Stmt.loopHasNoInvariants
      (.ite (.det condition) thenBranch elseBranch metadata) = true)
    (hnml : Stmt.noMeasureLoops
      (.ite (.det condition) thenBranch elseBranch metadata) = true) :
    Block.noNondetGuards thenBranch = true ∧
    Block.noNondetGuards elseBranch = true ∧
    Block.loopBodyNoInits thenBranch = true ∧
    Block.loopBodyNoInits elseBranch = true ∧
    Block.loopHasNoInvariants thenBranch = true ∧
    Block.loopHasNoInvariants elseBranch = true ∧
    Block.noMeasureLoops thenBranch = true ∧
    Block.noMeasureLoops elseBranch = true :=
  ⟨Stmt.noNondetGuards_branch_then hsimple, Stmt.noNondetGuards_branch_else hsimple,
    Stmt.loopBodyNoInits_branch_then hlbni, Stmt.loopBodyNoInits_branch_else hlbni,
    Stmt.loopHasNoInvariants_branch_then hlhni, Stmt.loopHasNoInvariants_branch_else hlhni,
    Stmt.noMeasureLoops_branch_then hnml, Stmt.noMeasureLoops_branch_else hnml⟩

private theorem stmtsTraceIteDet {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (condition : P.Expr) (thenBranch elseBranch : List (Stmt P (Cmd P)))
    (metadata : MetaData P) (rest : List (Stmt P (Cmd P)))
    (continuation : String)
    (sim : ∀ next statements,
      sizeOf statements < sizeOf
        (.ite (.det condition) thenBranch elseBranch metadata :: rest :
          List (Stmt P (Cmd P))) →
      StmtsTraceSpec (P := P) next statements) :
    StmtsTraceSpec (P := P) continuation
      (.ite (.det condition) thenBranch elseBranch metadata :: rest) := by
  intro exitConts accum gen gen' entry blocks hgen hsimple hunique hlbni hlhni hnml
    hcovered keep hnodup source target hrel cfg hblocks hcfgNodup
  obtain ⟨next, current, thenEntry, elseEntry, restBlocks, thenBlocks, elseBlocks,
      accumBlocks, genRest, genCurrent, genThen, genElse, genFlush, accumEntry,
      hrestEq, hcurrent, hthenEq, helseEq, hflushEq, hgenEq, hentryEq, hblocksEq⟩ :=
    iteDecompose continuation gen gen' entry blocks accum condition thenBranch elseBranch
      metadata exitConts rest hgen
  have hcfgAccum : ∀ block ∈ accumBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rw [← hblocksEq]
    simp [hblock]
  have hcfgThen : ∀ block ∈ thenBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rw [← hblocksEq]
    simp [hblock]
  have hcfgElse : ∀ block ∈ elseBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rw [← hblocksEq]
    simp [hblock]
  have hcfgRest : ∀ block ∈ restBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rw [← hblocksEq]
    simp [hblock]
  subst entry
  subst gen'
  have hsimpleHead := (Block.noNondetGuards_cons_iff.mp hsimple).1
  have hsimpleRest := (Block.noNondetGuards_cons_iff.mp hsimple).2
  have hlbniHead := (Block.loopBodyNoInits_cons_iff.mp hlbni).1
  have hlbniRest := (Block.loopBodyNoInits_cons_iff.mp hlbni).2
  have hlhniHead := (Block.loopHasNoInvariants_cons_iff.mp hlhni).1
  have hlhniRest := (Block.loopHasNoInvariants_cons_iff.mp hlhni).2
  have hnmlHead := (Block.noMeasureLoops_cons_iff.mp hnml).1
  have hnmlRest := (Block.noMeasureLoops_cons_iff.mp hnml).2
  obtain ⟨hsimpleThen, hsimpleElse, hlbniThen, hlbniElse,
      hlhniThen, hlhniElse, hnmlThen, hnmlElse⟩ :=
    traceIteBranchShape hsimpleHead hlbniHead hlhniHead hnmlHead
  have huniqueThen := Block.uniqueInits.ite_then hunique
  have huniqueElse := Block.uniqueInits.ite_else hunique
  have huniqueRest := Block.uniqueInits.tail hunique
  have hcoveredHead := hcovered.1
  have hcoveredThen : Block.exitsCoveredByBlocks (coveringLabels exitConts) thenBranch := by
    simpa [Stmt.exitsCoveredByBlocks] using hcoveredHead.1
  have hcoveredElse : Block.exitsCoveredByBlocks (coveringLabels exitConts) elseBranch := by
    simpa [Stmt.exitsCoveredByBlocks] using hcoveredHead.2
  have hcoveredRest : Block.exitsCoveredByBlocks (coveringLabels exitConts) rest := hcovered.2
  have hinitEq : Block.initVars
      (.ite (.det condition) thenBranch elseBranch metadata :: rest) =
      (Block.initVars thenBranch ++ Block.initVars elseBranch) ++ Block.initVars rest := by
    rw [Block.initVars]
    simp
  let tailKeep := Block.initVars
    (.ite (.det condition) thenBranch elseBranch metadata :: rest) ++ keep
  let restKeep := Block.initVars rest ++ keep
  have hcombinedNodup : (Cmds.definedVars accum.reverse ++ tailKeep).Nodup := by
    simpa [pendingInits, tailKeep, List.append_assoc] using hnodup
  have htailNodup : tailKeep.Nodup := (List.nodup_append.mp hcombinedNodup).2.1
  have htailEq : tailKeep = Block.initVars thenBranch ++
      (Block.initVars elseBranch ++ restKeep) := by
    simp [tailKeep, restKeep, hinitEq, List.append_assoc]
  have hthenSub : (Block.initVars thenBranch ++ restKeep).Sublist tailKeep := by
    rw [htailEq]
    exact List.Sublist.append (List.Sublist.refl _)
      (List.sublist_append_right (Block.initVars elseBranch) restKeep)
  have helseSub : (Block.initVars elseBranch ++ restKeep).Sublist tailKeep := by
    rw [htailEq]
    exact List.sublist_append_right (Block.initVars thenBranch)
      (Block.initVars elseBranch ++ restKeep)
  have hrestSub : restKeep.Sublist tailKeep :=
    (List.sublist_append_right (Block.initVars elseBranch) restKeep).trans helseSub
  have hthenNodup : (pendingInits ([] : List (Cmd P)) thenBranch ++ restKeep).Nodup := by
    simpa [pendingInits, Cmds.definedVars] using hthenSub.nodup htailNodup
  have helseNodup : (pendingInits ([] : List (Cmd P)) elseBranch ++ restKeep).Nodup := by
    simpa [pendingInits, Cmds.definedVars] using helseSub.nodup htailNodup
  have hrestNodup : (pendingInits ([] : List (Cmd P)) rest ++ keep).Nodup := by
    simpa [pendingInits, Cmds.definedVars, restKeep] using hrestSub.nodup htailNodup
  have hflush : TraceSim (EnvRel tailKeep)
      (fun env => .inBlock cfg accumEntry []
        (.condGoto condition thenEntry elseEntry .empty) env)
      (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
      (.stmts (accum.reverse.map (@Stmt.cmd P (Cmd P))) source)
      (.atBlock cfg accumEntry target) :=
    flushCondSim cfg iteFlushPrefix current accum condition thenEntry elseEntry
      genElse genFlush accumEntry accumBlocks hflushEq hcfgAccum hcfgNodup tailKeep
      source target (by simpa [tailKeep, pendingInits, List.append_assoc] using hrel)
      hcombinedNodup hrel.mono
      (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
  have buildTail : ∀ sourceMiddle targetMiddle,
      EnvRel tailKeep sourceMiddle targetMiddle →
      TraceSim (EnvRel keep)
        (fun env => .atBlock cfg continuation env)
        (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
        (.stmts (.ite (.det condition) thenBranch elseBranch metadata :: rest) sourceMiddle)
        (.inBlock cfg accumEntry []
          (.condGoto condition thenEntry elseEntry .empty) targetMiddle) := by
    intro sourceMiddle targetMiddle hmiddle
    have hthenRel : EnvRel (pendingInits ([] : List (Cmd P)) thenBranch ++ restKeep)
        sourceMiddle targetMiddle := by
      have h := hmiddle.weaken hthenSub.subset
      simpa [pendingInits, Cmds.definedVars] using h
    have helseRel : EnvRel (pendingInits ([] : List (Cmd P)) elseBranch ++ restKeep)
        sourceMiddle targetMiddle := by
      have h := hmiddle.weaken helseSub.subset
      simpa [pendingInits, Cmds.definedVars] using h
    have thenRaw := sim next thenBranch (by simp_wf; omega) exitConts []
      genCurrent genThen thenEntry thenBlocks hthenEq hsimpleThen huniqueThen
      hlbniThen hlhniThen hnmlThen hcoveredThen restKeep hthenNodup
      sourceMiddle targetMiddle hthenRel cfg hcfgThen hcfgNodup
    have elseRaw := sim next elseBranch (by simp_wf; omega) exitConts []
      genThen genElse elseEntry elseBlocks helseEq hsimpleElse huniqueElse
      hlbniElse hlhniElse hnmlElse hcoveredElse restKeep helseNodup
      sourceMiddle targetMiddle helseRel cfg hcfgElse hcfgNodup
    have thenTrace := TraceSim.retargetCoveredExits cfg next continuation exitConts
      thenBranch sourceMiddle hcoveredThen thenRaw
    have elseTrace := TraceSim.retargetCoveredExits cfg next continuation exitConts
      elseBranch sourceMiddle hcoveredElse elseRaw
    have conditionRel : EnvRel [] sourceMiddle targetMiddle :=
      hmiddle.weaken (fun _ h => by simp at h)
    have headTrace := deterministicIteSim cfg accumEntry thenEntry elseEntry condition
      thenBranch elseBranch metadata sourceMiddle targetMiddle conditionRel hmiddle.mono
      thenTrace elseTrace
      (fun _ _ h => EnvRel.projectLeft h)
      (fun _ _ h => EnvRel.projectLeft h)
    have headTraceList := TraceSim.sourceSingleton headTrace
    exact TraceSim.append headTraceList
      (fun _ _ h => h.weaken (fun x hx => List.mem_append_right (Block.initVars rest) hx))
      (fun sourceAfter targetAfter hafter =>
        sim continuation rest (by simp_wf; omega) exitConts [] gen genRest next restBlocks
          hrestEq hsimpleRest huniqueRest hlbniRest hlhniRest hnmlRest hcoveredRest
          keep hrestNodup sourceAfter targetAfter
          (by simpa [pendingInits, Cmds.definedVars, restKeep] using hafter)
          cfg hcfgRest hcfgNodup)
  have hfull := TraceSim.append hflush
    (fun _ _ h => h.weaken (fun x hx =>
      List.mem_append_right
        (Block.initVars (.ite (.det condition) thenBranch elseBranch metadata :: rest)) hx))
    buildTail
  simpa [sourceCode] using hfull

end S2UTrace
end StructuredToUnstructuredCorrect

