private def sourceCode {P : PureExpr} (accum : List (Cmd P))
    (statements : List (Stmt P (Cmd P))) : List (Stmt P (Cmd P)) :=
  accum.reverse.map (@Stmt.cmd P (Cmd P)) ++ statements

private def pendingInits {P : PureExpr} [HasFvars P]
    (accum : List (Cmd P)) (statements : List (Stmt P (Cmd P))) : List P.Ident :=
  Cmds.definedVars accum.reverse ++ Block.initVars statements

private abbrev StmtsTraceSpec {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (continuation : String) (statements : List (Stmt P (Cmd P))) : Prop :=
  ∀ (exitConts : List (Option String × String))
    (accum : List (Cmd P)) (gen gen' : StringGenState)
    (entry : String) (blocks : DetBlocks String (Cmd P) P),
    stmtsToBlocks continuation statements exitConts accum gen = ((entry, blocks), gen') →
    Block.noNondetGuards statements = true →
    Block.uniqueInits statements →
    Block.loopBodyNoInits statements = true →
    Block.loopHasNoInvariants statements = true →
    Block.noMeasureLoops statements = true →
    Block.exitsCoveredByBlocks (coveringLabels exitConts) statements →
    ∀ (keep : List P.Ident),
      (pendingInits accum statements ++ keep).Nodup →
      ∀ (source target : Env P),
        EnvRel (pendingInits accum statements ++ keep) source target →
        ∀ (cfg : CFG String (DetBlock String (Cmd P) P)),
          (∀ block ∈ blocks, block ∈ cfg.blocks) →
          (cfg.blocks.map Prod.fst).Nodup →
          TraceSim (EnvRel keep)
            (fun env => .atBlock cfg continuation env)
            (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
            (.stmts (sourceCode accum statements) source)
            (.atBlock cfg entry target)

private theorem stmtsTraceNil {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (continuation : String) :
    StmtsTraceSpec (P := P) continuation [] := by
  intro exitConts accum gen gen' entry blocks hgen _ _ _ _ _ _ keep hnodup
    source target hrel cfg hblocks hcfgNodup
  unfold stmtsToBlocks at hgen
  simpa [sourceCode, pendingInits, Block.initVars, List.append_assoc] using
    (flushGotoSim cfg listTailPrefix continuation accum gen gen' entry blocks hgen
      hblocks hcfgNodup keep source target (by simpa [pendingInits] using hrel)
      (by simpa [pendingInits] using hnodup) hrel.mono hrel.val
      (fun label env => .atBlock cfg (exitDest continuation exitConts label) env))

private theorem stmtsTraceCmd {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (command : Cmd P) (rest : List (Stmt P (Cmd P)))
    (continuation : String)
    (sim : StmtsTraceSpec (P := P) continuation rest) :
    StmtsTraceSpec (P := P) continuation (.cmd command :: rest) := by
  intro exitConts accum gen gen' entry blocks hgen hsimple hunique hlbni hlhni hnml
    hcovered keep hnodup source target hrel cfg hblocks hcfgNodup
  unfold stmtsToBlocks at hgen
  have hsim := sim exitConts (command :: accum) gen gen' entry blocks hgen
    (Block.noNondetGuards_cons_iff.mp hsimple).2
    (Block.uniqueInits.tail hunique)
    (Block.loopBodyNoInits_cons_iff.mp hlbni).2
    (Block.loopHasNoInvariants_cons_iff.mp hlhni).2
    (Block.noMeasureLoops_cons_iff.mp hnml).2
    hcovered.2
    keep (by
      simpa [pendingInits, List.reverse_cons, Cmds.definedVars_append,
        Cmds.definedVars, Cmd.definedVars, HasVarsImp.definedVars,
        Block.initVars, List.append_assoc] using hnodup)
    source target (by
      simpa [pendingInits, List.reverse_cons, Cmds.definedVars_append,
        Cmds.definedVars, Cmd.definedVars, HasVarsImp.definedVars,
        Block.initVars, List.append_assoc] using hrel)
    cfg hblocks hcfgNodup
  simpa [sourceCode, List.reverse_cons, List.append_assoc] using hsim

private theorem stmtsTraceTypeDecl {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (constructor : TypeConstructor) (metadata : MetaData P)
    (rest : List (Stmt P (Cmd P))) (continuation : String)
    (sim : StmtsTraceSpec (P := P) continuation rest) :
    StmtsTraceSpec (P := P) continuation (.typeDecl constructor metadata :: rest) := by
  intro exitConts accum gen gen' entry blocks hgen hsimple hunique hlbni hlhni hnml
    hcovered keep hnodup source target hrel cfg hblocks hcfgNodup
  unfold stmtsToBlocks at hgen
  have hsim := sim exitConts accum gen gen' entry blocks hgen
    (Block.noNondetGuards_cons_iff.mp hsimple).2
    (Block.uniqueInits.tail hunique)
    (Block.loopBodyNoInits_cons_iff.mp hlbni).2
    (Block.loopHasNoInvariants_cons_iff.mp hlhni).2
    (Block.noMeasureLoops_cons_iff.mp hnml).2
    hcovered.2
    keep (by simpa [pendingInits, Block.initVars] using hnodup)
    source target (by simpa [pendingInits, Block.initVars] using hrel)
    cfg hblocks hcfgNodup
  simpa [sourceCode] using
    (TraceSim.eraseTypeDecl accum.reverse constructor metadata rest source hsim)

private theorem stmtsTraceExit {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (label : String) (metadata : MetaData P) (rest : List (Stmt P (Cmd P)))
    (continuation : String) :
    StmtsTraceSpec (P := P) continuation (.exit label metadata :: rest) := by
  intro exitConts accum gen gen' entry blocks hgen _ _ _ _ _ hcovered keep hnodup
    source target hrel cfg hblocks hcfgNodup
  unfold stmtsToBlocks at hgen
  cases hlookup : exitConts.lookup (some label) with
  | none =>
      exfalso
      exact not_mem_coveringLabels_of_lookup_none exitConts label hlookup hcovered.1
  | some destination =>
      rw [hlookup] at hgen
      let tailKeep := Block.initVars (.exit label metadata :: rest) ++ keep
      have hleft : TraceSim (EnvRel tailKeep)
          (fun env => .atBlock cfg destination env)
          (fun exitLabel env => .atBlock cfg (exitDest continuation exitConts exitLabel) env)
          (.stmts (accum.reverse.map (@Stmt.cmd P (Cmd P))) source)
          (.atBlock cfg entry target) :=
        flushGotoSim cfg (blockExitPrefix label) destination accum gen gen' entry blocks
          hgen hblocks hcfgNodup tailKeep source target
          (by simpa [tailKeep, pendingInits, List.append_assoc] using hrel)
          (by simpa [tailKeep, pendingInits, List.append_assoc] using hnodup)
          hrel.mono hrel.val
          (fun exitLabel env => .atBlock cfg (exitDest continuation exitConts exitLabel) env)
      have hfull := TraceSim.append hleft
        (fun _ _ h => h.weaken (fun x hx => by
          exact List.mem_append_right (Block.initVars (.exit label metadata :: rest)) hx))
        (fun sourceMiddle targetMiddle hmiddle =>
          exitListSim cfg destination label metadata rest keep sourceMiddle targetMiddle
            (hmiddle.weaken (fun x hx =>
              List.mem_append_right (Block.initVars (.exit label metadata :: rest)) hx))
            (fun env => .atBlock cfg continuation env)
            (fun exitLabel env => .atBlock cfg (exitDest continuation exitConts exitLabel) env)
            (fun env => by simp [exitDest, hlookup]))
      simpa [sourceCode] using hfull

end S2UTrace
end StructuredToUnstructuredCorrect

namespace StructuredToUnstructuredCorrect
open Imperative Specification
namespace S2UTrace

private theorem stepEPreservesExitCoverage {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {source target : Config P (Cmd P)} {trace : Trace P}
    (hstep : StepStmtE P (Imperative.EvalCmdE P) source trace target) :
    ∀ labels, source.exitsCoveredByBlocks labels → target.exitsCoveredByBlocks labels :=
  stepStmtE_preserves_exitsCoveredByBlocks (Imperative.EvalCmdE P) hstep

private theorem exitingLabelMem {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {labels : List String} {statements : List (Stmt P (Cmd P))}
    {initial final : Env P} {trace : Trace P} {label : String}
    (hcovered : Block.exitsCoveredByBlocks labels statements)
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts statements initial) trace (.exiting label final)) :
    label ∈ labels := by
  have hstart : Config.exitsCoveredByBlocks labels
      (.stmts statements initial : Config P (Cmd P)) := hcovered
  suffices hpreserve : ∀ source sourceTrace target,
      StepStmtStarE P (Imperative.EvalCmdE P) source sourceTrace target →
      Config.exitsCoveredByBlocks labels source →
      Config.exitsCoveredByBlocks labels target by
    exact hpreserve _ _ _ hrun hstart
  intro source sourceTrace target hrun'
  induction hrun' with
  | refl => exact id
  | step _ _ _ _ _ hstep _ ih =>
      intro hsource
      exact ih (stepEPreservesExitCoverage hstep labels hsource)

private theorem coveringLabelsLookupSome
    (exitConts : List (Option String × String)) (label : String)
    (hmem : label ∈ coveringLabels exitConts) :
    (exitConts.lookup (some label)).isSome = true := by
  rw [List.lookup_isSome_iff]
  induction exitConts with
  | nil => simp [coveringLabels] at hmem
  | cons head rest ih =>
      obtain ⟨key, destination⟩ := head
      cases key with
      | none =>
          have hrest : label ∈ coveringLabels rest := by
            simpa [coveringLabels] using hmem
          obtain ⟨pair, hpair, heq⟩ := ih hrest
          exact ⟨pair, List.mem_cons_of_mem _ hpair, heq⟩
      | some headLabel =>
          have hcases : label = headLabel ∨ label ∈ coveringLabels rest := by
            simpa [coveringLabels] using hmem
          rcases hcases with hlabel | hrest
          · subst headLabel
            exact ⟨(some label, destination), List.mem_cons_self, by simp⟩
          · obtain ⟨pair, hpair, heq⟩ := ih hrest
            exact ⟨pair, List.mem_cons_of_mem _ hpair, heq⟩

private theorem exitDestFallbackIrrelevant
    (first second : String) (exitConts : List (Option String × String)) (label : String)
    (hsome : (exitConts.lookup (some label)).isSome = true) :
    exitDest first exitConts label = exitDest second exitConts label := by
  cases hlookup : exitConts.lookup (some label) with
  | none => simp [hlookup] at hsome
  | some destination => simp [exitDest, hlookup]

private theorem TraceSim.retargetCoveredExits {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {Rel : Env P → Env P → Prop}
    {terminalTarget : Env P → CFGConfig String (Cmd P) P}
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (firstFallback secondFallback : String)
    (exitConts : List (Option String × String))
    (statements : List (Stmt P (Cmd P))) (source : Env P)
    {target : CFGConfig String (Cmd P) P}
    (hcovered : Block.exitsCoveredByBlocks (coveringLabels exitConts) statements)
    (h : TraceSim Rel terminalTarget
      (fun label env => .atBlock cfg (exitDest firstFallback exitConts label) env)
      (.stmts statements source) target) :
    TraceSim Rel terminalTarget
      (fun label env => .atBlock cfg (exitDest secondFallback exitConts label) env)
      (.stmts statements source) target := by
  refine ⟨h.simulate, h.terminal, ?_⟩
  intro label sourceEnv sourceTrace hrun
  obtain ⟨targetEnv, targetTrace, htarget, hrel, htrace⟩ := h.exiting hrun
  have hsome := coveringLabelsLookupSome exitConts label
    (exitingLabelMem hcovered hrun)
  have heq := exitDestFallbackIrrelevant firstFallback secondFallback exitConts label hsome
  rw [heq] at htarget
  exact ⟨targetEnv, targetTrace, htarget, hrel, htrace⟩

private theorem TraceSim.sourceSingleton {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {Rel : Env P → Env P → Prop}
    {terminalTarget : Env P → CFGConfig String (Cmd P) P}
    {exitingTarget : String → Env P → CFGConfig String (Cmd P) P}
    {statement : Stmt P (Cmd P)} {source : Env P}
    {target : CFGConfig String (Cmd P) P}
    (h : TraceSim Rel terminalTarget exitingTarget (.stmt statement source) target) :
    TraceSim Rel terminalTarget exitingTarget (.stmts [statement] source) target := by
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with
      ⟨hfinal, htrace⟩ | hseq
    · subst sourceFinal
      subst sourceTrace
      exact ⟨target, [], .refl _, .nil⟩
    · rcases seq_run_decomposeE (Imperative.EvalCmdE P) hseq with
        ⟨inner, hfinal, hinner⟩ |
        ⟨middle, headTrace, tailTrace, htrace, hinner, htail⟩ |
        ⟨label, exitEnv, hfinal, hinner⟩
      · exact h.simulate hinner
      · obtain ⟨targetEnv, targetTrace, htarget, hrel, htraceTarget⟩ := h.terminal hinner
        exact ⟨terminalTarget targetEnv, targetTrace, htarget, by
          have hnil := stmts_nil_runE (Imperative.EvalCmdE P) htail
          obtain ⟨htailTrace, _⟩ := hnil
          subst tailTrace
          simpa [htrace] using htraceTarget⟩
      · obtain ⟨targetEnv, targetTrace, htarget, hrel, htraceTarget⟩ := h.exiting hinner
        exact ⟨exitingTarget label targetEnv, targetTrace, htarget, htraceTarget⟩
  · intro sourceEnv sourceTrace hrun
    rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with hstart | hseq
    · simp at hstart
    · obtain ⟨middle, headTrace, tailTrace, htrace, hinner, htail⟩ :=
        seq_reaches_terminalE (Imperative.EvalCmdE P) hseq
      obtain ⟨htailTrace, htailShape⟩ := stmts_nil_runE (Imperative.EvalCmdE P) htail
      subst tailTrace
      rcases htailShape with hbad | hfinal
      · simp at hbad
      · injection hfinal with henv
        subst middle
        obtain ⟨targetEnv, targetTrace, htarget, hrel, htraceTarget⟩ := h.terminal hinner
        exact ⟨targetEnv, targetTrace, htarget, hrel, by simpa [htrace] using htraceTarget⟩
  · intro label sourceEnv sourceTrace hrun
    rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with hstart | hseq
    · simp at hstart
    · rcases seq_reaches_exitingE (Imperative.EvalCmdE P) hseq with hinner | htail
      · exact h.exiting hinner
      · obtain ⟨middle, headTrace, tailTrace, htrace, hinner, hnil⟩ := htail
        obtain ⟨_, hnilShape⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hnil
        rcases hnilShape with hbad | hbad <;> simp at hbad

private theorem blockDecompose {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    (continuation : String) (gen gen' : StringGenState)
    (entry : String) (blocks : DetBlocks String (Cmd P) P)
    (accum : List (Cmd P)) (blockLabel : String)
    (body : List (Stmt P (Cmd P))) (metadata : MetaData P)
    (exitConts : List (Option String × String))
    (rest : List (Stmt P (Cmd P)))
    (hgen : stmtsToBlocks continuation (.block blockLabel body metadata :: rest)
      exitConts accum gen = ((entry, blocks), gen')) :
    ∃ (next : String) (restBlocks : DetBlocks String (Cmd P) P)
      (genRest : StringGenState) (bodyEntry : String)
      (bodyBlocks : DetBlocks String (Cmd P) P) (genBody : StringGenState)
      (accumEntry : String) (accumBlocks : DetBlocks String (Cmd P) P)
      (genFlush : StringGenState),
      stmtsToBlocks continuation rest exitConts [] gen = ((next, restBlocks), genRest) ∧
      stmtsToBlocks next body ((some blockLabel, next) :: exitConts) [] genRest =
        ((bodyEntry, bodyBlocks), genBody) ∧
      flushCmds blockFlushPrefix accum .none bodyEntry genBody =
        ((accumEntry, accumBlocks), genFlush) ∧
      genFlush = gen' ∧ accumEntry = entry ∧
      ((blockLabel = bodyEntry ∧ accumBlocks ++ bodyBlocks ++ restBlocks = blocks) ∨
       (blockLabel ≠ bodyEntry ∧ ∃ labelBlock : DetBlock String (Cmd P) P,
        accumBlocks ++ [(blockLabel, labelBlock)] ++ bodyBlocks ++ restBlocks = blocks)) := by
  let restStep := stmtsToBlocks continuation rest exitConts [] gen
  let next := restStep.1.1
  let restBlocks := restStep.1.2
  let genRest := restStep.2
  let bodyStep := stmtsToBlocks next body ((some blockLabel, next) :: exitConts) [] genRest
  let bodyEntry := bodyStep.1.1
  let bodyBlocks := bodyStep.1.2
  let genBody := bodyStep.2
  let flushStep := @flushCmds P (Cmd P) _ blockFlushPrefix accum .none bodyEntry genBody
  let accumEntry := flushStep.1.1
  let accumBlocks := flushStep.1.2
  let genFlush := flushStep.2
  let labelBlock : DetBlock String (Cmd P) P :=
    { cmds := [], transfer := .goto bodyEntry }
  let outputBlocks : DetBlocks String (Cmd P) P :=
    if blockLabel == bodyEntry then accumBlocks ++ bodyBlocks ++ restBlocks
    else accumBlocks ++ [(blockLabel, labelBlock)] ++ bodyBlocks ++ restBlocks
  have hrest : stmtsToBlocks continuation rest exitConts [] gen =
      ((next, restBlocks), genRest) := rfl
  have hbody : stmtsToBlocks next body ((some blockLabel, next) :: exitConts) [] genRest =
      ((bodyEntry, bodyBlocks), genBody) := rfl
  have hflush : flushCmds blockFlushPrefix accum .none bodyEntry genBody =
      ((accumEntry, accumBlocks), genFlush) := rfl
  have hred : stmtsToBlocks continuation (.block blockLabel body metadata :: rest)
      exitConts accum gen = ((accumEntry, outputBlocks), genFlush) := by
    unfold stmtsToBlocks
    simp only [bind, StateT.bind, hrest, hbody, hflush, pure]
    by_cases heq : blockLabel = bodyEntry <;>
      simp [outputBlocks, labelBlock, heq, pure, StateT.pure]
  have hall := hred.symm.trans hgen
  have hentry : accumEntry = entry := (Prod.mk.inj (Prod.mk.inj hall).1).1
  have hblocks : outputBlocks = blocks := (Prod.mk.inj (Prod.mk.inj hall).1).2
  have hgen' : genFlush = gen' := (Prod.mk.inj hall).2
  refine ⟨next, restBlocks, genRest, bodyEntry, bodyBlocks, genBody,
    accumEntry, accumBlocks, genFlush, hrest, hbody, hflush, hgen', hentry, ?_⟩
  by_cases heq : blockLabel = bodyEntry
  · exact .inl ⟨heq, by simpa [outputBlocks, heq] using hblocks⟩
  · exact .inr ⟨heq, labelBlock, by simpa [outputBlocks, labelBlock, heq] using hblocks⟩

private theorem stmtsTraceBlock {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (blockLabel : String) (body : List (Stmt P (Cmd P))) (metadata : MetaData P)
    (rest : List (Stmt P (Cmd P))) (continuation : String)
    (sim : ∀ next statements,
      sizeOf statements < sizeOf (.block blockLabel body metadata :: rest : List (Stmt P (Cmd P))) →
      StmtsTraceSpec (P := P) next statements) :
    StmtsTraceSpec (P := P) continuation (.block blockLabel body metadata :: rest) := by
  intro exitConts accum gen gen' entry blocks hgen hsimple hunique hlbni hlhni hnml
    hcovered keep hnodup source target hrel cfg hblocks hcfgNodup
  obtain ⟨next, restBlocks, genRest, bodyEntry, bodyBlocks, genBody,
      accumEntry, accumBlocks, genFlush, hrestEq, hbodyEq, hflushEq,
      hgenEq, hentryEq, hshape⟩ :=
    blockDecompose continuation gen gen' entry blocks accum blockLabel body metadata
      exitConts rest hgen
  have hcfgAccum : ∀ block ∈ accumBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rcases hshape with ⟨_, hblocksEq⟩ | ⟨_, _, hblocksEq⟩ <;>
      rw [← hblocksEq] <;> simp [hblock]
  have hcfgBody : ∀ block ∈ bodyBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rcases hshape with ⟨_, hblocksEq⟩ | ⟨_, _, hblocksEq⟩ <;>
      rw [← hblocksEq] <;> simp [hblock]
  have hcfgRest : ∀ block ∈ restBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rcases hshape with ⟨_, hblocksEq⟩ | ⟨_, _, hblocksEq⟩ <;>
      rw [← hblocksEq] <;> simp [hblock]
  subst entry
  subst gen'
  have hsimpleHead := (Block.noNondetGuards_cons_iff.mp hsimple).1
  have hsimpleBody : Block.noNondetGuards body = true := by
    simpa [Stmt.noNondetGuards] using hsimpleHead
  have hsimpleRest := (Block.noNondetGuards_cons_iff.mp hsimple).2
  have hlbniHead := (Block.loopBodyNoInits_cons_iff.mp hlbni).1
  have hlbniBody := Stmt.loopBodyNoInits_block_body hlbniHead
  have hlbniRest := (Block.loopBodyNoInits_cons_iff.mp hlbni).2
  have hlhniHead := (Block.loopHasNoInvariants_cons_iff.mp hlhni).1
  have hlhniBody := Stmt.loopHasNoInvariants_block_body hlhniHead
  have hlhniRest := (Block.loopHasNoInvariants_cons_iff.mp hlhni).2
  have hnmlHead := (Block.noMeasureLoops_cons_iff.mp hnml).1
  have hnmlBody := Stmt.noMeasureLoops_block_body hnmlHead
  have hnmlRest := (Block.noMeasureLoops_cons_iff.mp hnml).2
  have huniqueBody := Block.uniqueInits.block_body hunique
  have huniqueRest := Block.uniqueInits.tail hunique
  have hinitEq : Block.initVars (.block blockLabel body metadata :: rest) =
      Block.initVars body ++ Block.initVars rest := by
    rw [Block.initVars]
    simp
  have hcoveredBody : Block.exitsCoveredByBlocks
      (coveringLabels ((some blockLabel, next) :: exitConts)) body := by
    simpa [Stmt.exitsCoveredByBlocks, coveringLabels] using hcovered.1
  have hcoveredRest : Block.exitsCoveredByBlocks (coveringLabels exitConts) rest :=
    hcovered.2
  let tailKeep := Block.initVars (.block blockLabel body metadata :: rest) ++ keep
  let bodyKeep := Block.initVars rest ++ keep
  have hcombinedNodup : (Cmds.definedVars accum.reverse ++ tailKeep).Nodup := by
    simpa [pendingInits, tailKeep, List.append_assoc] using hnodup
  have htailNodup : tailKeep.Nodup := (List.nodup_append.mp hcombinedNodup).2.1
  have hbodyNodup : (pendingInits ([] : List (Cmd P)) body ++ bodyKeep).Nodup := by
    simpa [pendingInits, Cmds.definedVars, tailKeep, bodyKeep, hinitEq, List.append_assoc] using htailNodup
  have hrestNodup : (pendingInits ([] : List (Cmd P)) rest ++ keep).Nodup := by
    have htail : (Block.initVars body ++ (Block.initVars rest ++ keep)).Nodup := by
      simpa [tailKeep, hinitEq, List.append_assoc] using htailNodup
    simpa [pendingInits, Cmds.definedVars] using (List.nodup_append.mp htail).2.1
  have hflush : TraceSim (EnvRel tailKeep)
      (fun env => .atBlock cfg bodyEntry env)
      (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
      (.stmts (accum.reverse.map (@Stmt.cmd P (Cmd P))) source)
      (.atBlock cfg accumEntry target) :=
    flushGotoSim cfg blockFlushPrefix bodyEntry accum genBody genFlush accumEntry accumBlocks
      hflushEq hcfgAccum hcfgNodup tailKeep source target
      (by simpa [tailKeep, pendingInits, List.append_assoc] using hrel)
      hcombinedNodup hrel.mono hrel.val
      (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
  have buildTail : ∀ sourceMiddle targetMiddle,
      EnvRel tailKeep sourceMiddle targetMiddle →
      TraceSim (EnvRel keep)
        (fun env => .atBlock cfg continuation env)
        (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
        (.stmts (.block blockLabel body metadata :: rest) sourceMiddle)
        (.atBlock cfg bodyEntry targetMiddle) := by
    intro sourceMiddle targetMiddle hmiddle
    have hbodyRel : EnvRel (pendingInits ([] : List (Cmd P)) body ++ bodyKeep)
        sourceMiddle targetMiddle := by
      simpa [pendingInits, Cmds.definedVars, tailKeep, bodyKeep, hinitEq,
        List.append_assoc] using hmiddle
    have bodyTraceRaw := sim next body (by simp_wf; omega)
      ((some blockLabel, next) :: exitConts) [] genRest genBody bodyEntry bodyBlocks
      hbodyEq hsimpleBody huniqueBody hlbniBody hlhniBody hnmlBody hcoveredBody
      bodyKeep hbodyNodup
      sourceMiddle targetMiddle hbodyRel cfg hcfgBody hcfgNodup
    have bodyTrace := TraceSim.retargetCoveredExits cfg next continuation
      ((some blockLabel, next) :: exitConts) body sourceMiddle hcoveredBody bodyTraceRaw
    have headTrace : TraceSim (EnvRel bodyKeep)
        (fun env => .atBlock cfg next env)
        (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
        (.stmt (.block blockLabel body metadata) sourceMiddle)
        (.atBlock cfg bodyEntry targetMiddle) :=
      labeledBlockSim cfg continuation next blockLabel exitConts body metadata
        bodyKeep bodyKeep (fun _ h => h) sourceMiddle targetMiddle bodyEntry bodyTrace
    have headTraceList := TraceSim.sourceSingleton headTrace
    exact TraceSim.append headTraceList
      (fun _ _ h => h.weaken (fun x hx => List.mem_append_right (Block.initVars rest) hx))
      (fun sourceAfter targetAfter hafter =>
        sim continuation rest (by simp_wf; omega) exitConts [] gen genRest next restBlocks
          hrestEq hsimpleRest huniqueRest hlbniRest hlhniRest hnmlRest hcoveredRest
          keep hrestNodup
          sourceAfter targetAfter (by
            simpa [bodyKeep, pendingInits, Cmds.definedVars] using hafter)
          cfg hcfgRest hcfgNodup)
  have hfull := TraceSim.append hflush
    (fun _ _ h => h.weaken (fun x hx =>
      List.mem_append_right (Block.initVars (.block blockLabel body metadata :: rest)) hx))
    buildTail
  simpa [sourceCode] using hfull

end S2UTrace
end StructuredToUnstructuredCorrect

