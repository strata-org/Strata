      have h_inv_r_le := stmtsToBlocks_invariant_loop_arm_compose_step h_inv_rest h_inv_le_step
      have h_inv_r_ml := stmtsToBlocks_invariant_loop_arm_compose_step h_inv_r_le h_inv_ml_step
      have h_inv_ldec_only : @StmtsToBlocksInv P gen_ml gen_ldec [] [decBlock] := by
        apply StmtsToBlocksInv.cons_gen gen_ml gen_ml gen_ldec [] [] ldec _
          hwf_ml (StringGenState.GenStep.refl gen_ml) h_inv_ldec_step
          h_ldec_in_gen_ldec h_ldec_notin_gen_ml
        simp
      have h_inv_r_ldec := stmtsToBlocks_invariant_loop_arm_compose_flush h_inv_r_ml
        h_inv_ldec_only
      have h_inv_r_b := stmtsToBlocks_invariant_loop_arm_compose_body h_inv_r_ldec h_inv_body
        h_user_disj_bss_rest
      have h_inv_r_i := stmtsToBlocks_invariant_loop_arm_compose_step h_inv_r_b h_inv_inv_step
      have h_inv_r_n := stmtsToBlocks_invariant_loop_arm_compose_step h_inv_r_i h_inv_nondet_step
      have h_inv_chron := stmtsToBlocks_invariant_loop_arm_compose_flush h_inv_r_n h_inv_flush
      -- Prepend lentry block.
      have h_lentry_in_gen_le : lentry ∈ StringGenState.stringGens gen_le := by
        rw [show lentry = (StringGenState.gen loopEntryPrefix gen_r).1 from
              (by rw [h_lentry_def])]
        rw [show gen_le = (StringGenState.gen loopEntryPrefix gen_r).2 from
              (by rw [h_lentry_def])]
        rw [StringGenState.stringGens_gen]
        exact List.mem_cons.mpr (Or.inl rfl)
      have h_lentry_in_gen_f : lentry ∈ StringGenState.stringGens gen_f :=
        (((h_step_le_to_b.trans h_step_inv).trans h_step_nondet).trans h_step_flush).subset
          h_lentry_in_gen_le
      have h_lentry_notin_gen_r : lentry ∉ StringGenState.stringGens gen_r := by
        intro h_in
        have h_lentry_eq : lentry = (StringGenState.gen loopEntryPrefix gen_r).1 := by
          rw [h_lentry_def]
        have h_notin :=
          StringGenState.stringGens_gen_not_in loopEntryPrefix gen_r hwf_r
        rw [h_lentry_eq] at h_in
        exact h_notin h_in
      have h_lentry_notin_gen : lentry ∉ StringGenState.stringGens gen := by
        intro h_in; exact h_lentry_notin_gen_r (h_step_rest.subset h_in)
      have h_lentry_notin_blks :
          lentry ∉ List.map Prod.fst ((bsNext ++ [decBlock] ++ bbs) ++ accumBlocks) :=
        stmtsToBlocks_invariant_loop_arm_notin_blks_some
          (decBlock := decBlock) rfl h_inv_rest h_inv_body h_inv_flush h_inv_le_step
          h_lentry_in_gen_le h_lentry_notin_gen_r h_ldec_notin_gen_ml
          h_step_ml (h_step_ml.trans h_step_ldec)
          ((h_step_le_to_b.trans h_step_inv).trans h_step_nondet)
      have h_inv_with_lentry :
          @StmtsToBlocksInv P gen gen_f
            (Block.getBlockLabels rest ++ Block.getBlockLabels bss)
            ((lentry, lentryBlk) :: ((bsNext ++ [decBlock] ++ bbs) ++ accumBlocks)) :=
        StmtsToBlocksInv.cons_gen gen gen gen_f _ _ lentry lentryBlk hwf
          (StringGenState.GenStep.refl gen) h_inv_chron h_lentry_in_gen_f
          h_lentry_notin_gen h_lentry_notin_blks
      have h_perm :
          ((lentry, lentryBlk) :: ((bsNext ++ [decBlock] ++ bbs) ++ accumBlocks)).Perm
            (accumBlocks ++ [(lentry, lentryBlk)] ++ bbs ++ [decBlock] ++ bsNext) :=
        stmtsToBlocks_invariant_loop_arm_perm_some lentry lentryBlk decBlock bsNext bbs accumBlocks
      have h_inv_perm := StmtsToBlocksInv.perm gen gen_f _ _ _ h_inv_with_lentry h_perm
      rw [← h_blocks_eq, ← h_gen_eq]
      exact stmtsToBlocks_invariant_loop_arm_weaken h_inv_perm h_gen_eq h_disj
        (Block.getBlockLabels_loop_cons c m is bss md rest)
/-- The main invariant for `stmtsToBlocks`.
We require WF on `gen` and obtain WF on `gen'`, plus freshness/nodup of
the produced block labels.

The proof is by well-founded recursion on `sizeOf ss` (so that recursive
calls on sub-lists `tss`, `fss`, `bss`, `body` work). For each statement
constructor, we:
1. Decompose the monadic computation via `generalize` + `obtain`,
2. Apply the IH to recursive sub-calls and `flushCmds_invariant` to flushes,
3. Combine results via `StmtsToBlocksInv.trans`.

We require `userLabelsDisjoint`: user-provided block labels (from
`Stmt.block l ...`) must not collide with any generated label in the
final state. Without this, the `block` case can produce duplicate keys. -/
private theorem stmtsToBlocks_invariant
    {P : PureExpr} [HasBool P] [HasIdent P] [HasFvar P] [HasFvars P] [HasInt P] [HasIntOps P] [HasBoolOps P]
    (k : String) (ss : List (Stmt P (Cmd P)))
    (exitConts : List (Option String × String))
    (accum : List (Cmd P))
    (gen gen' : StringGenState)
    (entry : String) (blocks : DetBlocks String (Cmd P) P)
    (h_gen : stmtsToBlocks k ss exitConts accum gen = ((entry, blocks), gen'))
    (hwf : StringGenState.WF gen)
    (h_disj : Block.userLabelsDisjoint ss gen') :
    @StmtsToBlocksInv P gen gen' (Block.getBlockLabels ss) blocks := by
  match h_match : ss with
  | [] =>
    -- stmtsToBlocks reduces to flushCmds listTailPrefix accum .none k
    unfold stmtsToBlocks at h_gen
    -- Block.getBlockLabels [] = []
    show @StmtsToBlocksInv P gen gen' [] blocks
    exact flushCmds_invariant listTailPrefix accum .none k gen gen' entry blocks h_gen hwf
  | .cmd c :: rest =>
    exact stmtsToBlocks_invariant_cmd_arm c rest k exitConts accum gen gen' entry blocks h_gen hwf
      h_disj (fun k ss_sub exitConts accum gen gen' entry blocks hlt h_gen hwf h_disj =>
        stmtsToBlocks_invariant k ss_sub exitConts accum gen gen' entry blocks h_gen hwf h_disj)
  | .typeDecl td1 td2 :: rest =>
    exact stmtsToBlocks_invariant_typeDecl_arm td1 td2 rest k exitConts accum gen gen' entry blocks
      h_gen hwf h_disj (fun k ss_sub exitConts accum gen gen' entry blocks hlt h_gen hwf h_disj =>
        stmtsToBlocks_invariant k ss_sub exitConts accum gen gen' entry blocks h_gen hwf h_disj)
  | .exit l? md :: rest =>
    exact stmtsToBlocks_invariant_exit_arm l? md rest k exitConts accum gen gen' entry blocks
      h_gen hwf h_disj
  | .block l bss md :: rest =>
    exact stmtsToBlocks_invariant_block_arm l bss md rest k exitConts accum gen gen' entry blocks
      h_gen hwf h_disj (fun k ss_sub exitConts accum gen gen' entry blocks hlt h_gen hwf h_disj =>
        stmtsToBlocks_invariant k ss_sub exitConts accum gen gen' entry blocks h_gen hwf h_disj)
  | .ite c tss fss md :: rest =>
    exact stmtsToBlocks_invariant_ite_arm c tss fss md rest k exitConts accum gen gen' entry blocks
      h_gen hwf h_disj (fun k ss_sub exitConts accum gen gen' entry blocks hlt h_gen hwf h_disj =>
        stmtsToBlocks_invariant k ss_sub exitConts accum gen gen' entry blocks h_gen hwf h_disj)
  | .loop c m is bss md :: rest =>
    exact stmtsToBlocks_invariant_loop_arm c m is bss md rest k exitConts accum gen gen' entry blocks
      h_gen hwf h_disj (fun k ss_sub exitConts accum gen gen' entry blocks hlt h_gen hwf h_disj =>
        stmtsToBlocks_invariant k ss_sub exitConts accum gen gen' entry blocks h_gen hwf h_disj)
termination_by sizeOf ss
decreasing_by all_goals (first | assumption | (simp_wf; omega))

/-- The CFG produced by `stmtsToCFG` has unique labels.
This holds because all labels are generated fresh by `StringGenState`,
which is monotone (each generated label is fresh w.r.t. previously generated ones).

Reduces to `stmtsToBlocks_invariant`: the final block label `lend` is generated
*before* the `stmtsToBlocks` call, so it is in `gen0.gens`. The invariant says
the inner blocks' labels are NOT in `gen0.gens`, so `lend` is disjoint from them. -/
private theorem stmtsToCFG_nodup_keys {P : PureExpr}
    [HasBool P] [HasIdent P] [HasFvar P] [HasFvars P] [HasInt P] [HasIntOps P] [HasBoolOps P]
    (ss : List (Stmt P (Cmd P)))
    (h_disj : ∀ gen', StringGenState.WF gen' → Block.userLabelsDisjoint ss gen') :
    ((stmtsToCFG ss).blocks.map Prod.fst).Nodup := by
  -- Define the generator state after generating endPrefix and the resulting label.
  let p_end := StringGenState.gen endPrefix StringGenState.emp
  let lend : String := p_end.1
  let gen0 : StringGenState := p_end.2
  let r := stmtsToBlocks (P := P) (CmdT := Cmd P) lend ss
    ([] : List (Option String × String)) ([] : List (Cmd P)) gen0
  -- The blocks of stmtsToCFG ss are r.1.2 ++ [(lend, ...)]
  have h_unfold : ((stmtsToCFG ss).blocks.map Prod.fst) =
      (r.1.2.map Prod.fst) ++ [lend] := by
    show List.map Prod.fst ((stmtsToCFG ss).blocks) = _
    unfold stmtsToCFG stmtsToCFGM
    simp only [bind, StateT.bind, pure, StateT.pure, Id]
    show List.map Prod.fst (_ ++ [(lend, _)]) = _
    rw [List.map_append]
    rfl
  rw [h_unfold]
  -- WF of empty state
  have hwf_emp : StringGenState.WF StringGenState.emp := StringGenState.wf_emp
  -- WF of gen0
  have hwf0 : StringGenState.WF gen0 :=
    StringGenState.WFMono hwf_emp rfl
  -- lend ∈ StringGenState.stringGens gen0
  have h_lend_in_gen0 : lend ∈ StringGenState.stringGens gen0 := by
    show lend ∈ StringGenState.stringGens p_end.2
    rw [StringGenState.stringGens_gen]; exact List.mem_cons.mpr (Or.inl rfl)
  -- Get invariant from the helper
  have h_eq : stmtsToBlocks lend ss [] [] gen0 = ((r.1.1, r.1.2), r.2) := rfl
  have hwf_r2 : StringGenState.WF r.2 :=
    (stmtsToBlocks_genStep lend ss [] [] gen0 r.2 r.1.1 r.1.2 h_eq).wf_mono hwf0
  have h_inv : @StmtsToBlocksInv P gen0 r.2 (Block.getBlockLabels ss) r.1.2 :=
    stmtsToBlocks_invariant lend ss [] [] gen0 r.2 _ _ h_eq hwf0 (h_disj _ hwf_r2)
  -- Build Nodup of r.1.2.map Prod.fst ++ [lend]
  rw [List.nodup_append]
  refine ⟨h_inv.nodup, ?_, ?_⟩
  · simp
  · -- disjointness: lend not in r.1.2.map Prod.fst
    intro x hx y hy h_eq
    rw [List.mem_singleton] at hy
    subst hy
    subst h_eq
    rcases h_inv.fresh _ hx with h_gen | h_user
    · -- lend ∈ stringGens r.2 \ stringGens gen0; but lend ∈ stringGens gen0. Contradiction.
      exact h_gen.2 h_lend_in_gen0
    · -- lend is a user label of ss; but lend = (gen endPrefix emp).1 has shape, so it's not user.
      -- We instead use that user labels are disjoint from stringGens (h_inv.user_disj)
      have h_lend_in_r2 : lend ∈ StringGenState.stringGens r.2 := by
        have h_step := h_inv.toGenStep
        exact h_step.subset h_lend_in_gen0
      exact h_inv.user_disj _ h_user h_lend_in_r2

/-- Covering labels of an `exitConts` list: the `.some` keys. A structured `.exit l`
whose `l` is uncaught (`exitConts.lookup (some l) = none`) cannot appear in this list. -/
@[expose] def coveringLabels (exitConts : List (Option String × String)) : List String :=
  exitConts.filterMap (fun p => match p.1 with | some l => some l | none => none)

theorem not_mem_coveringLabels_of_lookup_none
    (exitConts : List (Option String × String)) (l : String)
    (h : exitConts.lookup (some l) = none) : l ∉ coveringLabels exitConts := by
  induction exitConts with
  | nil => simp [coveringLabels]
  | cons p ps ih =>
    obtain ⟨k0, v0⟩ := p
    cases k0 with
    | none =>
      simp only [List.lookup] at h
      have h_rest : List.lookup (some l) ps = none := by simpa using h
      simpa [coveringLabels] using ih h_rest
    | some l0 =>
      simp only [List.lookup] at h
      by_cases hbeq : (some l == some l0) = true
      · rw [hbeq] at h; simp at h
      · rw [Bool.not_eq_true] at hbeq
        rw [hbeq] at h
        simp only at h
        have hne : l ≠ l0 := by
          intro heq; rw [heq] at hbeq; simp at hbeq
        have h_notin_rest : l ∉ coveringLabels ps := ih h
        simp only [coveringLabels, List.filterMap_cons]
        rw [List.mem_cons]
        rintro (heq | hin)
        · exact hne heq
        · exact h_notin_rest (by simpa [coveringLabels] using hin)

/-! ## `stmtsToCFG` block specification -/

/-- Specification lemma: `stmtsToCFG` produces a CFG whose blocks come from
`stmtsToBlocks` plus a terminal block, and whose entry matches.
Specialized to `CmdT = Cmd P` so we can use `stmtsToBlocks_invariant`
(which depends on the `[HasBoolOps P]` instance present on `Cmd P`). -/
theorem stmtsToCFG_stmtsToBlocks_spec {P : PureExpr}
    [HasBool P] [HasIdent P] [HasFvar P] [HasFvars P] [HasInt P] [HasIntOps P] [HasBoolOps P]
    (ss : List (Stmt P (Cmd P)))
    (h_disj : ∀ gen', StringGenState.WF gen' → Block.userLabelsDisjoint ss gen') :
    ∃ (lend : String) (gen gen' : StringGenState)
      (entry : String) (blocks : DetBlocks String (Cmd P) P),
      stmtsToBlocks lend ss [] [] gen = ((entry, blocks), gen') ∧
      (stmtsToCFG ss).entry = entry ∧
      (∀ b ∈ blocks, b ∈ (stmtsToCFG ss).blocks) ∧
      (stmtsToCFG ss).blocks.lookup lend =
        some ({ cmds := [], transfer := .finish .empty } : BasicBlock (DetTransferCmd String P) (Cmd P)) ∧
      StringGenState.WF gen ∧
      -- `gen` is the generator state after the single `endPrefix` generate that
      -- `stmtsToCFGM` performs before invoking `stmtsToBlocks`.  Exposing this
      -- lets the caller track `AllMem` from `StringGenState.emp` through to the
      -- output `gen'`, which underpins the foreign-label self-discharge.
      gen = (StringGenState.gen endPrefix StringGenState.emp).2 := by
  let p_end := StringGenState.gen endPrefix StringGenState.emp
  let lend := p_end.1
  let gen0 := p_end.2
  let r := stmtsToBlocks lend ss ([] : List (Option String × String)) ([] : List (Cmd P)) gen0
  have h_cfg : stmtsToCFG ss =
      { entry := r.1.1, blocks := r.1.2 ++ [(lend, { cmds := [], transfer := .finish .empty })] } := by
    simp [stmtsToCFG, stmtsToCFGM]
    rfl
  -- WF of gen0 (after one gen call from emp)
  have hwf0 : StringGenState.WF gen0 :=
    StringGenState.WFMono StringGenState.wf_emp rfl
  refine ⟨lend, gen0, r.2, r.1.1, r.1.2, rfl, ?_, ?_, ?_, hwf0, rfl⟩
  · simp [h_cfg]
  · intro b hb; simp only [h_cfg, List.mem_append, List.mem_cons, List.not_mem_nil, or_false]; exact Or.inl hb
  · -- Show lookup of lend in (r.1.2 ++ [(lend, finish)]) is the finish block.
    -- Strategy: use stmtsToBlocks_invariant to show lend ∉ r.1.2.map Prod.fst,
    -- then List.lookup skips past r.1.2 to find lend at the end.
    rw [h_cfg]
    show List.lookup lend (r.1.2 ++ [(lend, _)]) = _
    -- WF of gen0 (after one gen call from emp)
    have hwf0 : StringGenState.WF gen0 :=
      StringGenState.WFMono StringGenState.wf_emp rfl
    -- lend ∈ stringGens gen0
    have h_lend_in_gen0 : lend ∈ StringGenState.stringGens gen0 := by
      show lend ∈ StringGenState.stringGens p_end.2
      rw [StringGenState.stringGens_gen]; exact List.mem_cons.mpr (Or.inl rfl)
    -- All labels in r.1.2 are NOT in stringGens gen0 (by invariant fresh field)
    have h_eq : stmtsToBlocks lend ss [] [] gen0 = ((r.1.1, r.1.2), r.2) := rfl
    have hwf_r2 : StringGenState.WF r.2 :=
      (stmtsToBlocks_genStep lend ss [] [] gen0 r.2 r.1.1 r.1.2 h_eq).wf_mono hwf0
    have h_inv : @StmtsToBlocksInv P gen0 r.2 (Block.getBlockLabels ss) r.1.2 :=
      stmtsToBlocks_invariant lend ss [] [] gen0 r.2 _ _ h_eq hwf0 (h_disj _ hwf_r2)
    have h_lend_not_in_blocks : lend ∉ r.1.2.map Prod.fst := by
      intro h_in
      cases h_inv.fresh _ h_in with
      | inl h_gen => exact h_gen.2 h_lend_in_gen0
      | inr h_user =>
        have h_lend_in_r2 : lend ∈ StringGenState.stringGens r.2 :=
          h_inv.toGenStep.subset h_lend_in_gen0
        exact h_inv.user_disj _ h_user h_lend_in_r2
    -- Now lookup lend in r.1.2 ++ [(lend, _)] = lookup lend [(lend, _)]
    rw [List.lookup_append]
    -- Helper lemma: lookup = some v implies (key, v) ∈ list
    have lookup_to_mem : ∀ {α β : Type} [BEq α] [LawfulBEq α]
        (l : List (α × β)) (k : α) (v : β), l.lookup k = some v → (k, v) ∈ l := by
      intro α β _ _ l k v hlk
      induction l with
      | nil => simp [List.lookup] at hlk
      | cons hd tl ih =>
        obtain ⟨k', v'⟩ := hd
        by_cases h_eq : k = k'
        · subst h_eq
          simp only [List.lookup, BEq.rfl, Option.some.injEq] at hlk
          subst hlk
          exact List.Mem.head _
        · have h_neq : ¬(k == k') = true := by simp [h_eq]
          simp only [List.lookup, h_neq] at hlk
          exact List.mem_cons_of_mem _ (ih hlk)
    have h_lookup_none : List.lookup lend r.1.2 = none := by
      rcases h : List.lookup lend r.1.2 with _ | v
      · rfl
      · exfalso
        apply h_lend_not_in_blocks
        exact List.mem_map.mpr ⟨(lend, v), lookup_to_mem _ _ _ h, rfl⟩
    rw [h_lookup_none]
    simp [List.lookup, Option.or]
    rfl

end StructuredToUnstructuredCorrect

namespace StructuredToUnstructuredCorrect

open Imperative Specification

namespace S2UTrace

inductive EvalCmdsE {P : PureExpr} [HasFvar P] [HasBool P]
    (factory : P.Factory) :
    SemanticStore P → List (Cmd P) → SemanticStore P → Trace P → Prop where
  | nil (store) : EvalCmdsE factory store [] store []
  | cons {store middle final : SemanticStore P} {command : Cmd P}
      {commands : List (Cmd P)} {emitted rest : Trace P} :
      Imperative.EvalCmdE P factory store command middle emitted →
      EvalCmdsE factory middle commands final rest →
      EvalCmdsE factory store (command :: commands) final (emitted ++ rest)

private theorem EvalCmdsE.snoc {P : PureExpr} [HasFvar P] [HasBool P]
    {factory : P.Factory} {start middle final : SemanticStore P}
    {commands : List (Cmd P)} {command : Cmd P} {trace emitted : Trace P}
    (hcommands : EvalCmdsE factory start commands middle trace)
    (hcommand : Imperative.EvalCmdE P factory middle command final emitted) :
    EvalCmdsE factory start (commands ++ [command]) final (trace ++ emitted) := by
  induction hcommands with
  | nil => simpa using EvalCmdsE.cons hcommand (EvalCmdsE.nil final)
  | cons hhead _ ih =>
      simpa [List.append_assoc] using EvalCmdsE.cons hhead (ih hcommand)

private def CommandSourceInv {P : PureExpr} [HasFvar P] [HasBoolOps P]
    (initial : Env P) (commands : List (Cmd P))
    (config : Config P (Cmd P)) (trace : Trace P) : Prop :=
  ∃ done remaining store,
    done ++ remaining = commands ∧
    EvalCmdsE initial.factory initial.store done store trace ∧
    (config = .stmts (remaining.map (@Stmt.cmd P (Cmd P))) { initial with store := store }
      ∨ (∃ command tail, remaining = command :: tail ∧
          config = .seq (.stmt (.cmd command) { initial with store := store })
            (tail.map (@Stmt.cmd P (Cmd P))))
      ∨ config = .seq (.terminal { initial with store := store })
          (remaining.map (@Stmt.cmd P (Cmd P)))
      ∨ (remaining = [] ∧ config = .terminal { initial with store := store }))

private theorem CommandSourceInv.start {P : PureExpr} [HasFvar P] [HasBoolOps P]
    (initial : Env P) (commands : List (Cmd P)) :
    CommandSourceInv initial commands
      (.stmts (commands.map (@Stmt.cmd P (Cmd P))) initial) [] :=
  ⟨[], commands, initial.store, rfl, EvalCmdsE.nil _, Or.inl rfl⟩

private theorem CommandSourceInv.step {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {initial : Env P} {commands : List (Cmd P)}
    {config config' : Config P (Cmd P)} {trace emitted : Trace P}
    (hstep : StepStmtE P (Imperative.EvalCmdE P) config emitted config')
    (hinv : CommandSourceInv initial commands config trace) :
    CommandSourceInv initial commands config' (trace ++ emitted) := by
  obtain ⟨done, remaining, store, hcommands, heval, hshape⟩ := hinv
  rcases hshape with hshape | ⟨command, tail, hremaining, hshape⟩ | hshape | hshape
  · subst hshape
    cases remaining with
    | nil =>
        cases hstep with
        | step_stmts_nil =>
            exact ⟨done, [], store, hcommands, by simpa using heval,
              Or.inr (Or.inr (Or.inr ⟨rfl, rfl⟩))⟩
    | cons command tail =>
        cases hstep with
        | step_stmts_cons =>
            exact ⟨done, command :: tail, store, hcommands, by simpa using heval,
              Or.inr (Or.inl ⟨command, tail, rfl, rfl⟩)⟩
  · subst hshape
    cases hstep with
    | step_seq_inner hinner =>
        cases hinner with
        | step_cmd hcommand =>
            refine ⟨done ++ [command], tail, _, ?_, ?_, Or.inr (Or.inr (Or.inl rfl))⟩
            · rw [hremaining] at hcommands
              simpa [List.append_assoc] using hcommands
            · exact EvalCmdsE.snoc heval hcommand
  · subst hshape
    cases hstep with
    | step_seq_inner hinner =>
        cases hinner
    | step_seq_done =>
        exact ⟨done, remaining, store, hcommands, by simpa using heval, Or.inl rfl⟩
  · obtain ⟨rfl, hshape⟩ := hshape
    subst hshape
    cases hstep

private theorem CommandSourceInv.starFrom {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {initial : Env P} {commands : List (Cmd P)}
    {source target : Config P (Cmd P)} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P) source trace target) :
    ∀ {initialTrace : Trace P}, CommandSourceInv initial commands source initialTrace →
      CommandSourceInv initial commands target (initialTrace ++ trace) := by
  induction hrun with
  | refl =>
      intro initialTrace hinv
      simpa using hinv
  | step source emitted middle rest target hstep _ ih =>
      intro initialTrace hinv
      have hmiddle := CommandSourceInv.step hstep hinv
      simpa [List.append_assoc] using ih hmiddle

private theorem CommandSourceInv.ofRun {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {initial : Env P} {commands : List (Cmd P)}
    {target : Config P (Cmd P)} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (commands.map (@Stmt.cmd P (Cmd P))) initial) trace target) :
    CommandSourceInv initial commands target trace := by
  simpa using CommandSourceInv.starFrom hrun (CommandSourceInv.start initial commands)

private structure EnvRel {P : PureExpr} [HasFvars P] [HasBool P]
    (keep : List P.Ident) (source target : Env P) : Prop where
  factory : target.factory = source.factory
  store : StoreAgreement source.store target.store
  fresh : ∀ x ∈ keep, target.store x = none
  mono : WellFormedSemanticEvalMono source.factory
  val : WellFormedSemanticEvalVal source.factory

private theorem EnvRel.weaken {P : PureExpr} [HasFvars P] [HasBool P]
    {small large : List P.Ident}
    {source target : Env P}
    (hsub : ∀ x ∈ small, x ∈ large)
    (h : EnvRel large source target) : EnvRel small source target :=
  { h with fresh := fun x hx => h.fresh x (hsub x hx) }

private theorem EvalCmdsE.replay {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P]
    [DecidableEq P.Ident]
    {factory : P.Factory} {sourceStart sourceFinal targetStart : SemanticStore P}
    {commands : List (Cmd P)} {sourceTrace : Trace P} {keep : List P.Ident}
    (hsource : EvalCmdsE factory sourceStart commands sourceFinal sourceTrace)
    (hmono : WellFormedSemanticEvalMono factory)
    (hagree : StoreAgreement sourceStart targetStart)
    (hfresh : ∀ x ∈ Cmds.definedVars commands ++ keep, targetStart x = none)
    (hnodup : (Cmds.definedVars commands ++ keep).Nodup) :
    ∃ targetFinal targetTrace,
      EvalCmdsE factory targetStart commands targetFinal targetTrace ∧
      StoreAgreement sourceFinal targetFinal ∧
      (∀ x ∈ keep, targetFinal x = none) ∧
      TraceExtendsEnv (fun _ : P.Ident => True) sourceTrace targetTrace := by
  induction hsource generalizing targetStart with
  | nil =>
      exact ⟨targetStart, [], EvalCmdsE.nil _, hagree,
        fun x hx => hfresh x (List.mem_append_right _ hx), .nil⟩
  | @cons sourceStart sourceMiddle sourceFinal command commands emitted rest hcommand hrest ih =>
      have hdefs : Cmds.definedVars (command :: commands) =
          Cmd.definedVars command ++ Cmds.definedVars commands := by
        simp [Cmds.definedVars]
      have hheadFresh : ∀ x ∈ Cmd.definedVars command, targetStart x = none := by
        intro x hx
        exact hfresh x (by
          rw [hdefs]
          exact List.mem_append_left keep (List.mem_append_left _ hx))
      have hext : StoreExtendsWith (fun _ : P.Ident => True) sourceStart targetStart :=
        ⟨hagree, fun _ _ => Or.inr trivial⟩
      obtain ⟨targetMiddle, htargetHead, hextMiddle, htraceHead⟩ :=
        Imperative.evalCmdE_replay_extends (fun _ : P.Ident => True)
          factory sourceStart targetStart sourceMiddle command emitted
          hext hcommand hmono hheadFresh
      have htailFresh : ∀ x ∈ Cmds.definedVars commands ++ keep,
          targetMiddle x = none := by
        intro x hx
        have hxStart : targetStart x = none := by
          exact hfresh x (by rw [hdefs, List.append_assoc]; exact List.mem_append_right _ hx)
        have hxNotHead : x ∉ Cmd.definedVars command := by
          intro hxHead
          have hfull : (Cmd.definedVars command ++ (Cmds.definedVars commands ++ keep)).Nodup := by
            simpa [hdefs, List.append_assoc] using hnodup
          exact (List.nodup_append.mp hfull).2.2 x hxHead x hx rfl
        exact evalCmdE_preserves_none_of_not_def htargetHead hxStart hxNotHead
      have htailNodup : (Cmds.definedVars commands ++ keep).Nodup := by
        have hfull : (Cmd.definedVars command ++ (Cmds.definedVars commands ++ keep)).Nodup := by
          simpa [hdefs, List.append_assoc] using hnodup
        exact (List.nodup_append.mp hfull).2.1
      obtain ⟨targetFinal, targetTrace, htargetRest, hagreeFinal, hfreshFinal,
          htraceRest⟩ := ih hextMiddle.1 htailFresh htailNodup
      exact ⟨targetFinal, Cmd.emittedEvents P command factory targetStart ++ targetTrace,
        EvalCmdsE.cons htargetHead htargetRest, hagreeFinal, hfreshFinal,
        TraceExtendsEnv.append htraceHead htraceRest⟩

end S2UTrace
end StructuredToUnstructuredCorrect

