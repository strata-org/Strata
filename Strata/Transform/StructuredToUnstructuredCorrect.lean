private theorem traceLoopDecompose {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    (continuation : String) (gen gen' : StringGenState)
    (entry : String) (blocks : DetBlocks String (Cmd P) P)
    (accum : List (Cmd P)) (condition : P.Expr)
    (body : List (Stmt P (Cmd P))) (metadata : MetaData P)
    (exitConts : List (Option String × String))
    (rest : List (Stmt P (Cmd P)))
    (hgen : stmtsToBlocks continuation
      (.loop (.det condition) none [] body metadata :: rest)
      exitConts accum gen = ((entry, blocks), gen')) :
    ∃ (next loopEntry bodyEntry accumEntry : String)
      (bodyBlocks restBlocks accumBlocks : DetBlocks String (Cmd P) P)
      (loopBlock : DetBlock String (Cmd P) P)
      (genRest genLoop genBody genFlush : StringGenState),
      stmtsToBlocks continuation rest exitConts [] gen = ((next, restBlocks), genRest) ∧
      StringGenState.gen loopEntryPrefix genRest = (loopEntry, genLoop) ∧
      stmtsToBlocks loopEntry body ((none, next) :: exitConts) [] genLoop =
        ((bodyEntry, bodyBlocks), genBody) ∧
      flushCmds beforeLoopPrefix accum .none loopEntry genBody =
        ((accumEntry, accumBlocks), genFlush) ∧
      loopBlock = { cmds := [], transfer := .condGoto condition bodyEntry next .empty } ∧
      genFlush = gen' ∧ accumEntry = entry ∧
      accumBlocks ++ [(loopEntry, loopBlock)] ++ bodyBlocks ++ restBlocks = blocks := by
  let restStep := stmtsToBlocks continuation rest exitConts [] gen
  let next := restStep.1.1
  let restBlocks := restStep.1.2
  let genRest := restStep.2
  let loopStep := StringGenState.gen loopEntryPrefix genRest
  let loopEntry := loopStep.1
  let genLoop := loopStep.2
  let bodyStep := stmtsToBlocks loopEntry body ((none, next) :: exitConts) [] genLoop
  let bodyEntry := bodyStep.1.1
  let bodyBlocks := bodyStep.1.2
  let genBody := bodyStep.2
  let flushStep := @flushCmds P (Cmd P) _ beforeLoopPrefix accum .none loopEntry genBody
  let accumEntry := flushStep.1.1
  let accumBlocks := flushStep.1.2
  let genFlush := flushStep.2
  let loopBlock : DetBlock String (Cmd P) P :=
    { cmds := [], transfer := .condGoto condition bodyEntry next .empty }
  have hrest : stmtsToBlocks continuation rest exitConts [] gen =
      ((next, restBlocks), genRest) := rfl
  have hloop : StringGenState.gen loopEntryPrefix genRest = (loopEntry, genLoop) := rfl
  have hbody : stmtsToBlocks loopEntry body ((none, next) :: exitConts) [] genLoop =
      ((bodyEntry, bodyBlocks), genBody) := rfl
  have hflush : flushCmds beforeLoopPrefix accum .none loopEntry genBody =
      ((accumEntry, accumBlocks), genFlush) := rfl
  have hred : stmtsToBlocks continuation
      (.loop (.det condition) none [] body metadata :: rest)
      exitConts accum gen =
      ((accumEntry, accumBlocks ++ [(loopEntry, loopBlock)] ++ bodyBlocks ++ restBlocks),
        genFlush) := by
    unfold stmtsToBlocks
    simp only [bind, StateT.bind, hrest, hloop, hbody,
      pure, StateT.pure, List.append_nil]
    rfl
  have hall := hred.symm.trans hgen
  exact ⟨next, loopEntry, bodyEntry, accumEntry, bodyBlocks, restBlocks, accumBlocks,
    loopBlock, genRest, genLoop, genBody, genFlush, hrest, hloop, hbody, hflush, rfl,
    (Prod.mk.inj hall).2, (Prod.mk.inj (Prod.mk.inj hall).1).1,
    (Prod.mk.inj (Prod.mk.inj hall).1).2⟩

end S2UTrace
end StructuredToUnstructuredCorrect

namespace StructuredToUnstructuredCorrect
open Imperative Specification
namespace S2UTrace

private theorem stmtsTraceLoopDet {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (condition : P.Expr) (body : List (Stmt P (Cmd P)))
    (metadata : MetaData P) (rest : List (Stmt P (Cmd P)))
    (continuation : String)
    (sim : ∀ next statements,
      sizeOf statements < sizeOf
        (.loop (.det condition) none [] body metadata :: rest :
          List (Stmt P (Cmd P))) →
      StmtsTraceSpec (P := P) next statements) :
    StmtsTraceSpec (P := P) continuation
      (.loop (.det condition) none [] body metadata :: rest) := by
  intro exitConts accum gen gen' entry blocks hgen hsimple hunique hlbni hlhni hnml
    hcovered keep hnodup source target hrel cfg hblocks hcfgNodup
  obtain ⟨next, loopEntry, bodyEntry, accumEntry, bodyBlocks, restBlocks, accumBlocks,
      loopBlock, genRest, genLoop, genBody, genFlush, hrestEq, hloopEq, hbodyEq,
      hflushEq, hloopBlock, hgenEq, hentryEq, hblocksEq⟩ :=
    traceLoopDecompose continuation gen gen' entry blocks accum condition body metadata
      exitConts rest hgen
  have hcfgAccum : ∀ block ∈ accumBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rw [← hblocksEq]
    simp [hblock]
  have hcfgBody : ∀ block ∈ bodyBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rw [← hblocksEq]
    simp [hblock]
  have hcfgRest : ∀ block ∈ restBlocks, block ∈ cfg.blocks := by
    intro block hblock
    apply hblocks
    rw [← hblocksEq]
    simp [hblock]
  have hloopMem : (loopEntry, loopBlock) ∈ cfg.blocks := by
    apply hblocks
    rw [← hblocksEq]
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    left
    left
    right
    trivial
  have hloopLookup : cfg.blocks.lookup loopEntry = some loopBlock :=
    List.lookup_of_mem_nodup cfg.blocks hcfgNodup _ _ hloopMem
  rw [hloopBlock] at hloopLookup
  subst entry
  subst gen'
  have hsimpleHead := (Block.noNondetGuards_cons_iff.mp hsimple).1
  have hsimpleBody := Stmt.noNondetGuards_loop_body hsimpleHead
  have hsimpleRest := (Block.noNondetGuards_cons_iff.mp hsimple).2
  have hlbniHead := (Block.loopBodyNoInits_cons_iff.mp hlbni).1
  have hbodyNoInits := Stmt.loopBodyNoInits_loop_body hlbniHead
  have hlbniBody := Stmt.loopBodyNoInits_loop_body_rec hlbniHead
  have hlbniRest := (Block.loopBodyNoInits_cons_iff.mp hlbni).2
  have hlhniHead := (Block.loopHasNoInvariants_cons_iff.mp hlhni).1
  have hlhniBody := Stmt.loopHasNoInvariants_loop_body_rec hlhniHead
  have hlhniRest := (Block.loopHasNoInvariants_cons_iff.mp hlhni).2
  have hnmlHead := (Block.noMeasureLoops_cons_iff.mp hnml).1
  have hnmlBody := Stmt.noMeasureLoops_loop_body_rec hnmlHead
  have hnmlRest := (Block.noMeasureLoops_cons_iff.mp hnml).2
  have huniqueBody : Block.uniqueInits body := by
    unfold Block.uniqueInits
    rw [hbodyNoInits]
    simp
  have huniqueRest := Block.uniqueInits.tail hunique
  have hcoveredBody : Block.exitsCoveredByBlocks (coveringLabels exitConts) body := by
    simpa [Stmt.exitsCoveredByBlocks] using hcovered.1
  have hcoveredBodyExtended : Block.exitsCoveredByBlocks
      (coveringLabels ((none, next) :: exitConts)) body := by
    simpa [coveringLabels] using hcoveredBody
  have hcoveredRest : Block.exitsCoveredByBlocks (coveringLabels exitConts) rest := hcovered.2
  have hinitEq : Block.initVars
      (.loop (.det condition) none [] body metadata :: rest) = Block.initVars rest := by
    rw [Block.initVars_cons, Stmt.initVars_loop, hbodyNoInits, List.nil_append]
  let tailKeep := Block.initVars rest ++ keep
  have hcombinedNodup : (Cmds.definedVars accum.reverse ++ tailKeep).Nodup := by
    simpa [pendingInits, tailKeep, hinitEq, List.append_assoc] using hnodup
  have htailNodup : tailKeep.Nodup := (List.nodup_append.mp hcombinedNodup).2.1
  have hbodyNodup : (pendingInits ([] : List (Cmd P)) body ++ tailKeep).Nodup := by
    simpa [pendingInits, Cmds.definedVars, hbodyNoInits] using htailNodup
  have hrestNodup : (pendingInits ([] : List (Cmd P)) rest ++ keep).Nodup := by
    simpa [pendingInits, Cmds.definedVars, tailKeep] using htailNodup
  have hflush : TraceSim (EnvRel tailKeep)
      (fun env => .atBlock cfg loopEntry env)
      (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
      (.stmts (accum.reverse.map (@Stmt.cmd P (Cmd P))) source)
      (.atBlock cfg accumEntry target) :=
    flushGotoSim cfg beforeLoopPrefix loopEntry accum genBody genFlush accumEntry accumBlocks
      hflushEq hcfgAccum hcfgNodup tailKeep source target
      (by simpa [tailKeep, pendingInits, hinitEq, List.append_assoc] using hrel)
      hcombinedNodup hrel.mono hrel.val
      (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
  have buildTail : ∀ sourceMiddle targetMiddle,
      EnvRel tailKeep sourceMiddle targetMiddle →
      TraceSim (EnvRel keep)
        (fun env => .atBlock cfg continuation env)
        (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
        (.stmts (.loop (.det condition) none [] body metadata :: rest) sourceMiddle)
        (.atBlock cfg loopEntry targetMiddle) := by
    intro sourceMiddle targetMiddle hmiddle
    have buildBody : ∀ sourceIter targetIter,
        EnvRel tailKeep sourceIter targetIter →
        TraceSim (EnvRel tailKeep)
          (fun env => .atBlock cfg loopEntry env)
          (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
          (.stmts body sourceIter) (.atBlock cfg bodyEntry targetIter) := by
      intro sourceIter targetIter hiter
      have hbodyRel : EnvRel (pendingInits ([] : List (Cmd P)) body ++ tailKeep)
          sourceIter targetIter := by
        simpa [pendingInits, Cmds.definedVars, hbodyNoInits] using hiter
      have bodyRaw := sim loopEntry body (by simp_wf; omega)
        ((none, next) :: exitConts) [] genLoop genBody bodyEntry bodyBlocks
        hbodyEq hsimpleBody huniqueBody hlbniBody hlhniBody hnmlBody
        hcoveredBodyExtended tailKeep hbodyNodup sourceIter targetIter hbodyRel
        cfg hcfgBody hcfgNodup
      exact TraceSim.retargetCoveredExits cfg loopEntry continuation
        ((none, next) :: exitConts) body sourceIter hcoveredBodyExtended bodyRaw
    have headTrace := deterministicLoopSim cfg loopEntry bodyEntry next condition body
      metadata tailKeep
      (fun label env => .atBlock cfg (exitDest continuation exitConts label) env)
      hloopLookup buildBody sourceMiddle targetMiddle hmiddle hmiddle.mono
    have headTraceList := TraceSim.sourceSingleton headTrace
    exact TraceSim.append headTraceList
      (fun _ _ h => h.weaken (fun x hx => List.mem_append_right (Block.initVars rest) hx))
      (fun sourceAfter targetAfter hafter =>
        sim continuation rest (by simp_wf; omega) exitConts [] gen genRest next restBlocks
          hrestEq hsimpleRest huniqueRest hlbniRest hlhniRest hnmlRest hcoveredRest
          keep hrestNodup sourceAfter targetAfter
          (by simpa [pendingInits, Cmds.definedVars, tailKeep] using hafter)
          cfg hcfgRest hcfgNodup)
  have hfull := TraceSim.append hflush
    (fun _ _ h => h.weaken (fun x hx => List.mem_append_right (Block.initVars rest) hx))
    buildTail
  simpa [sourceCode] using hfull

end S2UTrace
