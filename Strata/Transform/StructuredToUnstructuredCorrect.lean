private theorem stmtsTraceIte {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (guard : ExprOrNondet P) (thenBranch elseBranch : List (Stmt P (Cmd P)))
    (metadata : MetaData P) (rest : List (Stmt P (Cmd P)))
    (continuation : String)
    (sim : ∀ next statements,
      sizeOf statements < sizeOf
        (.ite guard thenBranch elseBranch metadata :: rest : List (Stmt P (Cmd P))) →
      StmtsTraceSpec (P := P) next statements) :
    StmtsTraceSpec (P := P) continuation
      (.ite guard thenBranch elseBranch metadata :: rest) := by
  cases guard with
  | det condition =>
      exact stmtsTraceIteDet condition thenBranch elseBranch metadata rest continuation sim
  | nondet =>
      intro exitConts accum gen gen' entry blocks hgen hsimple
      have hhead := (Block.noNondetGuards_cons_iff.mp hsimple).1
      simp [Stmt.noNondetGuards] at hhead

private theorem stmtsTraceLoop {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (guard : ExprOrNondet P) (measure : Option P.Expr)
    (invariants : List (String × P.Expr)) (body : List (Stmt P (Cmd P)))
    (metadata : MetaData P) (rest : List (Stmt P (Cmd P)))
    (continuation : String)
    (sim : ∀ next statements,
      sizeOf statements < sizeOf
        (.loop guard measure invariants body metadata :: rest : List (Stmt P (Cmd P))) →
      StmtsTraceSpec (P := P) next statements) :
    StmtsTraceSpec (P := P) continuation
      (.loop guard measure invariants body metadata :: rest) := by
  intro exitConts accum gen gen' entry blocks hgen hsimple hunique hlbni hlhni hnml
    hcovered keep hnodup source target hrel cfg hblocks hcfgNodup
  have hsimpleHead := (Block.noNondetGuards_cons_iff.mp hsimple).1
  obtain ⟨condition, hguard⟩ := Stmt.noNondetGuards_loop_guard_det hsimpleHead
  subst guard
  have hnmlHead := (Block.noMeasureLoops_cons_iff.mp hnml).1
  have hmeasure : measure = none := by
    simp only [Stmt.noMeasureLoops, Bool.and_eq_true, Option.isNone_iff_eq_none] at hnmlHead
    exact hnmlHead.1
  subst measure
  have hlhniHead := (Block.loopHasNoInvariants_cons_iff.mp hlhni).1
  have hinvariants : invariants = [] := Stmt.loopHasNoInvariants_loop_invs hlhniHead
  subst invariants
  exact stmtsTraceLoopDet condition body metadata rest continuation sim
    exitConts accum gen gen' entry blocks hgen hsimple hunique hlbni hlhni hnml
    hcovered keep hnodup source target hrel cfg hblocks hcfgNodup

private theorem stmtsToBlocksTraceSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (continuation : String) (statements : List (Stmt P (Cmd P))) :
    StmtsTraceSpec (P := P) continuation statements := by
  match statements with
  | [] => exact stmtsTraceNil continuation
  | .cmd command :: rest =>
      exact stmtsTraceCmd command rest continuation
        (stmtsToBlocksTraceSim continuation rest)
  | .typeDecl constructor metadata :: rest =>
      exact stmtsTraceTypeDecl constructor metadata rest continuation
        (stmtsToBlocksTraceSim continuation rest)
  | .exit label metadata :: rest =>
      exact stmtsTraceExit label metadata rest continuation
  | .block blockLabel body metadata :: rest =>
      exact stmtsTraceBlock blockLabel body metadata rest continuation
        (fun next sub hlt => stmtsToBlocksTraceSim next sub)
  | .ite guard thenBranch elseBranch metadata :: rest =>
      exact stmtsTraceIte guard thenBranch elseBranch metadata rest continuation
        (fun next sub hlt => stmtsToBlocksTraceSim next sub)
  | .loop guard measure invariants body metadata :: rest =>
      exact stmtsTraceLoop guard measure invariants body metadata rest continuation
        (fun next sub hlt => stmtsToBlocksTraceSim next sub)
termination_by sizeOf statements
decreasing_by
  all_goals first | assumption | (simp_wf; omega)

end S2UTrace
