namespace Imperative.StructuredToUnstructured

open Imperative Specification Imperative.Logic
open StructuredToUnstructuredCorrect S2UTrace
open StructuredToUnstructuredWF

/-- Structured CFG lowering preserves the generic CFG initial-environment gate.
The source reserves this pass's generated prefixes; the target retains the
caller's inherited prefixes. -/
theorem cfgInitEnvWF {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [LawfulHasVal P] [LawfulHasBool P]
    [HasInt P] [HasIntOps P] [DecidableEq P.Ident] [HasOps P]
    [LawfulHasFvar P] [LawfulHasIdent P] [HasSubstFvar P]
    (base : InitEnvWFParams P)
    (statements : List (Stmt P (Cmd P)))
    (hpre :
      Block.noNondetGuards statements = true
      ∧ Block.uniqueInits statements
      ∧ Block.loopBodyNoInits statements = true
      ∧ Block.loopHasNoInvariants statements = true
      ∧ Block.noMeasureLoops statements = true
      ∧ Block.exitsCoveredByBlocks [] statements
      ∧ Block.userLabelsShapeNodup statements
      ∧ (∀ name : String, isGeneratedName name →
        HasIdent.ident (P := P) name ∉ Block.initVars statements))
    (ρ : Env P)
    (hwf : BlockInitEnvWF (base.extend prefixesReserved) statements ρ) :
    CFGInitEnvWF base (stmtsToCFG statements) ρ := by
  obtain ⟨hng, _, _, hni, hnm, _, _, _⟩ := hpre
  have hduLive := Block.cfgLive_defUseWellFormed
    (fun ident => (ρ.store ident).isSome)
    (base.extend prefixesReserved).declaredFuncs statements hwf.defUseOk
  refine
    { toWellFormedSemanticEval := hwf.toWellFormedSemanticEval
      storeWellDefined := hwf.storeWellDefined
      readWritesDefined := ?_
      defsUndefined := ?_
      definedVarsNotReserved := ?_
      reservedFresh := ?_
      initTypesInhabited := ?_ }
  · intro ident htouched hnotDefined
    simp only [List.mem_append] at htouched
    have hnotLive : ident ∉ Block.initVars (Block.cfgLive statements) := by
      intro hmem
      exact hnotDefined ((stmtsToCFG_definedVars_iff statements hng hni hnm ident).2 hmem)
    have htouchedLive : ident ∈ Block.touchedVars (Block.cfgLive statements) := by
      rcases htouched with (hmodified | hdefined) | hread
      · have hmodifiedLive :=
          (stmtsToCFG_modifiedVars_iff statements hng hni hnm ident).1 hmodified
        simp only [Block.touchedVars, Block.modifiedOrDefinedVars, List.append_assoc, List.mem_append]
        exact Or.inl hmodifiedLive
      · exact absurd hdefined hnotDefined
      · have hreadLive :=
          (stmtsToCFG_readVars_iff statements hng hni hnm ident).1 hread
        simp only [Block.touchedVars, Block.modifiedOrDefinedVars, List.append_assoc, List.mem_append]
        exact Or.inr (Or.inr hreadLive)
    exact Block.defined_of_mem_touchedVars
      (fun _ _ h => h) hduLive htouchedLive hnotLive
  · intro ident hdefined
    have hLive :=
      (stmtsToCFG_definedVars_iff statements hng hni hnm ident).1 hdefined
    exact hwf.defsUndefined ident
      (Block.mem_initVars_of_cfgLive statements ident hLive)
  · intro ident hdefined name heq pfx hpfx
    have hLive :=
      (stmtsToCFG_definedVars_iff statements hng hni hnm ident).1 hdefined
    exact hwf.definedVarsNotReserved ident
      (Block.mem_initVars_of_cfgLive statements ident hLive)
      name heq pfx (by simp [InitEnvWFParams.extend, hpfx])
  · intro ident hdefined name heq pfx hpfx
    exact hwf.reservedFresh ident hdefined name heq pfx
      (by simp [InitEnvWFParams.extend, hpfx])
  · intro ty hty
    have hLive := (stmtsToCFG_initTypes_iff statements hng hni hnm ty).1 hty
    exact hwf.initTypesInhabited ty
      (Block.mem_initTypes_of_cfgLive statements ty hLive)

/-- Structured CFG lowering overapproximates source traces under
`Trace.WithWF` matching and establishes the full generic CFG initial-environment gate. -/
theorem overapproximatesTraces {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [LawfulHasVal P]
    [HasInt P] [HasIntOps P] [DecidableEq P.Ident] [HasOps P]
    [LawfulHasFvar P] [LawfulHasIdent P] [HasSubstFvar P] [LawfulHasBool P]
    (base : InitEnvWFParams P) :
    Specification.Transform.OverapproximatesTracesUptoWhen
      (Trace.WithWF (P := P) (EventArg.ExtendsEnv (fun _ => True)))
      (· = ·)
      (Specification.Transform.EnvStoreAgree (P := P))
      (EventLang.imperativeBlockE P (Cmd P) (EvalCmdE P)
        ⟨InitEnvWFParams P, BlockInitEnvWF⟩)
      (EventLang.cfgE P (Cmd P) (EvalCmdE P)
        (InitEnvWFParams P) CFGInitEnvWF)
      (fun statements => some (stmtsToCFG statements))
      (fun statements =>
        Block.noNondetGuards statements = true
        ∧ Block.uniqueInits statements
        ∧ Block.loopBodyNoInits statements = true
        ∧ Block.loopHasNoInvariants statements = true
        ∧ Block.noMeasureLoops statements = true
        ∧ Block.exitsCoveredByBlocks [] statements
        ∧ Block.userLabelsShapeNodup statements
        ∧ (∀ name : String, isGeneratedName name →
          HasIdent.ident (P := P) name ∉ Block.initVars statements))
      (base.extend prefixesReserved) base := by
  intro statements cfg htransform hpre source target hinput hwf
  subst hinput
  simp only [Option.some.injEq] at htransform
  subst cfg
  change BlockInitEnvWF (base.extend prefixesReserved) statements source at hwf
  have hpre' := hpre
  obtain ⟨hsimple, hunique, hlbni, hlhni, hnml, hcovered, hlabels, _⟩ := hpre'
  have hsim := S2UTrace.stmtsToCFGTraceSimWithNodup statements source
    hsimple hunique hlbni hlhni hnml hcovered hlabels
    (fun ident hident =>
      Option.isNone_iff_eq_none.mp (hwf.defsUndefined ident hident))
    hwf.mono hwf.val (stmtsToCFG_nodup_keys statements
      (Block.userLabelsDisjoint_of_shapeNodup statements hlabels))
  have hstrong : ∀ {sourceFinal : Config P (Cmd P)} {sourceTrace : Trace P}
      {targetFinal : CFGConfig String (Cmd P) P} {targetTrace : Trace P},
      StepStmtStarE P (EvalCmdE P) (.stmts statements source) sourceTrace sourceFinal →
      StepCFGStarE P (EvalCmdE P)
        (.atBlock (stmtsToCFG statements) (stmtsToCFG statements).entry source)
        targetTrace targetFinal →
      TraceExtendsEnv (fun _ : P.Ident => True) sourceTrace targetTrace →
      Trace.WithWF (P := P) (EventArg.ExtendsEnv (fun _ => True)) sourceTrace targetTrace := by
    intro _ _ _ _ hrun htarget htrace
    exact Trace.WithWF.of_extends htrace
      (Block.run_readsDefined hwf.defUseOk hrun)
      (Trace.semanticWF_of_starE hrun hwf.val hwf.exprCongr hwf.storeWellDefined)
      (StepCFGStarE.semanticWF_evalCmdE htarget hwf.val hwf.exprCongr
        hwf.storeWellDefined)
  refine ⟨?_, ?_, ?_, cfgInitEnvWF base statements hpre source hwf⟩
  · intro sourceFinal sourceTrace hrun
    obtain ⟨targetFinal, targetTrace, htarget, htrace⟩ := hsim.simulate hrun
    exact ⟨targetFinal, targetTrace, htarget, hstrong hrun htarget htrace⟩
  · intro sourceEnv sourceTrace hrun
    obtain ⟨targetEnv, targetTrace, htarget, hrel, htrace⟩ := hsim.terminal hrun
    exact ⟨targetEnv, targetTrace, htarget, hrel.store,
      hstrong hrun htarget htrace⟩
  · intro label sourceEnv sourceTrace hrun
    obtain ⟨targetEnv, targetTrace, htarget, hrel, htrace⟩ := hsim.exiting hrun
    exact ⟨targetEnv, targetTrace, htarget, hrel.store,
      hstrong hrun htarget htrace⟩

end Imperative.StructuredToUnstructured

