private theorem finishRun {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P)) (label : String) (env : Env P)
    (hlookup : cfg.blocks.lookup label = some
      ({ cmds := [], transfer := .finish .empty } : DetBlock String (Cmd P) P)) :
    StepCFGStarE P (Imperative.EvalCmdE P)
      (.atBlock cfg label env) [] (.terminal env) := by
  have hfetch : StepCFGE P (Imperative.EvalCmdE P)
      (.atBlock cfg label env) [] (.inBlock cfg label [] (.finish .empty) env) :=
    StepCFGE.fetch hlookup
  have hfinish : StepCFGE P (Imperative.EvalCmdE P)
      (.inBlock cfg label [] (.finish .empty) env) [] (.terminal env) :=
    StepCFGE.finish
  change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ [] _
  exact .step _ [] _ [] _ hfetch (.step _ [] _ [] _ hfinish (.refl _))

private theorem TraceSim.finish {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {Rel : Env P → Env P → Prop}
    (cfg : CFG String (DetBlock String (Cmd P) P)) (label : String)
    {source : Config P (Cmd P)} {target : CFGConfig String (Cmd P) P}
    (hlookup : cfg.blocks.lookup label = some
      ({ cmds := [], transfer := .finish .empty } : DetBlock String (Cmd P) P))
    (h : TraceSim Rel
      (fun env => .atBlock cfg label env)
      (fun _ env => .atBlock cfg label env) source target) :
    TraceSim Rel (fun env => .terminal env) (fun _ env => .terminal env)
      source target := by
  refine ⟨h.simulate, ?_, ?_⟩
  · intro sourceEnv sourceTrace hrun
    obtain ⟨targetEnv, targetTrace, htarget, hrel, htrace⟩ := h.terminal hrun
    exact ⟨targetEnv, targetTrace, by
      simpa using cfgTraceTrans htarget (finishRun cfg label targetEnv hlookup), hrel, htrace⟩
  · intro exitLabel sourceEnv sourceTrace hrun
    obtain ⟨targetEnv, targetTrace, htarget, hrel, htrace⟩ := h.exiting hrun
    exact ⟨targetEnv, targetTrace, by
      simpa using cfgTraceTrans htarget (finishRun cfg label targetEnv hlookup), hrel, htrace⟩

private theorem stmtsToCFGTraceSimWithNodup {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P] [HasInt P] [HasIntOps P]
    [DecidableEq P.Ident] [HasOps P] [LawfulHasFvar P] [LawfulHasIdent P] [LawfulHasVal P]
    (statements : List (Stmt P (Cmd P))) (initial : Env P)
    (hsimple : Block.noNondetGuards statements = true)
    (hunique : Block.uniqueInits statements)
    (hlbni : Block.loopBodyNoInits statements = true)
    (hlhni : Block.loopHasNoInvariants statements = true)
    (hnml : Block.noMeasureLoops statements = true)
    (hcovered : Block.exitsCoveredByBlocks [] statements)
    (hlabels : Block.userLabelsShapeNodup statements)
    (hfresh : ∀ x ∈ Block.initVars statements, initial.store x = none)
    (hmono : WellFormedSemanticEvalMono initial.factory)
    (hval : WellFormedSemanticEvalVal initial.factory)
    (hcfgNodup : ((stmtsToCFG statements).blocks.map Prod.fst).Nodup) :
    TraceSim (EnvRel ([] : List P.Ident))
      (fun env => .terminal env) (fun _ env => .terminal env)
      (.stmts statements initial)
      (.atBlock (stmtsToCFG statements) (stmtsToCFG statements).entry initial) := by
  have hdisj : ∀ gen', StringGenState.WF gen' →
      Block.userLabelsDisjoint statements gen' :=
    Block.userLabelsDisjoint_of_shapeNodup statements hlabels
  obtain ⟨finishLabel, gen, gen', entry, blocks, hgen, hentry, hblocks, hfinish,
      hwfGen, hgenStart⟩ := stmtsToCFG_stmtsToBlocks_spec statements hdisj
  let cfg := stmtsToCFG statements
  have hready : EnvRel (pendingInits ([] : List (Cmd P)) statements ++ [])
      initial initial := by
    refine ⟨rfl, StoreAgreement.refl _, ?_, hmono, hval⟩
    intro x hx
    exact hfresh x (by simpa [pendingInits, Cmds.definedVars] using hx)
  have hinitNodup : (pendingInits ([] : List (Cmd P)) statements ++ []).Nodup := by
    simpa [pendingInits, Cmds.definedVars, Block.uniqueInits] using hunique
  have hfragment := stmtsToBlocksTraceSim finishLabel statements [] [] gen gen'
    entry blocks hgen hsimple hunique hlbni hlhni hnml
    (by simpa [coveringLabels] using hcovered)
    [] hinitNodup initial initial hready cfg hblocks hcfgNodup
  have hfragment' : TraceSim (EnvRel ([] : List P.Ident))
      (fun env => .atBlock cfg finishLabel env)
      (fun _ env => .atBlock cfg finishLabel env)
      (.stmts statements initial) (.atBlock cfg entry initial) := by
    simpa [exitDest, sourceCode] using hfragment
  have hwhole := TraceSim.finish cfg finishLabel hfinish hfragment'
  simpa [cfg, hentry] using hwhole

end S2UTrace
