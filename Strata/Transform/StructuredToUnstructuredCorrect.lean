private theorem stmtsAppendPrefixCases {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (left right : List (Stmt P (Cmd P))) (initial : Env P)
    {final : Config P (Cmd P)} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (left ++ right) initial) trace final) :
    (∃ leftFinal,
      StepStmtStarE P (Imperative.EvalCmdE P) (.stmts left initial) trace leftFinal) ∨
    (∃ middle leftTrace rightTrace,
      trace = leftTrace ++ rightTrace ∧
      StepStmtStarE P (Imperative.EvalCmdE P)
        (.stmts left initial) leftTrace (.terminal middle) ∧
      StepStmtStarE P (Imperative.EvalCmdE P)
        (.stmts right middle) rightTrace final) := by
  induction left generalizing initial trace final with
  | nil =>
      exact .inr ⟨initial, [], trace, by simp,
        .step _ [] _ [] _ .step_stmts_nil (.refl _), by simpa using hrun⟩
  | cons statement rest ih =>
      have hrun' : StepStmtStarE P (Imperative.EvalCmdE P)
          (.stmts (statement :: (rest ++ right)) initial) trace final := by
        simpa using hrun
      rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun' with
        ⟨hfinal, htrace⟩ | hseq
      · subst final
        subst trace
        exact .inl ⟨_, .refl _⟩
      · rcases seq_run_decomposeE (Imperative.EvalCmdE P) hseq with
          ⟨innerFinal, hfinal, hhead⟩ |
          ⟨middle, headTrace, tailTrace, htrace, hhead, htail⟩ |
          ⟨label, exitEnv, hfinal, hhead⟩
        · subst final
          refine .inl ⟨.seq innerFinal rest, ?_⟩
          exact .step _ [] _ trace _ .step_stmts_cons
            (seq_inner_starE (Imperative.EvalCmdE P) hhead)
        · rcases ih middle htail with
            ⟨restFinal, hrest⟩ |
            ⟨afterLeft, restTrace, rightTrace, htailTrace, hrest, hright⟩
          · subst trace
            refine .inl ⟨restFinal, ?_⟩
            exact ReflTransTrace.trans _
              (stmts_cons_stepE (Imperative.EvalCmdE P)
                statement rest initial middle hhead) hrest
          · refine .inr ⟨afterLeft, headTrace ++ restTrace, rightTrace, ?_, ?_, hright⟩
            · rw [htrace, htailTrace]
              simp [List.append_assoc]
            · exact ReflTransTrace.trans _
                (stmts_cons_stepE (Imperative.EvalCmdE P)
                  statement rest initial middle hhead) hrest
        · subst final
          refine .inl ⟨.exiting label exitEnv, ?_⟩
          have hfirst : StepStmtStarE P (Imperative.EvalCmdE P)
              (.stmts (statement :: rest) initial) trace
              (.seq (.exiting label exitEnv) rest) :=
            .step _ [] _ trace _ .step_stmts_cons
              (seq_inner_starE (Imperative.EvalCmdE P) hhead)
          simpa using ReflTransTrace.trans _ hfirst
            (.step _ [] _ [] _ .step_seq_exit (.refl _))

private theorem stmtsAppendTerminalCases {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (left right : List (Stmt P (Cmd P))) (initial final : Env P)
    {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (left ++ right) initial) trace (.terminal final)) :
    ∃ middle leftTrace rightTrace,
      trace = leftTrace ++ rightTrace ∧
      StepStmtStarE P (Imperative.EvalCmdE P)
        (.stmts left initial) leftTrace (.terminal middle) ∧
      StepStmtStarE P (Imperative.EvalCmdE P)
        (.stmts right middle) rightTrace (.terminal final) := by
  induction left generalizing initial trace with
  | nil =>
      exact ⟨initial, [], trace, by simp,
        .step _ [] _ [] _ .step_stmts_nil (.refl _), by simpa using hrun⟩
  | cons statement rest ih =>
      have hrun' : StepStmtStarE P (Imperative.EvalCmdE P)
          (.stmts (statement :: (rest ++ right)) initial) trace (.terminal final) := by
        simpa using hrun
      rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun' with hstart | hseq
      · simp at hstart
      · obtain ⟨middle, headTrace, tailTrace, htrace, hhead, htail⟩ :=
          seq_reaches_terminalE (Imperative.EvalCmdE P) hseq
        obtain ⟨afterLeft, restTrace, rightTrace, htailTrace, hrest, hright⟩ :=
          ih middle htail
        refine ⟨afterLeft, headTrace ++ restTrace, rightTrace, ?_, ?_, hright⟩
        · rw [htrace, htailTrace]
          simp [List.append_assoc]
        · exact ReflTransTrace.trans _
            (stmts_cons_stepE (Imperative.EvalCmdE P)
              statement rest initial middle hhead) hrest

private theorem stmtsAppendExitingCases {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (left right : List (Stmt P (Cmd P))) (initial final : Env P)
    (label : String) {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts (left ++ right) initial) trace (.exiting label final)) :
    (StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmts left initial) trace (.exiting label final)) ∨
    (∃ middle leftTrace rightTrace,
      trace = leftTrace ++ rightTrace ∧
      StepStmtStarE P (Imperative.EvalCmdE P)
        (.stmts left initial) leftTrace (.terminal middle) ∧
      StepStmtStarE P (Imperative.EvalCmdE P)
        (.stmts right middle) rightTrace (.exiting label final)) := by
  induction left generalizing initial trace with
  | nil =>
      exact .inr ⟨initial, [], trace, by simp,
        .step _ [] _ [] _ .step_stmts_nil (.refl _), by simpa using hrun⟩
  | cons statement rest ih =>
      have hrun' : StepStmtStarE P (Imperative.EvalCmdE P)
          (.stmts (statement :: (rest ++ right)) initial) trace (.exiting label final) := by
        simpa using hrun
      rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun' with hstart | hseq
      · simp at hstart
      · rcases seq_reaches_exitingE (Imperative.EvalCmdE P) hseq with hhead | htail
        · have hfirst : StepStmtStarE P (Imperative.EvalCmdE P)
              (.stmts (statement :: rest) initial) trace
              (.seq (.exiting label final) rest) :=
            .step _ [] _ trace _ .step_stmts_cons
              (seq_inner_starE (Imperative.EvalCmdE P) hhead)
          exact .inl (by
            simpa using ReflTransTrace.trans _ hfirst
              (.step _ [] _ [] _ .step_seq_exit (.refl _)))
        · obtain ⟨middle, headTrace, tailTrace, htrace, hhead, htailRun⟩ := htail
          rcases ih middle htailRun with hrestExit |
            ⟨afterLeft, restTrace, rightTrace, htailTrace, hrest, hright⟩
          · subst trace
            exact .inl (ReflTransTrace.trans _
              (stmts_cons_stepE (Imperative.EvalCmdE P)
                statement rest initial middle hhead) hrestExit)
          · refine .inr ⟨afterLeft, headTrace ++ restTrace, rightTrace, ?_, ?_, hright⟩
            · rw [htrace, htailTrace]
              simp [List.append_assoc]
            · exact ReflTransTrace.trans _
                (stmts_cons_stepE (Imperative.EvalCmdE P)
                  statement rest initial middle hhead) hrest

private theorem TraceSim.append {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {MiddleRel FinalRel : Env P → Env P → Prop}
    {middleTarget terminalTarget : Env P → CFGConfig String (Cmd P) P}
    {exitingTarget : String → Env P → CFGConfig String (Cmd P) P}
    {left right : List (Stmt P (Cmd P))} {source : Env P}
    {target : CFGConfig String (Cmd P) P}
    (hleft : TraceSim MiddleRel middleTarget exitingTarget (.stmts left source) target)
    (hexitRel : ∀ sourceExit targetExit,
      MiddleRel sourceExit targetExit → FinalRel sourceExit targetExit)
    (hright : ∀ sourceMiddle targetMiddle,
      MiddleRel sourceMiddle targetMiddle →
      TraceSim FinalRel terminalTarget exitingTarget
        (.stmts right sourceMiddle) (middleTarget targetMiddle)) :
    TraceSim FinalRel terminalTarget exitingTarget
      (.stmts (left ++ right) source) target := by
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    rcases stmtsAppendPrefixCases left right source hrun with
      ⟨leftFinal, hrunLeft⟩ |
      ⟨sourceMiddle, leftTrace, rightTrace, htrace, hrunLeft, hrunRight⟩
    · exact hleft.simulate hrunLeft
    · obtain ⟨targetMiddle, targetLeftTrace, htargetLeft, hrel, htraceLeft⟩ :=
        hleft.terminal hrunLeft
      obtain ⟨targetFinal, targetRightTrace, htargetRight, htraceRight⟩ :=
        (hright sourceMiddle targetMiddle hrel).simulate hrunRight
      subst sourceTrace
      exact ⟨targetFinal, targetLeftTrace ++ targetRightTrace,
        ReflTransTrace.trans _ htargetLeft htargetRight,
        TraceExtendsEnv.append htraceLeft htraceRight⟩
  · intro sourceFinal sourceTrace hrun
    obtain ⟨sourceMiddle, leftTrace, rightTrace, htrace, hrunLeft, hrunRight⟩ :=
      stmtsAppendTerminalCases left right source sourceFinal hrun
    obtain ⟨targetMiddle, targetLeftTrace, htargetLeft, hrelMiddle, htraceLeft⟩ :=
      hleft.terminal hrunLeft
    obtain ⟨targetFinal, targetRightTrace, htargetRight, hrelFinal, htraceRight⟩ :=
      (hright sourceMiddle targetMiddle hrelMiddle).terminal hrunRight
    subst sourceTrace
    exact ⟨targetFinal, targetLeftTrace ++ targetRightTrace,
      ReflTransTrace.trans _ htargetLeft htargetRight, hrelFinal,
      TraceExtendsEnv.append htraceLeft htraceRight⟩
  · intro label sourceFinal sourceTrace hrun
    rcases stmtsAppendExitingCases left right source sourceFinal label hrun with
      hrunLeft |
      ⟨sourceMiddle, leftTrace, rightTrace, htrace, hrunLeft, hrunRight⟩
    · obtain ⟨targetEnv, targetTrace, htarget, hrel, htrace⟩ := hleft.exiting hrunLeft
      exact ⟨targetEnv, targetTrace, htarget, hexitRel _ _ hrel, htrace⟩
    · obtain ⟨targetMiddle, targetLeftTrace, htargetLeft, hrelMiddle, htraceLeft⟩ :=
        hleft.terminal hrunLeft
      obtain ⟨targetFinal, targetRightTrace, htargetRight, hrelFinal, htraceRight⟩ :=
        (hright sourceMiddle targetMiddle hrelMiddle).exiting hrunRight
      subst sourceTrace
      exact ⟨targetFinal, targetLeftTrace ++ targetRightTrace,
        ReflTransTrace.trans _ htargetLeft htargetRight, hrelFinal,
        TraceExtendsEnv.append htraceLeft htraceRight⟩

end S2UTrace
end StructuredToUnstructuredCorrect

