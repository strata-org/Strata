private theorem exitStmtNotTerminal {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {label : String} {metadata : MetaData P} {initial final : Env P} {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmt (.exit label metadata) initial) trace (.terminal final)) : False := by
  cases hrun with
  | step _ _ _ _ _ hfirst hrest =>
      cases hfirst with
      | step_exit =>
          obtain ⟨hfinal, _⟩ := stepStmtStarE_from_exiting hrest
          simp at hfinal

private theorem exitStmtExitingEq {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {label exitLabel : String} {metadata : MetaData P} {initial final : Env P}
    {trace : Trace P}
    (hrun : StepStmtStarE P (Imperative.EvalCmdE P)
      (.stmt (.exit label metadata) initial) trace (.exiting exitLabel final)) :
    exitLabel = label ∧ final = initial ∧ trace = [] := by
  cases hrun with
  | step _ _ _ restTrace _ hfirst hrest =>
      cases hfirst with
      | step_exit =>
          obtain ⟨hfinal, htrace⟩ := stepStmtStarE_from_exiting hrest
          injection hfinal with hlabel henv
          exact ⟨hlabel, henv, by subst htrace; simp⟩

private theorem exitListSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (destination label : String) (metadata : MetaData P)
    (rest : List (Stmt P (Cmd P)))
    (keep : List P.Ident) (source target : Env P)
    (hrel : EnvRel keep source target)
    (terminalTarget : Env P → CFGConfig String (Cmd P) P)
    (exitingTarget : String → Env P → CFGConfig String (Cmd P) P)
    (hdestination : ∀ env, exitingTarget label env = .atBlock cfg destination env) :
    TraceSim (EnvRel keep) terminalTarget exitingTarget
      (.stmts (.exit label metadata :: rest) source)
      (.atBlock cfg destination target) := by
  have hhead := exitStmtSim cfg destination label metadata keep source target hrel terminalTarget
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with
      ⟨hfinal, htrace⟩ | hseq
    · subst sourceFinal
      subst sourceTrace
      exact ⟨_, [], .refl _, .nil⟩
    · rcases seq_run_decomposeE (Imperative.EvalCmdE P) hseq with
        ⟨inner, hfinal, hinner⟩ |
        ⟨middle, headTrace, tailTrace, htrace, hinner, htail⟩ |
        ⟨exitLabel, exitEnv, hfinal, hinner⟩
      · exact hhead.simulate hinner
      · exact (exitStmtNotTerminal hinner).elim
      · obtain ⟨targetEnv, targetTrace, htarget, hrelOut, htraceOut⟩ :=
          hhead.exiting hinner
        exact ⟨_, targetTrace, htarget, htraceOut⟩
  · intro sourceEnv sourceTrace hrun
    rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with hstart | hseq
    · simp at hstart
    · obtain ⟨middle, headTrace, tailTrace, htrace, hinner, htail⟩ :=
        seq_reaches_terminalE (Imperative.EvalCmdE P) hseq
      exact (exitStmtNotTerminal hinner).elim
  · intro exitLabel sourceEnv sourceTrace hrun
    rcases stmts_cons_headE (Imperative.EvalCmdE P) hrun with hstart | hseq
    · simp at hstart
    · rcases seq_reaches_exitingE (Imperative.EvalCmdE P) hseq with hinner | htail
      · obtain ⟨hexitLabel, hsourceEnv, hsourceTrace⟩ := exitStmtExitingEq hinner
        subst exitLabel
        obtain ⟨targetEnv, targetTrace, htarget, hrelOut, htraceOut⟩ :=
          hhead.exiting hinner
        refine ⟨targetEnv, targetTrace, ?_, hrelOut, htraceOut⟩
        rw [hdestination]
        exact htarget
      · obtain ⟨middle, headTrace, tailTrace, htrace, hinner, hrest⟩ := htail
        exact (exitStmtNotTerminal hinner).elim

end S2UTrace
