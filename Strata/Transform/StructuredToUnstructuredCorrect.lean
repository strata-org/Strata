private theorem emptyStmtsSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P]
    {Rel : Env P → Env P → Prop}
    (cfg : CFG String (DetBlock String (Cmd P) P)) (label : String)
    (source target : Env P) (hrel : Rel source target)
    (exitingTarget : String → Env P → CFGConfig String (Cmd P) P) :
    TraceSim Rel (fun env => .atBlock cfg label env) exitingTarget
      (.stmts [] source) (.atBlock cfg label target) := by
  refine ⟨?_, ?_, ?_⟩
  · intro sourceFinal sourceTrace hrun
    obtain ⟨htrace, _⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hrun
    subst sourceTrace
    exact ⟨_, [], .refl _, .nil⟩
  · intro sourceEnv sourceTrace hrun
    obtain ⟨htrace, hshape⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hrun
    subst sourceTrace
    rcases hshape with hshape | hshape
    · simp at hshape
    · injection hshape with henv
      subst sourceEnv
      exact ⟨target, [], .refl _, hrel, .nil⟩
  · intro label' sourceEnv sourceTrace hrun
    obtain ⟨_, hshape⟩ := stmts_nil_runE (Imperative.EvalCmdE P) hrun
    rcases hshape with hshape | hshape <;> simp at hshape

private theorem flushGotoSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P]
    [DecidableEq P.Ident] [LawfulHasVal P]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (genPrefix continuation : String) (accum : List (Cmd P))
    (gen gen' : StringGenState) (entry : String)
    (blocks : DetBlocks String (Cmd P) P)
    (hflush : flushCmds genPrefix accum .none continuation gen = ((entry, blocks), gen'))
    (hblocks : ∀ block ∈ blocks, block ∈ cfg.blocks)
    (hcfgNodup : (cfg.blocks.map Prod.fst).Nodup)
    (keep : List P.Ident) (source target : Env P)
    (hrel : EnvRel (Cmds.definedVars accum.reverse ++ keep) source target)
    (hnodup : (Cmds.definedVars accum.reverse ++ keep).Nodup)
    (hmono : WellFormedSemanticEvalMono source.factory)
    (hval : WellFormedSemanticEvalVal source.factory)
    (exitTarget : String → Env P → CFGConfig String (Cmd P) P) :
    TraceSim (EnvRel keep)
      (fun env => .atBlock cfg continuation env) exitTarget
      (.stmts (accum.reverse.map (@Stmt.cmd P (Cmd P))) source)
      (.atBlock cfg entry target) := by
  unfold flushCmds at hflush
  simp only at hflush
  split at hflush
  case isTrue hempty =>
    have haccum : accum = [] := List.isEmpty_iff.mp hempty
    subst accum
    simp only [List.reverse_nil, Cmds.definedVars, List.nil_append, List.map_nil] at hrel hnodup ⊢
    simp only [pure, StateT.pure] at hflush
    injection hflush with hpair hgen
    injection hpair with hentry hblocksEq
    subst entry
    subst blocks
    exact emptyStmtsSim cfg continuation source target hrel exitTarget
  case isFalse hnonempty =>
    simp only [bind, StateT.bind, pure, StateT.pure, Id] at hflush
    injection hflush with hpair hgen
    injection hpair with hentry hblocksEq
    subst entry
    subst blocks
    let block : DetBlock String (Cmd P) P :=
      { cmds := accum.reverse, transfer := .goto continuation }
    have hmem : ((StringGenState.gen genPrefix gen).1, block) ∈ cfg.blocks :=
      hblocks _ List.mem_cons_self
    have hlookup : cfg.blocks.lookup (StringGenState.gen genPrefix gen).1 = some block :=
      List.lookup_of_mem_nodup cfg.blocks hcfgNodup _ _ hmem
    have hcommands := commandBlockSim cfg (StringGenState.gen genPrefix gen).1 accum.reverse
      (.goto continuation) hlookup keep source target hrel hnodup hmono exitTarget
    refine ⟨hcommands.simulate, ?_, hcommands.exiting⟩
    intro sourceEnv sourceTrace hrun
    obtain ⟨targetEnv, targetTrace, htarget, hrelOut, htrace⟩ := hcommands.terminal hrun
    have hfactory := StepCFGStarE.preserves_factory htarget
    have hvalTarget : WellFormedSemanticEvalVal targetEnv.factory := by
      simp only [CFGConfig.getEnv] at hfactory
      rw [← hfactory, hrel.factory]
      exact hval
    have hgoto : StepCFGE P (Imperative.EvalCmdE P)
        (.inBlock cfg (StringGenState.gen genPrefix gen).1 [] (.goto continuation) targetEnv) []
        (.atBlock cfg continuation targetEnv) :=
      StepCFGE.goto_true (hvalTarget.eval_tt targetEnv.store)
    exact ⟨targetEnv, targetTrace, by
      change ReflTransTrace (StepCFGE P (Imperative.EvalCmdE P)) _ targetTrace _
      simpa using ReflTransTrace.trans _ htarget
        (.step _ [] _ [] _ hgoto (.refl _)), hrelOut, htrace⟩

private theorem flushCondSim {P : PureExpr}
    [HasFvar P] [HasFvars P] [HasBoolOps P] [HasIdent P]
    [DecidableEq P.Ident]
    (cfg : CFG String (DetBlock String (Cmd P) P))
    (genPrefix fallback : String) (accum : List (Cmd P))
    (condition : P.Expr) (thenLabel elseLabel : String)
    (gen gen' : StringGenState) (entry : String)
    (blocks : DetBlocks String (Cmd P) P)
    (hflush : flushCmds genPrefix accum
      (.some (.condGoto condition thenLabel elseLabel .empty)) fallback gen =
        ((entry, blocks), gen'))
    (hblocks : ∀ block ∈ blocks, block ∈ cfg.blocks)
    (hcfgNodup : (cfg.blocks.map Prod.fst).Nodup)
    (keep : List P.Ident) (source target : Env P)
    (hrel : EnvRel (Cmds.definedVars accum.reverse ++ keep) source target)
    (hnodup : (Cmds.definedVars accum.reverse ++ keep).Nodup)
    (hmono : WellFormedSemanticEvalMono source.factory)
    (exitTarget : String → Env P → CFGConfig String (Cmd P) P) :
    TraceSim (EnvRel keep)
      (fun env => .inBlock cfg entry []
        (.condGoto condition thenLabel elseLabel .empty) env)
      exitTarget
      (.stmts (accum.reverse.map (@Stmt.cmd P (Cmd P))) source)
      (.atBlock cfg entry target) := by
  unfold flushCmds at hflush
  simp only [bind, StateT.bind, pure, StateT.pure, Id] at hflush
  injection hflush with hpair hgen
  injection hpair with hentry hblocksEq
  subst entry
  subst blocks
  let block : DetBlock String (Cmd P) P :=
    { cmds := accum.reverse, transfer := .condGoto condition thenLabel elseLabel .empty }
  have hmem : ((StringGenState.gen genPrefix gen).1, block) ∈ cfg.blocks :=
    hblocks _ List.mem_cons_self
  have hlookup : cfg.blocks.lookup (StringGenState.gen genPrefix gen).1 = some block :=
    List.lookup_of_mem_nodup cfg.blocks hcfgNodup _ _ hmem
  exact commandBlockSim cfg (StringGenState.gen genPrefix gen).1 accum.reverse
    (.condGoto condition thenLabel elseLabel .empty) hlookup keep
    source target hrel hnodup hmono exitTarget

end S2UTrace
end StructuredToUnstructuredCorrect

