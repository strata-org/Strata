@[simp] private theorem true_getFvars {P : PureExpr} [HasBool P] [HasFvars P]
    [LawfulHasBool P] :
    HasFvars.getFvars (P := P) HasBool.tt = [] :=
  LawfulHasBool.tt_getFvars

@[simp] theorem command_definedVars_eq {P : PureExpr} [HasFvars P]
    (c : Cmd P) (flag : Bool) :
    HasVarsImp.definedVars (P := P) c flag = Cmd.definedVars c := rfl

@[simp] theorem command_modifiedVars_eq {P : PureExpr} [HasFvars P]
    (c : Cmd P) : HasVarsImp.modifiedVars (P := P) c = Cmd.modifiedVars c := rfl

@[simp] theorem command_readVars_eq {P : PureExpr} [HasFvars P]
    (c : Cmd P) : HasVarsImp.readVars (P := P) c = Cmd.getVars c := rfl
private def Cmds.initTypes {P : PureExpr} (cmds : List (Cmd P)) : List P.Ty :=
  cmds.flatMap (HasInitTypesImp.initTypes (P := P))

private def Blocks.definedVars {P : PureExpr} [HasFvars P]
    (blocks : DetBlocks String (Cmd P) P) : List P.Ident :=
  blocks.flatMap fun (_, block) => Cmds.definedVars block.cmds

private def Blocks.modifiedVars {P : PureExpr} [HasFvars P]
    (blocks : DetBlocks String (Cmd P) P) : List P.Ident :=
  blocks.flatMap fun (_, block) => Cmds.modifiedVars block.cmds

private def Transfer.readVars {P : PureExpr} [HasFvars P] :
    DetTransferCmd String P → List P.Ident
  | .condGoto guard _ _ _ => HasFvars.getFvars guard
  | .finish _ => []

private def Blocks.readVars {P : PureExpr} [HasFvars P]
    (blocks : DetBlocks String (Cmd P) P) : List P.Ident :=
  blocks.flatMap fun (_, block) =>
    Cmds.getVars block.cmds ++ Transfer.readVars block.transfer

private def Blocks.initTypes {P : PureExpr}
    (blocks : DetBlocks String (Cmd P) P) : List P.Ty :=
  blocks.flatMap fun (_, block) => Cmds.initTypes block.cmds

@[simp] private theorem Blocks.definedVars_append {P : PureExpr} [HasFvars P]
    (xs ys : DetBlocks String (Cmd P) P) :
    Blocks.definedVars (xs ++ ys) = Blocks.definedVars xs ++ Blocks.definedVars ys := by
  simp [Blocks.definedVars]

@[simp] private theorem Blocks.modifiedVars_append {P : PureExpr} [HasFvars P]
    (xs ys : DetBlocks String (Cmd P) P) :
    Blocks.modifiedVars (xs ++ ys) = Blocks.modifiedVars xs ++ Blocks.modifiedVars ys := by
  simp [Blocks.modifiedVars]

@[simp] private theorem Blocks.readVars_append {P : PureExpr} [HasFvars P]
    (xs ys : DetBlocks String (Cmd P) P) :
    Blocks.readVars (xs ++ ys) = Blocks.readVars xs ++ Blocks.readVars ys := by
  simp [Blocks.readVars]

@[simp] private theorem Blocks.initTypes_append {P : PureExpr}
    (xs ys : DetBlocks String (Cmd P) P) :
    Blocks.initTypes (xs ++ ys) = Blocks.initTypes xs ++ Blocks.initTypes ys := by
  simp [Blocks.initTypes]

private def OptionalTransfer.readVars {P : PureExpr} [HasFvars P] :
    Option (DetTransferCmd String P) → List P.Ident
  | none => []
  | some transfer => Transfer.readVars transfer

@[simp] private theorem mem_cmds_definedVars {P : PureExpr}
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ Cmds.definedVars cmds ↔ ∃ c ∈ cmds, n ∈ Cmd.definedVars c := by
  induction cmds with
  | nil => simp [Cmds.definedVars]
  | cons c rest ih => simp [Cmds.definedVars, ih]

@[simp] private theorem mem_cmds_modifiedVars {P : PureExpr}
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ Cmds.modifiedVars cmds ↔ ∃ c ∈ cmds, n ∈ Cmd.modifiedVars c := by
  induction cmds with
  | nil => simp [Cmds.modifiedVars]
  | cons c rest ih => simp [Cmds.modifiedVars, ih]

@[simp] private theorem mem_cmds_getVars {P : PureExpr} [HasFvars P]
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ Cmds.getVars cmds ↔ ∃ c ∈ cmds, n ∈ Cmd.getVars c := by
  induction cmds with
  | nil => simp [Cmds.getVars]
  | cons c rest ih => simp [Cmds.getVars, ih]

@[simp] private theorem mem_flatMap_definedVars {P : PureExpr} [HasFvars P]
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ cmds.flatMap (HasVarsImp.definedVars (P := P) · false) ↔
      n ∈ Cmds.definedVars cmds := by
  rw [mem_cmds_definedVars]
  simp only [List.mem_flatMap]
  constructor <;> rintro ⟨c, hc, hn⟩ <;> exact ⟨c, hc, hn⟩

@[simp] private theorem mem_flatMap_modifiedVars {P : PureExpr} [HasFvars P]
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ cmds.flatMap (HasVarsImp.modifiedVars (P := P)) ↔
      n ∈ Cmds.modifiedVars cmds := by
  rw [mem_cmds_modifiedVars]
  simp only [List.mem_flatMap]
  constructor <;> rintro ⟨c, hc, hn⟩ <;> exact ⟨c, hc, hn⟩

@[simp] private theorem mem_flatMap_readVars {P : PureExpr} [HasFvars P]
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ cmds.flatMap (HasVarsImp.readVars (P := P)) ↔
      n ∈ Cmds.getVars cmds := by
  rw [mem_cmds_getVars]
  simp only [List.mem_flatMap]
  constructor <;> rintro ⟨c, hc, hn⟩ <;> exact ⟨c, hc, hn⟩

private structure AnalysesMemEq {P : PureExpr} [HasFvars P]
    (ss : List (Stmt P (Cmd P))) (accum : List (Cmd P))
    (blocks : DetBlocks String (Cmd P) P) : Prop where
  definedVars : ∀ n, n ∈ Blocks.definedVars blocks ↔
    n ∈ Cmds.definedVars accum ∨ n ∈ Block.initVars (Block.cfgLive ss)
  modifiedVars : ∀ n, n ∈ Blocks.modifiedVars blocks ↔
    n ∈ Cmds.modifiedVars accum ∨ n ∈ Block.modifiedVars (Block.cfgLive ss)
  readVars : ∀ n, n ∈ Blocks.readVars blocks ↔
    n ∈ Cmds.getVars accum ∨ n ∈ Block.getVars (Block.cfgLive ss)
  initTypes : ∀ ty, ty ∈ Blocks.initTypes blocks ↔
    ty ∈ Cmds.initTypes accum ∨ ty ∈ Block.initTypes (Block.cfgLive ss)

@[simp] private theorem mem_definedVars_reverse {P : PureExpr}
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ Cmds.definedVars cmds.reverse ↔ n ∈ Cmds.definedVars cmds := by
  simp

@[simp] private theorem mem_modifiedVars_reverse {P : PureExpr}
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ Cmds.modifiedVars cmds.reverse ↔ n ∈ Cmds.modifiedVars cmds := by
  simp

@[simp] private theorem mem_getVars_reverse {P : PureExpr} [HasFvars P]
    (n : P.Ident) (cmds : List (Cmd P)) :
    n ∈ Cmds.getVars cmds.reverse ↔ n ∈ Cmds.getVars cmds := by
  simp

@[simp] private theorem mem_initTypes_reverse {P : PureExpr}
    (ty : P.Ty) (cmds : List (Cmd P)) :
    ty ∈ Cmds.initTypes cmds.reverse ↔ ty ∈ Cmds.initTypes cmds := by
  simp [Cmds.initTypes]

private theorem flushCmds_analyses {P : PureExpr}
    [HasBool P] [HasFvar P] [HasFvars P] [LawfulHasVal P] [LawfulHasBool P] [HasOps P]
        [LawfulHasFvar P]
    (pfx : String) (accum : List (Cmd P))
    (transfer? : Option (DetTransferCmd String P)) (k : String)
    (gen gen' : StringGenState) (entry : String)
    (blocks : DetBlocks String (Cmd P) P)
    (h : flushCmds pfx accum transfer? k gen = ((entry, blocks), gen')) :
    (∀ n, n ∈ Blocks.definedVars blocks ↔ n ∈ Cmds.definedVars accum) ∧
    (∀ n, n ∈ Blocks.modifiedVars blocks ↔ n ∈ Cmds.modifiedVars accum) ∧
    (∀ n, n ∈ Blocks.readVars blocks ↔
      n ∈ Cmds.getVars accum ∨ n ∈ OptionalTransfer.readVars transfer?) ∧
    (∀ ty, ty ∈ Blocks.initTypes blocks ↔ ty ∈ Cmds.initTypes accum) := by
  unfold flushCmds at h
  cases transfer? with
  | none =>
      by_cases hempty : accum.isEmpty
      · rw [ite_eq_left hempty] at h
        simp only [pure, StateT.pure] at h
        injection h with hp _
        injection hp with _ hb
        subst hb
        have ha : accum = [] := List.isEmpty_iff.mp hempty
        subst ha
        simp [Blocks.definedVars, Blocks.modifiedVars, Blocks.readVars,
          Blocks.initTypes, OptionalTransfer.readVars, Cmds.definedVars,
          Cmds.modifiedVars, Cmds.getVars, Cmds.initTypes]
      · rw [ite_eq_right hempty] at h
        simp only [bind, StateT.bind, pure, StateT.pure, Id] at h
        injection h with hp _
        injection hp with _ hb
        subst hb
        simp [Blocks.definedVars, Blocks.modifiedVars, Blocks.readVars,
          Blocks.initTypes, OptionalTransfer.readVars, Transfer.readVars,
          Cmds.initTypes]
  | some transfer =>
      simp only [bind, StateT.bind, pure, StateT.pure, Id] at h
      injection h with hp _
      injection hp with _ hb
      subst hb
      simp [Blocks.definedVars, Blocks.modifiedVars, Blocks.readVars,
        Blocks.initTypes, OptionalTransfer.readVars,
        Cmds.initTypes]

private theorem stmtsToBlocks_analyses {P : PureExpr}
    [HasBool P] [HasFvar P] [HasFvars P] [LawfulHasVal P] [LawfulHasBool P] [HasOps P]
        [LawfulHasFvar P] [HasIdent P] [HasInt P]
    [HasIntOps P] [HasBoolOps P]
    (k : String) (ss : List (Stmt P (Cmd P)))
    (exitConts : List (Option String × String)) (accum : List (Cmd P))
    (gen gen' : StringGenState) (entry : String)
    (blocks : DetBlocks String (Cmd P) P)
    (hng : Block.noNondetGuards ss = true)
    (hni : Block.loopHasNoInvariants ss = true)
    (hnm : Block.noMeasureLoops ss = true)
    (h : stmtsToBlocks k ss exitConts accum gen = ((entry, blocks), gen')) :
    AnalysesMemEq ss accum blocks := by
  match ss with
  | [] =>
      have hflush : flushCmds listTailPrefix accum none k gen = ((entry, blocks), gen') := by
        simpa [stmtsToBlocks] using h
      have hf := flushCmds_analyses listTailPrefix accum none k gen gen' entry blocks hflush
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro n; simpa [Block.cfgLive, Stmt.cfgLive, Block.initVars] using hf.1 n
      · intro n; simpa [Block.cfgLive] using hf.2.1 n
      · intro n; simpa [Block.cfgLive, Block.getVars, Stmt.getVars, OptionalTransfer.readVars] using hf.2.2.1 n
      · intro ty; simpa [Block.cfgLive, Block.initTypes, Stmt.initTypes] using hf.2.2.2 ty
  | (.cmd c) :: rest =>
      simp only [stmtsToBlocks] at h
      simp only [Block.noNondetGuards, Stmt.noNondetGuards, Bool.true_and] at hng
      simp only [Block.loopHasNoInvariants, Stmt.loopHasNoInvariants, Bool.true_and] at hni
      simp only [Block.noMeasureLoops, Stmt.noMeasureLoops, Bool.true_and] at hnm
      have ih := stmtsToBlocks_analyses k rest exitConts (c :: accum)
        gen gen' entry blocks hng hni hnm h
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro n
        rw [ih.definedVars n]
        simp [Block.cfgLive, Stmt.cfgLive, Block.initVars,
          Stmt.definedVars, Cmds.definedVars, command_definedVars_eq, List.mem_append]
        grind
      · intro n
        rw [ih.modifiedVars n]
        simp [Block.cfgLive, Stmt.cfgLive, Block.modifiedVars, Stmt.modifiedVars,
          Cmds.modifiedVars, command_modifiedVars_eq, List.mem_append]
        grind
      · intro n
        rw [ih.readVars n]
        simp [Block.cfgLive, Stmt.cfgLive, Block.getVars, Stmt.getVars,
          Cmds.getVars, command_readVars_eq, List.mem_append]
        grind
      · intro ty
        rw [ih.initTypes ty]
        simp [Block.cfgLive, Stmt.cfgLive, Block.initTypes, Stmt.initTypes,
          Cmds.initTypes, List.mem_append]
        grind
  | (.exit l md) :: rest =>
      simp only [stmtsToBlocks] at h
      split at h
      · rename_i target hlookup
        have hf := flushCmds_analyses (blockExitPrefix l) accum none target gen gen' entry blocks h
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro n; simpa [Block.cfgLive, Stmt.cfgLive, Block.initVars] using hf.1 n
        · intro n; simpa [Block.cfgLive] using hf.2.1 n
        · intro n; simpa [Block.cfgLive, Block.getVars, Stmt.getVars, OptionalTransfer.readVars] using hf.2.2.1 n
        · intro ty; simpa [Block.cfgLive, Block.initTypes, Stmt.initTypes] using hf.2.2.2 ty
      · have hf := flushCmds_analyses (blockExitPrefix l) accum none k gen gen' entry blocks h
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro n; simpa [Block.cfgLive, Stmt.cfgLive, Block.initVars] using hf.1 n
        · intro n; simpa [Block.cfgLive] using hf.2.1 n
        · intro n; simpa [Block.cfgLive, Block.getVars, Stmt.getVars, OptionalTransfer.readVars] using hf.2.2.1 n
        · intro ty; simpa [Block.cfgLive, Block.initTypes, Stmt.initTypes] using hf.2.2.2 ty
  | (.typeDecl tc md) :: rest =>
      simp only [stmtsToBlocks] at h
      simp only [Block.noNondetGuards, Stmt.noNondetGuards, Bool.true_and] at hng
      simp only [Block.loopHasNoInvariants, Stmt.loopHasNoInvariants, Bool.true_and] at hni
      simp only [Block.noMeasureLoops, Stmt.noMeasureLoops, Bool.true_and] at hnm
      have ih := stmtsToBlocks_analyses k rest exitConts accum
        gen gen' entry blocks hng hni hnm h
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro n; simpa [Block.cfgLive, Stmt.cfgLive, Block.initVars,
          Block.definedVars, Stmt.definedVars] using ih.definedVars n
      · intro n; simpa [Block.cfgLive, Stmt.cfgLive, Block.modifiedVars,
          Stmt.modifiedVars] using ih.modifiedVars n
      · intro n; simpa [Block.cfgLive, Stmt.cfgLive, Block.getVars,
          Stmt.getVars] using ih.readVars n
      · intro ty; simpa [Block.cfgLive, Stmt.cfgLive, Block.initTypes,
          Stmt.initTypes] using ih.initTypes ty
  | (.block l body _) :: rest =>
      simp only [stmtsToBlocks, bind, StateT.bind, pure, Id] at h
      generalize hr : stmtsToBlocks k rest exitConts [] gen = rr at h
      obtain ⟨⟨kNext, restBlocks⟩, genRest⟩ := rr
      simp only at h
      generalize hb : stmtsToBlocks kNext body ((some l, kNext) :: exitConts) [] genRest = rb at h
      obtain ⟨⟨bodyEntry, bodyBlocks⟩, genBody⟩ := rb
      simp only at h
      generalize hf : @flushCmds P (Cmd P) _ blockFlushPrefix accum none bodyEntry genBody = rf at h
      obtain ⟨⟨accumEntry, accumBlocks⟩, genFlush⟩ := rf
      simp only at h
      split at h
      · rename_i heq
        injection h with hp hg
        injection hp with hentry hblocks
        subst hentry; subst hblocks; subst hg
        simp only [Block.noNondetGuards, Stmt.noNondetGuards, Bool.and_eq_true] at hng
        simp only [Block.loopHasNoInvariants, Stmt.loopHasNoInvariants,
          Bool.and_eq_true] at hni
        simp only [Block.noMeasureLoops, Stmt.noMeasureLoops, Bool.and_eq_true] at hnm
        have ir := stmtsToBlocks_analyses k rest exitConts [] gen genRest
          kNext restBlocks hng.2 hni.2 hnm.2 hr
        have ib := stmtsToBlocks_analyses kNext body ((some l, kNext) :: exitConts) []
          genRest genBody bodyEntry bodyBlocks hng.1 hni.1 hnm.1 hb
        have ia := flushCmds_analyses blockFlushPrefix accum none bodyEntry genBody
          genFlush accumEntry accumBlocks hf
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro x
          have ha := ia.1 x
          have hb := ib.definedVars x
          have hr := ir.definedVars x
          simp_all [Blocks.definedVars, Block.cfgLive, Stmt.cfgLive,
            Block.initVars, Stmt.definedVars, List.mem_append]
        · intro x
          have ha := ia.2.1 x
          have hb := ib.modifiedVars x
          have hr := ir.modifiedVars x
          simp_all [Blocks.modifiedVars, Block.cfgLive, Stmt.cfgLive,
            Block.modifiedVars, Stmt.modifiedVars, List.mem_append]
        · intro x
          have ha := ia.2.2.1 x
          have hb := ib.readVars x
          have hr := ir.readVars x
          simp_all [Blocks.readVars, OptionalTransfer.readVars, Transfer.readVars,
            Block.cfgLive, Stmt.cfgLive, Block.getVars, Stmt.getVars, List.mem_append]
        · intro x
          have ha := ia.2.2.2 x
          have hb := ib.initTypes x
          have hr := ir.initTypes x
          simp_all [Blocks.initTypes, Cmds.initTypes, Block.cfgLive, Stmt.cfgLive,
            Block.initTypes, Stmt.initTypes, List.mem_append]
      · rename_i heq
        injection h with hp hg
        injection hp with hentry hblocks
        subst hentry; subst hblocks; subst hg
        simp only [Block.noNondetGuards, Stmt.noNondetGuards, Bool.and_eq_true] at hng
        simp only [Block.loopHasNoInvariants, Stmt.loopHasNoInvariants,
          Bool.and_eq_true] at hni
        simp only [Block.noMeasureLoops, Stmt.noMeasureLoops, Bool.and_eq_true] at hnm
        have ir := stmtsToBlocks_analyses k rest exitConts [] gen genRest
          kNext restBlocks hng.2 hni.2 hnm.2 hr
        have ib := stmtsToBlocks_analyses kNext body ((some l, kNext) :: exitConts) []
          genRest genBody bodyEntry bodyBlocks hng.1 hni.1 hnm.1 hb
        have ia := flushCmds_analyses blockFlushPrefix accum none bodyEntry genBody
          genFlush accumEntry accumBlocks hf
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro x
          have ha := ia.1 x
          have hb := ib.definedVars x
          have hr := ir.definedVars x
          simp_all [Blocks.definedVars, Block.cfgLive, Stmt.cfgLive,
            Block.initVars, Stmt.definedVars, List.mem_append]
        · intro x
          have ha := ia.2.1 x
          have hb := ib.modifiedVars x
          have hr := ir.modifiedVars x
          simp_all [Blocks.modifiedVars, Block.cfgLive, Stmt.cfgLive,
            Block.modifiedVars, Stmt.modifiedVars, List.mem_append]
        · intro x
          have ha := ia.2.2.1 x
          have hb := ib.readVars x
          have hr := ir.readVars x
          simp_all [Blocks.readVars, OptionalTransfer.readVars, Transfer.readVars,
            Block.cfgLive, Stmt.cfgLive, Block.getVars, Stmt.getVars, List.mem_append]
        · intro x
          have ha := ia.2.2.2 x
          have hb := ib.initTypes x
          have hr := ir.initTypes x
          simp_all [Blocks.initTypes, Cmds.initTypes, Block.cfgLive, Stmt.cfgLive,
            Block.initTypes, Stmt.initTypes, List.mem_append]
  | (.ite guard thenBranch elseBranch _) :: rest =>
      cases guard with
      | nondet => simp [Block.noNondetGuards, Stmt.noNondetGuards] at hng
      | det condition =>
        simp only [stmtsToBlocks, bind, StateT.bind, pure, StateT.pure, Id] at h
        generalize hr : stmtsToBlocks k rest exitConts [] gen = rr at h
        obtain ⟨⟨kNext, restBlocks⟩, genRest⟩ := rr
        simp only at h
        generalize hl : StringGenState.gen iteLabelPrefix genRest = rl at h
        obtain ⟨iteLabel, genLabel⟩ := rl
        simp only at h
        generalize ht : stmtsToBlocks kNext thenBranch exitConts [] genLabel = rt at h
        obtain ⟨⟨thenEntry, thenBlocks⟩, genThen⟩ := rt
        simp only at h
        generalize he : stmtsToBlocks kNext elseBranch exitConts [] genThen = re at h
        obtain ⟨⟨elseEntry, elseBlocks⟩, genElse⟩ := re
        simp only at h
        generalize hf : @flushCmds P (Cmd P) _ iteFlushPrefix (accum ++ [])
          (some (.condGoto condition thenEntry elseEntry .empty)) iteLabel genLabel = rf at h
        obtain ⟨⟨accumEntry, accumBlocks⟩, genFlush⟩ := rf
        injection h with hp hg
        injection hp with hentry hblocks
        subst hentry; subst hblocks; subst hg
        simp only [Block.noNondetGuards, Stmt.noNondetGuards,
          Bool.and_eq_true] at hng
        simp only [Block.loopHasNoInvariants, Stmt.loopHasNoInvariants,
          Bool.and_eq_true] at hni
        simp only [Block.noMeasureLoops, Stmt.noMeasureLoops,
          Bool.and_eq_true] at hnm
        have ir := stmtsToBlocks_analyses k rest exitConts [] gen genRest
          kNext restBlocks hng.2 hni.2 hnm.2 hr
        have it := stmtsToBlocks_analyses kNext thenBranch exitConts [] genLabel genThen
          thenEntry thenBlocks hng.1.1 hni.1.1 hnm.1.1 ht
        have ie := stmtsToBlocks_analyses kNext elseBranch exitConts [] genThen genElse
          elseEntry elseBlocks hng.1.2 hni.1.2 hnm.1.2 he
        have ia := flushCmds_analyses iteFlushPrefix (accum ++ [])
          (some (.condGoto condition thenEntry elseEntry .empty)) iteLabel genLabel genFlush
          accumEntry accumBlocks hf
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro x
          have ha := ia.1 x
          have ht := it.definedVars x
          have he := ie.definedVars x
          have hr := ir.definedVars x
          simp_all [Blocks.definedVars, Block.cfgLive, Stmt.cfgLive,
            Block.initVars, Stmt.definedVars, List.mem_append]
        · intro x
          have ha := ia.2.1 x
          have ht := it.modifiedVars x
          have he := ie.modifiedVars x
          have hr := ir.modifiedVars x
          simp_all [Blocks.modifiedVars, Block.cfgLive, Stmt.cfgLive,
            Block.modifiedVars, Stmt.modifiedVars, List.mem_append]
        · intro x
          have ha := ia.2.2.1 x
          have ht := it.readVars x
          have he := ie.readVars x
          have hr := ir.readVars x
          -- After the analysis rewrites, only the deterministic guard's
          -- `ExprOrNondet.getVars` wrapper remains.
          simp_all [Blocks.readVars, OptionalTransfer.readVars, Transfer.readVars,
            Block.cfgLive, Stmt.cfgLive, Block.getVars, Stmt.getVars,
            ExprOrNondet.getVars, List.mem_append]
        · intro x
          have ha := ia.2.2.2 x
          have ht := it.initTypes x
          have he := ie.initTypes x
          have hr := ir.initTypes x
          simp_all [Blocks.initTypes, Cmds.initTypes, Block.cfgLive, Stmt.cfgLive,
            Block.initTypes, Stmt.initTypes, List.mem_append]
  | (.loop guard measure invariants body _) :: rest =>
      cases guard with
      | nondet => simp [Block.noNondetGuards, Stmt.noNondetGuards] at hng
      | det condition =>
        cases measure with
        | some measureExpr => simp [Block.noMeasureLoops, Stmt.noMeasureLoops] at hnm
        | none =>
          have hniParts : (invariants = [] ∧
              Block.loopHasNoInvariants body = true) ∧
              Block.loopHasNoInvariants rest = true := by
            simpa [Block.loopHasNoInvariants, Stmt.loopHasNoInvariants] using hni
          have hinv : invariants = [] := hniParts.1.1
          subst hinv
          simp only [stmtsToBlocks, bind, StateT.bind, pure, StateT.pure, Id] at h
          generalize hr : stmtsToBlocks k rest exitConts [] gen = rr at h
          obtain ⟨⟨kNext, restBlocks⟩, genRest⟩ := rr
          simp only at h
          generalize hl : StringGenState.gen loopEntryPrefix genRest = rl at h
          obtain ⟨loopEntry, genLoop⟩ := rl
          simp only at h
          generalize hb : stmtsToBlocks loopEntry body ((none, kNext) :: exitConts) [] genLoop = rb at h
          obtain ⟨⟨bodyEntry, bodyBlocks⟩, genBody⟩ := rb
          simp only [List.mapM, List.mapM.loop, pure, StateT.pure] at h
          generalize hf : @flushCmds P (Cmd P) _ beforeLoopPrefix accum none loopEntry genBody = rf at h
          obtain ⟨⟨accumEntry, accumBlocks⟩, genFlush⟩ := rf
          simp only at h
          injection h with hp hg
          injection hp with hentry hblocks
          subst hentry; subst hblocks; subst hg
          simp only [Block.noNondetGuards, Stmt.noNondetGuards,
            Bool.and_eq_true, Bool.true_and] at hng
          simp only [Block.loopHasNoInvariants, Stmt.loopHasNoInvariants,
            Bool.and_eq_true] at hni
          simp only [Block.noMeasureLoops, Stmt.noMeasureLoops,
            Bool.and_eq_true] at hnm
          have ir := stmtsToBlocks_analyses k rest exitConts [] gen genRest
            kNext restBlocks hng.2 hni.2 hnm.2 hr
          have ib := stmtsToBlocks_analyses loopEntry body ((none, kNext) :: exitConts) []
            genLoop genBody bodyEntry bodyBlocks hng.1 hni.1.2 hnm.1.2 hb
          have ia := flushCmds_analyses beforeLoopPrefix accum none loopEntry genBody genFlush
            accumEntry accumBlocks hf
          refine ⟨?_, ?_, ?_, ?_⟩
          · intro x
            have ha := ia.1 x
            have hb := ib.definedVars x
            have hr := ir.definedVars x
            simp only [Blocks.definedVars_append, List.mem_append]
            rw [ha, hb, hr]
            simp [Blocks.definedVars, Block.cfgLive, Stmt.cfgLive, Block.initVars, Stmt.definedVars]
            simp only [or_assoc]
          · intro x
            have ha := ia.2.1 x
            have hb := ib.modifiedVars x
            have hr := ir.modifiedVars x
            simp only [Blocks.modifiedVars_append, List.mem_append]
            rw [ha, hb, hr]
            simp [Blocks.modifiedVars, Block.cfgLive, Stmt.cfgLive, Block.modifiedVars, Stmt.modifiedVars]
            simp only [or_assoc]
          · intro x
            have ha := ia.2.2.1 x
            have hb := ib.readVars x
            have hr := ir.readVars x
            simp only [Blocks.readVars_append, List.mem_append]
            rw [ha, hb, hr]
            -- The CFG transfer reads the same variables as the deterministic
            -- source guard, by the definition of `ExprOrNondet.getVars`.
            simp [Blocks.readVars, OptionalTransfer.readVars, Transfer.readVars, Block.cfgLive,
              Stmt.cfgLive, Block.getVars, Stmt.getVars, ExprOrNondet.getVars]
            simp only [or_assoc]
          · intro x
            have ha := ia.2.2.2 x
            have hb := ib.initTypes x
            have hr := ir.initTypes x
            simp only [Blocks.initTypes_append, List.mem_append]
            rw [ha, hb, hr]
            simp [Blocks.initTypes, Cmds.initTypes, Block.cfgLive, Stmt.cfgLive,
              Block.initTypes, Stmt.initTypes]
            simp only [or_assoc]
  termination_by sizeOf ss
  decreasing_by all_goals (simp_wf; try omega)

private theorem stmtsToCFG_analyses {P : PureExpr}
    [HasBool P] [HasFvar P] [HasFvars P] [LawfulHasVal P] [LawfulHasBool P] [HasOps P]
        [LawfulHasFvar P] [HasIdent P] [HasInt P]
    [HasIntOps P] [HasBoolOps P]
    (ss : List (Stmt P (Cmd P)))
    (hng : Block.noNondetGuards ss = true)
    (hni : Block.loopHasNoInvariants ss = true)
    (hnm : Block.noMeasureLoops ss = true) :
    (∀ n, n ∈ HasVarsImp.definedVars (P := P) (stmtsToCFG ss) false ↔
      n ∈ Block.initVars (Block.cfgLive ss)) ∧
    (∀ n, n ∈ HasVarsImp.modifiedVars (P := P) (stmtsToCFG ss) ↔
      n ∈ Block.modifiedVars (Block.cfgLive ss)) ∧
    (∀ n, n ∈ HasVarsImp.readVars (P := P) (stmtsToCFG ss) ↔
      n ∈ Block.getVars (Block.cfgLive ss)) ∧
    (∀ ty, ty ∈ DetCFG.initTypes (stmtsToCFG ss) ↔
      ty ∈ Block.initTypes (Block.cfgLive ss)) := by
  let pEnd := StringGenState.gen endPrefix StringGenState.emp
  let endLabel := pEnd.1
  let genEnd := pEnd.2
  let result := stmtsToBlocks endLabel ss [] [] genEnd
  let endBlock : DetBlock String (Cmd P) P :=
    { cmds := [], transfer := .finish .empty }
  let terminal : String × DetBlock String (Cmd P) P := (endLabel, endBlock)
  have hcfg : stmtsToCFG ss =
      { entry := result.1.1, blocks := result.1.2 ++ [terminal] } := by
    simp [stmtsToCFG, stmtsToCFGM, pEnd, endLabel, genEnd, result,
      endBlock, terminal]
    rfl
  have ha := stmtsToBlocks_analyses endLabel ss [] [] genEnd result.2
    result.1.1 result.1.2 hng hni hnm rfl
  rw [hcfg]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro n
    change n ∈ (result.1.2 ++ [terminal]).flatMap (fun (_, block) =>
      block.cmds.flatMap (HasVarsImp.definedVars (P := P) · false)) ↔ _
    simpa [Blocks.definedVars, terminal, endBlock] using ha.definedVars n
  · intro n
    change n ∈ (result.1.2 ++ [terminal]).flatMap (fun (_, block) =>
      block.cmds.flatMap (HasVarsImp.modifiedVars (P := P))) ↔ _
    simpa [Blocks.modifiedVars, terminal, endBlock] using ha.modifiedVars n
  · intro n
    change n ∈ (result.1.2 ++ [terminal]).flatMap (fun (_, block) =>
      block.cmds.flatMap (HasVarsImp.readVars (P := P)) ++
        match block.transfer with
        | .condGoto guard _ _ _ => HasFvars.getFvars guard
        | .finish _ => []) ↔ _
    simpa [Blocks.readVars, Transfer.readVars, terminal, endBlock] using ha.readVars n
  · intro ty
    change ty ∈ (result.1.2 ++ [terminal]).flatMap (fun (_, block) =>
      block.cmds.flatMap (HasInitTypesImp.initTypes (P := P))) ↔ _
    simpa [DetCFG.initTypes, Blocks.initTypes, Cmds.initTypes, terminal, endBlock] using ha.initTypes ty

 theorem stmtsToCFG_definedVars_iff {P : PureExpr}
    [HasBool P] [HasFvar P] [HasFvars P] [LawfulHasVal P] [LawfulHasBool P] [HasOps P]
        [LawfulHasFvar P] [HasIdent P] [HasInt P]
    [HasIntOps P] [HasBoolOps P]
    (ss : List (Stmt P (Cmd P)))
    (hng : Block.noNondetGuards ss = true)
    (hni : Block.loopHasNoInvariants ss = true)
    (hnm : Block.noMeasureLoops ss = true) (n : P.Ident) :
    n ∈ HasVarsImp.definedVars (P := P) (stmtsToCFG ss) false ↔
      n ∈ Block.initVars (Block.cfgLive ss) :=
  (stmtsToCFG_analyses ss hng hni hnm).1 n

 theorem stmtsToCFG_modifiedVars_iff {P : PureExpr}
    [HasBool P] [HasFvar P] [HasFvars P] [LawfulHasVal P] [LawfulHasBool P] [HasOps P]
        [LawfulHasFvar P] [HasIdent P] [HasInt P]
    [HasIntOps P] [HasBoolOps P]
    (ss : List (Stmt P (Cmd P)))
    (hng : Block.noNondetGuards ss = true)
    (hni : Block.loopHasNoInvariants ss = true)
    (hnm : Block.noMeasureLoops ss = true) (n : P.Ident) :
    n ∈ HasVarsImp.modifiedVars (P := P) (stmtsToCFG ss) ↔
      n ∈ Block.modifiedVars (Block.cfgLive ss) :=
  (stmtsToCFG_analyses ss hng hni hnm).2.1 n

 theorem stmtsToCFG_readVars_iff {P : PureExpr}
    [HasBool P] [HasFvar P] [HasFvars P] [LawfulHasVal P] [LawfulHasBool P] [HasOps P]
        [LawfulHasFvar P] [HasIdent P] [HasInt P]
    [HasIntOps P] [HasBoolOps P]
    (ss : List (Stmt P (Cmd P)))
    (hng : Block.noNondetGuards ss = true)
    (hni : Block.loopHasNoInvariants ss = true)
    (hnm : Block.noMeasureLoops ss = true) (n : P.Ident) :
    n ∈ HasVarsImp.readVars (P := P) (stmtsToCFG ss) ↔
      n ∈ Block.getVars (Block.cfgLive ss) :=
  (stmtsToCFG_analyses ss hng hni hnm).2.2.1 n

 theorem stmtsToCFG_initTypes_iff {P : PureExpr}
    [HasBool P] [HasFvar P] [HasFvars P] [LawfulHasVal P] [LawfulHasBool P] [HasOps P]
        [LawfulHasFvar P] [HasIdent P] [HasInt P]
    [HasIntOps P] [HasBoolOps P]
    (ss : List (Stmt P (Cmd P)))
    (hng : Block.noNondetGuards ss = true)
    (hni : Block.loopHasNoInvariants ss = true)
    (hnm : Block.noMeasureLoops ss = true) (ty : P.Ty) :
    ty ∈ DetCFG.initTypes (stmtsToCFG ss) ↔
      ty ∈ Block.initTypes (Block.cfgLive ss) :=
  (stmtsToCFG_analyses ss hng hni hnm).2.2.2 ty

end Imperative.StructuredToUnstructuredWF

