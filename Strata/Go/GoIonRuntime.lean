module

public import Strata.Init

/-!
# Fixed Go support files for `getIonGoSerializer%`

`Strata.Go.Gen` emits one Go file per Lean type in a closure. The generated
types implement `ion.Marshaler` and write their schema-specific representation
directly through `github.com/amazon-ion/ion-go/ion.Writer`.

This module embeds the small adapter layer shared by those files:

* the Go mirror of `StrataDDM.Decimal`;
* constructors for arbitrary-precision integers and optional values;
* validation and error-path helpers used by generated marshal methods; and
* `MarshalBinary`, a convenience wrapper around ion-go's binary writer.

Ion's binary encoding, symbol table management, and writer state machine belong
to ion-go rather than to generated Strata code.

The canonical sources are ordinary, gofmt-able files under `Strata/Go/runtime`.
`include_str` embeds them into the compiled Lean module, so the generator remains
self-contained when it runs outside the source tree. Each template uses the
package name `___placeholder___`; `runtimeFiles` replaces that package clause
with the caller's package name.
-/

namespace Strata.Go

/--
`ion_value.go`: aliases to ion-go's writer/marshaler interfaces, Strata's
decimal mirror, integer constructors, and checked writer helpers.
-/
private def ionValueGo : String := include_str "runtime/ion_value.go"

/--
`ion_binary.go`: a convenience wrapper that marshals one generated value with
ion-go's binary writer.
-/
private def ionBinaryGo : String := include_str "runtime/ion_binary.go"

/--
`opt.go`: `Opt`, which takes the address of a value so that a generated
`Option`-typed field (a Go pointer) can be populated inline.
-/
private def optGo : String := include_str "runtime/opt.go"

/-! ## Generated files -/

/-- Marker carried by every generated Go file, type files and support files
alike. `go/ast.IsGenerated` and code review tooling key off it, and
`laurelGoGen`'s prune uses it to tell its own output from handwritten files — so
a support file without it would be treated as handwritten and left behind when a
later version renames or drops it, leaving duplicate declarations in the output
directory. -/
public def generatedGoFileMarker : String :=
  "// Code generated by getIonGoSerializer%. DO NOT EDIT."

/-! ## Go package names -/

/-- Go keywords, which cannot be used as package names or identifiers. -/
public def goKeywords : List String := [
  "break", "case", "chan", "const", "continue", "default", "defer", "else",
  "fallthrough", "for", "func", "go", "goto", "if", "import", "interface",
  "map", "package", "range", "return", "select", "struct", "switch", "type",
  "var"
]

/-- Whether `pkg` is a valid Go package name. -/
public def isValidGoPackageName (pkg : String) : Bool :=
  match pkg.toList with
  | [] => false
  | c :: cs =>
    (c.isAlpha || c == '_') && cs.all (fun c => c.isAlphanum || c == '_') &&
      pkg != "_" && pkg != "init" && !goKeywords.contains pkg

/-! ## Package-scope names -/

/-- The leading Go identifier of `s`, or `""` if `s` does not start with one. -/
private def goIdentPrefix (s : String) : String :=
  (s.takeWhile (fun c => c.isAlphanum || c == '_')).toString

/--
Every package-scope name declared by one of the emitted Go support files.

This scanner recognises the declaration forms used by the embedded sources and
skips methods, whose names live in receiver method sets rather than package
scope. Deriving the reserved set from the emitted source prevents the generator
and its adapter layer from drifting apart.
-/
private def goTopLevelNames (source : String) : Array String :=
  ((source.splitOn "\n").foldl (init := (#[], false)) fun (acc, inGroup) line =>
    if inGroup then
      if line.startsWith ")" then (acc, false)
      else
        let name := goIdentPrefix (line.dropWhile (· == '\t')).toString
        if line.startsWith "\t" && !name.isEmpty then (acc.push name, true) else (acc, true)
    else if line == "const (" || line == "var (" then (acc, true)
    else if line.startsWith "func (" then (acc, false)
    else
      match ["type ", "func ", "const ", "var "].find? (fun kw => line.startsWith kw) with
      | none => (acc, false)
      | some keyword =>
        let name := goIdentPrefix (line.drop keyword.length).toString
        if name.isEmpty then (acc, false) else (acc.push name, false)).1

/-- Every package-scope name declared by the emitted support files. -/
public def packageScopeNames : Array String :=
  #[ionValueGo, ionBinaryGo, optGo].flatMap goTopLevelNames

/-- The fixed Go support files as `(filename, content)` pairs.

The marker is prepended rather than written into `runtime/*.go`, so that those
sources stay ordinary Go that `gofmt` and an editor treat as editable — they are
maintained by hand; it is only their *emitted* copies that must not be. -/
public def runtimeFiles (pkg : String) : Array (String × String) :=
  let withPackage (body : String) : String :=
    generatedGoFileMarker ++ "\n\n" ++
      body.replace "package ___placeholder___" ("package " ++ pkg)
  #[ ("ion_value.go", withPackage ionValueGo),
     ("ion_binary.go", withPackage ionBinaryGo),
     ("opt.go", withPackage optGo) ]

end Strata.Go
